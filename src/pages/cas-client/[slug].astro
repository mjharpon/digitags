---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import CtaBanner from '../../components/CtaBanner.astro';

export async function getStaticPaths() {
  const fiches = await getCollection('casClients', ({ data }) => !data.draft);
  return fiches.map((fiche) => ({ params: { slug: fiche.id }, props: { fiche } }));
}

const { fiche } = Astro.props;
const { Content } = await render(fiche);
---
<Base title={`${fiche.data.metaTitle ?? fiche.data.title} | digitags.work`} description={fiche.data.description}>
  <article>
    <section class="page-hero" style="padding-bottom: 36px;">
      <div class="container">
        <Breadcrumb items={[{ label: 'Cas clients', href: '/cas-clients' }, { label: fiche.data.title }]} />
        <p class="eyebrow"><a href="/cas-clients">Cas clients</a></p>
        <h1>{fiche.data.metaTitle ?? fiche.data.title}</h1>
      </div>
    </section>
    <div class="container prose">
      {fiche.data.image && <img src={fiche.data.image} alt="" loading="eager" />}
      <Content />
    </div>
  </article>

  <CtaBanner title="Un projet similaire&nbsp;?" text="Décrivez votre besoin,<br />nous composons l'équipe qui va avec." />
</Base>
