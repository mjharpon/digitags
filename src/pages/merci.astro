---
import Base from '../layouts/Base.astro';
---
<Base title="Merci ! | digitags.work" description="Votre brief a bien été envoyé au Hub.">
  <section class="page-hero" style="padding-bottom: 120px;">
    <div class="container">
      <p class="eyebrow">Brief envoyé</p>
      <h1>Merci, c'est bien reçu.</h1>
      <p class="lead">Votre brief est entre de bonnes mains : nous revenons vers vous très rapidement pour en parler et solliciter les bons profils du réseau.</p>
      <div class="hero-cta">
        <a href="/" class="btn btn-dark">Retour à l'accueil</a>
        <a href="https://www.digitags.work/blog" class="btn btn-outline">Lire le blog du Hub</a>
      </div>
    </div>
  </section>
</Base>
