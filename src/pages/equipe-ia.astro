---
import Base from '../layouts/Base.astro';
import CtaBanner from '../components/CtaBanner.astro';

const stats = [
  { color: "hex-icon-blue", big: "2/3", title: "des entreprises utilisent déjà l'IA générative", desc: "Mais l'usage reste majoritairement expérimental, avec des gains de productivité encore limités.", src: "Banque de France, enquête 2026" },
  { color: "hex-icon-yellow", big: "+60%", title: "de demande sur les compétences « agents IA » en un an", desc: "Les profils capables d'orchestrer des agents IA sont les plus recherchés du marché français.", src: "Malt Tech Trends 2026" },
  { color: "hex-icon-red", big: "N°2", title: "l'IA, deuxième compétence freelance la plus demandée", desc: "22 % des demandes de missions — même non techniques — exigent désormais une expertise IA.", src: "Malt Tech Trends 2026" },
];

const usecases = [
  { icon: "icon-data", title: "Gestion documentaire", desc: "Extraire, vérifier et organiser automatiquement vos factures, contrats et autres documents.", metric: "jusqu'à −70 %", metricLabel: "de temps de traitement", tone: "blue" },
  { icon: "icon-crm", title: "Service client", desc: "Traiter les demandes courantes, préparer les réponses et transmettre les cas complexes.", metric: "jusqu'à −60 %", metricLabel: "de tickets manuels", tone: "yellow" },
  { icon: "icon-seo", title: "Opérations commerciales", desc: "Qualifier les demandes entrantes, enrichir le CRM et automatiser les relances.", metric: "jusqu'à +40 %", metricLabel: "de leads qualifiés", tone: "green" },
  { icon: "icon-tech", title: "Back-office", desc: "Fluidifier les validations, les reportings et la coordination administrative.", metric: "jusqu'à −50 %", metricLabel: "de temps administratif", tone: "red" },
];

const roles = [
  { tag: "Pilotage", title: "Product Owner IA", points: ["Cadre le cas d'usage et le résultat attendu", "Pilote le backlog et les métriques IA (qualité, coût, valeur métier)", "Un profil « product builder », pas un gestionnaire de tickets"] },
  { tag: "Build", title: "Ingénieur IA", points: ["Conçoit l'architecture : LLM, RAG, agents, intégrations", "Développe, évalue et industrialise les modèles", "Garantit robustesse, sécurité et coûts maîtrisés"] },
  { tag: "Data", title: "Data Engineer", points: ["Prépare et fiabilise les données", "Met en place les pipelines et le monitoring", "Un système IA vaut ce que valent ses données"] },
  { tag: "Adoption", title: "Designer & change", points: ["Conçoit des interfaces IA utiles", "Forme vos équipes, organise la montée en compétence", "Ancre l'outil dans les usages réels du métier"] },
];

const steps = [
  { title: "On identifie l'opportunité", desc: "Cadrage de 2 semaines : nous analysons vos processus, vos objectifs et les gains potentiels, avec des critères de succès chiffrés — coût par opération, taux d'erreur, délais." },
  { title: "On déploie une première solution", desc: "Pilote de 2 à 4 mois en conditions réelles, sur vos données. Chaque indicateur est mesuré et partagé : vous voyez ce que l'automatisation produit, semaine après semaine." },
  { title: "On passe à l'échelle", desc: "Les résultats convergent : nous industrialisons, supervisons et améliorons la solution avec vos équipes, avec transfert de compétence. Sinon, le périmètre est ajusté — vous n'investissez jamais sur une promesse." },
];

const why = [
  { color: "hex-icon-blue", title: "Expertise métier", desc: "Des profils seniors du réseau, avec une expérience terrain." },
  { color: "hex-icon-yellow", title: "Technologies de pointe", desc: "Agents IA, automatisations, intégrations sur mesure — sans dépendance à un écosystème fermé." },
  { color: "hex-icon-red", title: "Accompagnement opérationnel", desc: "De la mise en place au suivi des résultats, avec transfert de compétence." },
  { color: "hex-icon-blue", title: "Garde-fous dès le cadrage", desc: "Supervision humaine, journal d'audit, conformité RGPD & AI Act. Vos données restent chez vous." },
];

const faq = [
  { q: "Quels processus métier se prêtent à l'automatisation par l'IA ?", a: "Les processus fréquents, répétitifs et documentés : traitement de documents, back-office, support de premier niveau, coordination de prestataires, qualification de données. Un bon candidat a du volume, des règles exprimables et des exceptions identifiables. Le cadrage sert précisément à vérifier ce potentiel avant d'investir." },
  { q: "L'IA travaille-t-elle seule ?", a: "Non. Chaque dispositif combine agents IA et supervision humaine : l'IA exécute dans un périmètre de décision restreint, nos experts contrôlent les cas ambigus, et chaque action est tracée dans un journal d'audit. C'est ce qui rend l'automatisation fiable — et conforme." },
  { q: "Que devient mon équipe interne ?", a: "Elle monte en compétence. L'objectif n'est pas de remplacer vos collaborateurs mais de leur retirer le répétitif : nous les formons, documentons le dispositif et organisons le transfert pour que la valeur reste chez vous." },
  { q: "Pourquoi passer par un pilote plutôt qu'un déploiement direct ?", a: "Parce qu'un dispositif IA se juge sur des mesures, pas sur une démonstration. Le pilote en conditions réelles établit le coût par opération, le taux d'erreur et les délais sur vos données — et la décision d'industrialiser se prend sur ces chiffres." },
  { q: "Comment la conformité RGPD et AI Act est-elle assurée ?", a: "Dès le cadrage : cartographie des données, périmètre de décision de l'IA documenté, supervision humaine, journal d'audit et hébergement maîtrisé. Vos données restent chez vous et nous privilégions des outils agnostiques, sans dépendance à un écosystème fermé." },
];

const faqJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
});
---
<Base
  title="Automatisation IA des processus métier & équipe produit IA | digitags.work"
  description="Automatisation IA de vos processus métier par agents IA supervisés, et équipes produit IA seniors. Pilote mesuré, conforme RGPD et AI Act."
>
  <section class="ia-hero">
    <div class="container ia-hero-grid">
      <div>
        <p class="eyebrow">Offre IA — Opérations &amp; Produit</p>
        <h1>Faites travailler l'IA.<br /><span>Pas seulement vos équipes.</span></h1>
        <p class="lead">Nous transformons l'intelligence artificielle en solutions opérationnelles : automatisation de vos processus métier avec supervision humaine, et produits IA construits par des équipes seniors. Moins de tâches manuelles, des résultats mesurés.</p>
        <div class="hero-cta">
          <a href="/contact" class="btn btn-dark">Parlons de votre projet</a>
          <a href="#offres" class="btn btn-outline">Découvrir nos solutions</a>
        </div>
        <ul class="ia-minibadges">
          <li><span class="hex-icon hex-icon-blue"></span> Des résultats mesurés</li>
          <li><span class="hex-icon hex-icon-yellow"></span> Des experts dédiés</li>
          <li><span class="hex-icon hex-icon-red"></span> De la conception à l'exploitation</li>
        </ul>
      </div>
      <div class="ia-illu" aria-hidden="true">
        <div class="ia-process-card">
          <div class="ia-pc-head">
            <strong>Processus automatisé</strong>
            <span class="ia-live">● Actif</span>
          </div>
          <ul>
            <li><span class="ia-step-ico">📄</span> Réception du document</li>
            <li><span class="ia-step-ico">🔎</span> Extraction des informations</li>
            <li><span class="ia-step-ico">✓</span> Contrôle et validation</li>
            <li><span class="ia-step-ico">💾</span> Enregistrement dans vos outils</li>
          </ul>
        </div>
        <div class="ia-metric-chip">−80 %<span>de temps manuel</span></div>
        <div class="ia-chart-card">
          <strong>Temps de traitement</strong>
          <div class="ia-bars">
            <div class="ia-bar b1" title="Avant"></div>
            <div class="ia-bar b2"></div>
            <div class="ia-bar b3 on"></div>
            <div class="ia-bar b4 on"></div>
          </div>
          <div class="ia-legend"><span><i class="l-off"></i> Avant</span><span><i class="l-on"></i> Avec digitags</span></div>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="offres" style="padding-top: 40px;">
    <div class="container">
      <p class="eyebrow" style="text-align:center;">Deux façons de passer à l'action</p>
      <h2 class="section-title">Deux façons de mettre l'IA au travail.</h2>
      <div class="ia-offers">
        <article class="ia-offer ia-offer-blue">
          <p class="ia-offer-tag">Offre 1 — Opérations</p>
          <h3>Confiez vos tâches répétitives à l'IA.</h3>
          <p class="ia-offer-desc">Nous concevons, déployons et supervisons des agents IA capables de prendre en charge vos processus métier de bout en bout.</p>
          <ul class="ia-checks">
            <li>Moins de tâches manuelles, des opérations plus rapides</li>
            <li>Des experts qui supervisent les exceptions</li>
            <li>Un périmètre précis — un processus à la fois</li>
            <li>Un suivi clair des coûts, de la qualité et des résultats</li>
          </ul>
          <a href="/contact" class="btn btn-dark">Identifier un processus à automatiser <span aria-hidden="true">→</span></a>
        </article>
        <article class="ia-offer ia-offer-red">
          <p class="ia-offer-tag">Offre 2 — Produit</p>
          <h3>De votre idée à un produit qui fonctionne.</h3>
          <p class="ia-offer-desc">Nous constituons l'équipe d'experts nécessaire pour concevoir, développer et mettre votre produit IA en production.</p>
          <ul class="ia-checks">
            <li>Une équipe senior adaptée à votre projet</li>
            <li>Un produit conçu autour de vos utilisateurs</li>
            <li>Une intégration à vos outils et vos données</li>
            <li>Un accompagnement jusqu'au lancement et au-delà</li>
          </ul>
          <a href="/contact" class="btn btn-dark">Parler de mon produit IA <span aria-hidden="true">→</span></a>
        </article>
      </div>
    </div>
  </section>

  <section class="section" style="padding-top: 10px;">
    <div class="container">
      <p class="eyebrow" style="text-align:center;">Exemples de cas d'usage</p>
      <h2 class="section-title">Des gains concrets, processus par processus.</h2>
      <div class="ia-usecases">
        {usecases.map((u) => (
          <article class="ia-usecase">
            <span class={`uc-ico uc-${u.tone}`}></span>
            <h3>{u.title}</h3>
            <p>{u.desc}</p>
            <div class={`uc-metric uc-m-${u.tone}`}><strong>{u.metric}</strong><span>{u.metricLabel}</span></div>
          </article>
        ))}
      </div>
      <p class="ia-note">Ordres de grandeur constatés sur des dispositifs comparables — vos objectifs chiffrés sont fixés ensemble au cadrage, puis mesurés pendant le pilote.</p>
    </div>
  </section>

  <section class="section" style="padding-top: 10px;">
    <div class="container">
      <p class="eyebrow" style="text-align:center;">Un processus simple et efficace</p>
      <h2 class="section-title">Un pilote mesuré avant toute industrialisation.</h2>
      <div class="ia-steps">
        {steps.map((s, i) => (
          <article class="ia-step">
            <span class={`ia-step-num n${i + 1}`}>{i + 1}</span>
            <h3>{s.title}</h3>
            <p>{s.desc}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="approche" id="equipe-ia-roles">
    <div class="container" style="padding-bottom: 60px;">
      <div class="approche-copy" style="max-width: 640px; margin-bottom: 44px;">
        <h2>Des experts du réseau,<br />pas une boîte noire.</h2>
        <p style="color: #b9c0d8; font-size: 15px;">Derrière chaque dispositif, une équipe courte et senior issue du Hub : les agents IA exécutent, les humains cadrent, supervisent et répondent de la qualité.</p>
      </div>
      <div class="reussites-grid cols-4">
        {roles.map((r) => (
          <article class="reussite-card">
            <p class="case-label label-blue">{r.tag}</p>
            <h3>{r.title}</h3>
            <ul>
              {r.points.map((p) => <li>{p}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="section-title">Le marché a basculé.</h2>
      <div class="benefits-grid">
        {stats.map((s) => (
          <article class="benefit-card">
            <span class={`hex-icon ${s.color}`}></span>
            <span class="stat-big">{s.big}</span>
            <h3>{s.title}</h3>
            <p>{s.desc}</p>
            <span class="stat-src">{s.src}</span>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="ia-why">
    <div class="container ia-why-grid">
      <div>
        <p class="eyebrow" style="color:#8fa0e8;">Pourquoi digitags&nbsp;?</p>
        <h2>Les bons experts. La bonne technologie. Un vrai responsable du résultat.</h2>
        <p>Nous réunissons expertise métier, talents technologiques et accompagnement opérationnel pour transformer vos idées en solutions réellement utilisées. Pas simplement du conseil. Du concret.</p>
        <a href="/contact" class="btn btn-light">Discutons de votre projet <span aria-hidden="true">→</span></a>
      </div>
      <div class="ia-why-items">
        {why.map((w) => (
          <div class="ia-why-item">
            <span class={`hex-icon ${w.color}`}></span>
            <div>
              <strong>{w.title}</strong>
              <p>{w.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="eyebrow" style="text-align:center;">Questions fréquentes</p>
      <h2 class="section-title">Tout savoir sur l'IA en production.</h2>
      <div class="faq">
        {faq.map((f) => (
          <details class="faq-item">
            <summary>{f.q}</summary>
            <div class="faq-body">{f.a}</div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <CtaBanner
    title="Un processus à automatiser,<br />un produit IA à construire&nbsp;?"
    text="Décrivez-nous votre besoin : nous cadrons<br />le périmètre et les critères de succès ensemble."
    label="Cadrer mon projet IA"
  />

  <script type="application/ld+json" set:html={faqJsonLd} />
</Base>
