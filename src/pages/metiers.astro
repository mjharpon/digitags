---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import CtaBanner from '../components/CtaBanner.astro';

// Métiers groupés par catégorie : les fiches existantes en cartes,
// les autres métiers du réseau (listés sur les pages expertises) en chips.
const CATEGORIES = [
  {
    name: "Design & UX",
    color: "hex-icon-blue",
    slugs: ["ux-designer-freelance", "ui-designer-freelance", "ux-writer-freelance"],
    extra: ["Product Designer", "Web designer", "Directeur artistique", "Illustrateur", "Motion designer", "Artiste 3D", "Creative Lead"],
  },
  {
    name: "Product & Projet",
    color: "hex-icon-yellow",
    slugs: ["product-manager-freelance", "product-owner-freelance", "chef-de-projet-freelance", "coach-agile"],
    extra: ["Chef de projet IT", "Chef de projet Digital", "Chef de projet AMOA", "Manager de transition", "Responsable CRM"],
  },
  {
    name: "Marketing & Acquisition",
    color: "hex-icon-red",
    slugs: ["freelance-seo", "expert-sea-freelance", "expert-social-ads-freelance", "traffic-manager-freelance", "community-manager-freelance", "account-manager-freelance"],
    extra: ["Responsable Acquisition", "Growth Marketer", "Social Media Manager", "Brand Manager"],
  },
  {
    name: "Développement",
    color: "hex-icon-blue",
    slugs: ["developpeur-front-end-freelance", "developpeur-back-end-freelance", "full-stack-developpeur-freelance", "developeur-web-freelance"],
    extra: ["Développeur Mobile", "Tech Lead", "DevOps"],
  },
  {
    name: "Data & Analytics",
    color: "hex-icon-yellow",
    slugs: [],
    extra: ["Data Scientist", "Data Engineer", "Data Analyst", "Web Analyst", "Business Analyst", "Chef de projet Data"],
  },
];

const all = await getCollection('metiers', ({ data }) => !data.draft);
const bySlug = new Map(all.map((m) => [m.id, m]));
const categorized = new Set(CATEGORIES.flatMap((c) => c.slugs));
// Toute fiche non catégorisée est ajoutée à la fin de la première catégorie pertinente par défaut.
const orphans = all.filter((m) => !categorized.has(m.id));
const categories = CATEGORIES.map((c) => ({
  ...c,
  fiches: c.slugs.map((s) => bySlug.get(s)).filter(Boolean),
}));
if (orphans.length) categories[categories.length - 1].fiches.push(...orphans);

const features = [
  { color: "hex-icon-blue", text: "Des profils experts, vérifiés et recommandés par leurs pairs" },
  { color: "hex-icon-yellow", text: "Une mise en place rapide, jusqu'à 48h pour démarrer" },
  { color: "hex-icon-red", text: "Un accompagnement de bout en bout" },
  { color: "hex-icon-blue", text: "Des résultats concrets et mesurables" },
];

const faq = [
  { q: "Comment choisir le bon métier freelance pour mon projet ?", a: "Pas besoin de trancher seul : décrivez votre besoin via le formulaire et nous le cadrons ensemble. Selon vos enjeux, nous vous orientons vers le bon métier — ou la bonne combinaison de métiers — et vous proposons les profils du réseau réellement intéressés par votre projet." },
  { q: "Sous quel délai un freelance peut-il démarrer ?", a: "Après le cadrage de votre brief, nous sollicitons les meilleurs profils du réseau et organisons les entretiens rapidement. Selon la disponibilité des talents, une mission peut démarrer en 48h." },
  { q: "Combien coûte un freelance ?", a: "Chaque expert fixe son TJM selon son métier, sa séniorité et la nature de la mission. Vous contractualisez une prestation précise sur une période donnée : le budget est connu et maîtrisé dès le départ. Pour y voir plus clair, consultez notre article sur <a href=\"/blog/tjm-freelance\">le TJM freelance</a>." },
  { q: "Comment les freelances du Hub sont-ils sélectionnés ?", a: "Le Hub n'est ni une plateforme ouverte ni une ESN : c'est un réseau fermé de plus de 1 600 experts, sélectionnés pour leurs compétences, leur expérience et leur état d'esprit, et recommandés par leurs pairs. Nous connaissons les points forts de chacun depuis 8 ans." },
  { q: "Freelance seul ou équipe complète ?", a: "Les deux. Pour un besoin ponctuel, un expert seul suffit souvent. Pour un projet plus large, nous composons une équipe complémentaire — par exemple notre <a href=\"/equipe-ia\">Équipe Produit IA</a> — ou vous connectons à l'un de nos <a href=\"/studios-et-collectifs\">10 studios et collectifs indépendants</a>." },
];

const faqJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a.replace(/<[^>]+>/g, '') },
  })),
});
---
<Base
  title="Les métiers freelances du Hub | digitags.work"
  description="UX designer, développeur, product manager, consultant SEO… découvrez les métiers freelances les plus recherchés du réseau digitags.work et trouvez le profil qu'il vous faut."
>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Les métiers du Hub</p>
      <h1>Staffez vos équipes, métier par métier.</h1>
      <p class="lead">De la technologie au marketing, le réseau couvre tous les métiers du digital. Explorez les profils les plus recherchés — chaque fiche détaille le métier, les compétences et quand y faire appel.</p>
      <div class="hero-cta">
        <a href="/contact" class="btn btn-dark">Trouver un freelance</a>
      </div>
    </div>
  </section>

  <section class="hero-banner">
    <div class="container">
      <img src="/uploads/blog/reussir-collaboration-long-terme-avec-un-freelance-cover.webp" alt="Une équipe projet réunie autour d'ordinateurs portables" loading="eager" />
    </div>
  </section>

  <section>
    <div class="container split-section">
      <div class="split-text">
        <h2>Des profils adaptés<br />à vos besoins</h2>
        <p>Nous sommes là pour comprendre vos besoins et sélectionner les profils parfaits pour votre projet. Leur expertise couvre un large éventail de domaines, de la technologie au marketing.</p>
        <p>Chaque mission est montée sur mesure, avec les bons profils freelances — seuls ou en équipe — et un accompagnement de A à Z.</p>
      </div>
      <div class="feature-panel">
        {features.map((f) => (
          <div class="feature-item">
            <span class={`hex-icon ${f.color}`}></span>
            <p>{f.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="liste">
    <div class="container">
      <p class="eyebrow" style="text-align:center;">Nos métiers freelances</p>
      <h2 class="section-title">Les métiers du réseau, par expertise.</h2>
      {categories.map((cat) => (
        <div class="metier-cat">
          <h3 class="cat-heading"><span class={`hex-icon ${cat.color}`}></span> {cat.name}</h3>
          {cat.fiches.length > 0 && (
            <div class="numbered-grid">
              {cat.fiches.map((m, i) => (
                <article class="numbered-card">
                  <div>
                    <span class="num-badge">{String(i + 1).padStart(2, '0')}</span>
                    <h3><a href={`/metiers/${m.id}`} class="stretch-link">{m.data.title}</a></h3>
                    {m.data.description && <p class="num-desc">{m.data.description}</p>}
                    <span class="arrow-link">En savoir plus <span aria-hidden="true">→</span></span>
                  </div>
                  {m.data.image && <img src={m.data.image} alt="" loading="lazy" />}
                </article>
              ))}
            </div>
          )}
          {cat.extra.length > 0 && (
            <div class="cat-extra">
              <p>Également dans le réseau&nbsp;:</p>
              <ul class="chips chips-left">
                {cat.extra.map((e) => <li><span class="chip">{e}</span></li>)}
              </ul>
            </div>
          )}
        </div>
      ))}
    </div>
  </section>

  <section>
    <div class="container atoz">
      <img src="/uploads/blog/notre-processus-de-matching-freelance-entreprise-cover.webp" alt="Une loupe qui distingue le bon profil parmi plusieurs" loading="lazy" />
      <div>
        <p class="eyebrow">Des missions sur mesure</p>
        <h2 class="atoz-title">Un accompagnement de A à Z</h2>
        <p class="atoz-lead">Nous vous aidons à définir le bon profil, à rencontrer les meilleurs talents du réseau et à piloter la mission jusqu'à l'atteinte de vos objectifs.</p>
        <ul class="check-list">
          <li>Cadrage de votre besoin et de votre brief</li>
          <li>Sélection des profils réellement intéressés, avec leurs conditions</li>
          <li>Entretien avec les talents retenus — le fit avant tout</li>
          <li>Suivi et ajustements jusqu'aux résultats</li>
        </ul>
        <a href="/contact" class="btn btn-dark">Parler de mon projet</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="eyebrow" style="text-align:center;">Questions fréquentes</p>
      <h2 class="section-title">Tout savoir sur la collaboration freelance.</h2>
      <div class="faq">
        {faq.map((f) => (
          <details class="faq-item">
            <summary>{f.q}</summary>
            <div class="faq-body" set:html={f.a} />
          </details>
        ))}
      </div>
    </div>
  </section>

  <CtaBanner title="Un métier manque à l'appel&nbsp;?" text="Le réseau couvre plus de 33 métiers du digital.<br />Décrivez votre besoin, nous trouvons le profil." />

  <script type="application/ld+json" set:html={faqJsonLd} />
</Base>
