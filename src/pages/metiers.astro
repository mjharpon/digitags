---
import Base from '../layouts/Base.astro';
import HowItWorks from '../components/HowItWorks.astro';
import CtaBanner from '../components/CtaBanner.astro';

const LIVE = "https://www.digitags.work/metiers";
const metiers = [
  { slug: "ux-designer-freelance", label: "UX Designer" },
  { slug: "ui-designer-freelance", label: "UI Designer" },
  { slug: "product-manager-freelance", label: "Product Manager" },
  { slug: "product-owner-freelance", label: "Product Owner" },
  { slug: "chef-de-projet-freelance", label: "Chef de projet" },
  { slug: "coach-agile", label: "Coach Agile" },
  { slug: "freelance-seo", label: "Consultant SEO" },
  { slug: "traffic-manager-freelance", label: "Traffic Manager" },
  { slug: "developpeur-front-end-freelance", label: "Développeur Front-End" },
  { slug: "developpeur-back-end-freelance", label: "Développeur Back-End" },
  { slug: "full-stack-developpeur-freelance", label: "Développeur Full-Stack" },
  { slug: "developeur-web-freelance", label: "Développeur Web" },
  { slug: "ux-writer-freelance", label: "UX Writer" },
  { slug: "account-manager-freelance", label: "Account Manager" },
];
---
<Base
  title="Les métiers freelances du Hub | digitags.work"
  description="UX designer, développeur, product manager, consultant SEO… découvrez les métiers freelances les plus recherchés du réseau digitags.work et trouvez le profil qu'il vous faut."
>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Les métiers du Hub</p>
      <h1>Staffez vos équipes, métier par métier.</h1>
      <p class="lead">De la technologie au marketing, le réseau couvre tous les métiers du digital. Explorez les profils les plus recherchés — chaque fiche détaille le métier, les compétences et quand y faire appel.</p>
      <div class="hero-cta">
        <a href="/contact" class="btn btn-dark">Recruter un freelance</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="section-title">Les métiers les plus recherchés.</h2>
      <div class="dir-grid">
        {metiers.map((m) => (
          <a href={`${LIVE}/${m.slug}`} class="dir-card">
            <span>{m.label} freelance</span>
            <span class="dir-arrow" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <HowItWorks />

  <CtaBanner title="Un métier manque à l'appel&nbsp;?" text="Le réseau couvre plus de 33 métiers du digital.<br />Décrivez votre besoin, nous trouvons le profil." />
</Base>
