---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import HowItWorks from '../components/HowItWorks.astro';
import CtaBanner from '../components/CtaBanner.astro';

// Ordre éditorial des fiches ; les fiches hors liste sont ajoutées à la suite.
const ORDER = [
  "concevoir-un-produit-digital",
  "mener-une-phase-dux-research",
  "audit-ux",
  "design-thinking",
  "discovery-produit",
  "strategie-produit",
  "identite-visuelle-creation-ou-refonte",
  "refonte-de-site-internet",
];
const rank = (slug: string) => { const i = ORDER.indexOf(slug); return i === -1 ? ORDER.length : i; };
const projets = (await getCollection('projets', ({ data }) => !data.draft))
  .sort((a, b) => rank(a.id) - rank(b.id) || a.data.title.localeCompare(b.data.title));
---
<Base
  title="Vos projets digitaux, réalisés avec le Hub | digitags.work"
  description="Audit UX, refonte de site, discovery produit, identité visuelle… les projets digitaux que les freelances et studios du réseau digitags.work réalisent pour vous."
>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Les projets du Hub</p>
      <h1>Réalisez vos projets digitaux avec le Hub.</h1>
      <p class="lead">À l'intersection des plateformes de freelances et des agences : la couche conseil et organisation d'une agence, avec l'agilité et le choix d'un réseau. Voici les projets sur lesquels nous intervenons le plus.</p>
      <div class="hero-cta">
        <a href="/contact" class="btn btn-dark">Lancer mon projet</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="section-title">Les projets les plus réalisés.</h2>
      <div class="dir-grid">
        {projets.map((p) => (
          <a href={`/projets/${p.id}`} class="dir-card">
            <span>{p.data.title}</span>
            <span class="dir-arrow" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <HowItWorks />

  <CtaBanner title="Votre projet ne rentre pas<br />dans une case&nbsp;?" text="Tant mieux. Décrivez-le nous,<br />nous composons l'équipe qui va avec." />
</Base>
