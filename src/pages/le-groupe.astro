---
import Base from '../layouts/Base.astro';

const etapes = [
  { title: "Le hub compose l'équipe.", desc: "Un expert, une équipe complémentaire ou un studio, selon le projet." },
  { title: "L'agence prend le relais sur l'acquisition.", desc: "Quand un projet a besoin de paid media ou de SEO sur un ou plusieurs marchés européens, Donutz Digital le pilote." },
  { title: "Un seul interlocuteur.", desc: "Nous gérons la coordination entre les freelances et l'agence." },
];
---
<Base
  title="Le groupe Digitags - Donutz : groupe digital européen | digitags.work"
  description="digitags.work fait partie du groupe digital européen Digitags - Donutz, avec Donutz Digital, agence de marketing digital paneuropéenne. Découvrez comment le hub et l'agence travaillent ensemble."
>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Le groupe</p>
      <h1>Digitags - Donutz&nbsp;: un groupe digital européen</h1>
      <p class="lead">Deux sociétés, un groupe. digitags.work est un hub de plus de 1&nbsp;600 freelances du digital sélectionnés. Donutz Digital est une agence de marketing digital paneuropéenne. Ensemble, ils réunissent les talents, la stratégie et les médias.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="section-title">Comment le groupe est organisé.</h2>
      <div class="org-chart">
        <article class="org-card org-holding">
          <span class="hex-icon hex-icon-yellow" aria-hidden="true"></span>
          <h3>Digitags - Donutz</h3>
          <p class="org-role">Société holding &middot; Paris</p>
        </article>
        <div class="org-stem" aria-hidden="true"></div>
        <div class="org-row">
          <div class="org-branch">
            <article class="org-card">
              <span class="hex-icon hex-icon-blue" aria-hidden="true"></span>
              <h3>digitags.work</h3>
              <p class="org-role">Le hub de 1&nbsp;600+ freelances du digital</p>
              <p class="org-desc">Un réseau fermé de freelances en design, marketing, product, tech, data et IA, sélectionnés et recommandés par leurs pairs.</p>
            </article>
          </div>
          <div class="org-branch">
            <article class="org-card">
              <span class="hex-icon hex-icon-red" aria-hidden="true"></span>
              <h3>Donutz Digital</h3>
              <p class="org-role">Agence de marketing digital paneuropéenne</p>
              <p class="org-desc">Google Ads, social ads, programmatique, SEO, création et analytics, pilotés par une équipe senior depuis la France, la Lituanie et l'Irlande.</p>
              <p class="org-link"><a href="https://donutzdigital.com/fr/" class="arrow-link">Découvrir l'agence <span aria-hidden="true">→</span></a></p>
            </article>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="section-title">Comment les deux travaillent ensemble.</h2>
      <div class="benefits-grid">
        {etapes.map((e, i) => (
          <article class="benefit-card">
            <span class="num-round">{String(i + 1).padStart(2, '0')}</span>
            <h3>{e.title}</h3>
            <p>{e.desc}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="section-title">De qui avez-vous besoin&nbsp;?</h2>
      <div class="reussites-grid cols-2">
        <article class="benefit-card">
          <h3>Vous cherchez des talents</h3>
          <p>Un expert, une équipe complémentaire ou un studio du réseau : décrivez votre besoin, nous composons le bon dispositif.</p>
          <p style="margin-top: 16px;"><a href="/contact" class="btn btn-dark">Décrire mon besoin</a></p>
        </article>
        <article class="benefit-card">
          <h3>Vous cherchez de la croissance en Europe</h3>
          <p>Paid media, SEO, création, analytics : l'agence de marketing digital paneuropéenne Donutz Digital pilote votre acquisition.</p>
          <p style="margin-top: 16px;"><a href="https://donutzdigital.com/fr/contact/" class="btn btn-outline">Contacter Donutz Digital</a></p>
        </article>
      </div>
      <p style="text-align:center; margin-top: 28px;">
        <a href="https://donutzdigital.com/fr/le-groupe/" class="arrow-link">Voir la page du groupe sur le site de l'agence <span aria-hidden="true">→</span></a>
      </p>
    </div>
  </section>
</Base>

<style>
  /* Organigramme du groupe : connecteurs en CSS, pas de librairie. */
  .org-chart { max-width: 760px; margin: 0 auto; }
  .org-card {
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 24px 26px;
    height: 100%;
    box-sizing: border-box;
  }
  .org-card .hex-icon { width: 26px; height: 30px; }
  .org-card h3 { margin: 12px 0 4px; font-size: 18px; }
  .org-role { color: var(--ink-soft); font-size: 14px; margin: 0; }
  .org-desc { color: var(--ink-soft); font-size: 14px; line-height: 1.55; margin: 10px 0 0; }
  .org-link { margin: 12px 0 0; }

  .org-holding {
    background: var(--navy);
    border-color: var(--navy);
    color: var(--white);
    max-width: 320px;
    margin: 0 auto;
    text-align: center;
    height: auto;
  }
  .org-holding h3 { color: var(--white); }
  .org-holding .org-role { color: rgba(255, 255, 255, 0.72); }
  .org-holding .hex-icon::after { background: var(--navy); }

  /* Connecteurs */
  .org-stem { width: 2px; height: 28px; margin: 0 auto; background: var(--ink-faint); opacity: 0.5; }
  .org-row { position: relative; display: grid; grid-template-columns: 1fr 1fr; gap: 24px; padding-top: 28px; }
  .org-row::before {
    content: "";
    position: absolute;
    top: 0;
    left: 25%;
    width: 50%;
    height: 2px;
    background: var(--ink-faint);
    opacity: 0.5;
  }
  .org-branch { position: relative; }
  .org-branch::before {
    content: "";
    position: absolute;
    top: -28px;
    left: 50%;
    margin-left: -1px;
    width: 2px;
    height: 28px;
    background: var(--ink-faint);
    opacity: 0.5;
  }

  /* Mobile : cartes empilées, connecteur vertical entre chaque. */
  @media (max-width: 720px) {
    .org-row { grid-template-columns: 1fr; padding-top: 0; }
    .org-row::before { display: none; }
    .org-branch { padding-top: 28px; }
    .org-branch::before { top: 0; }
  }
</style>
