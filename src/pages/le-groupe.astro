---
import Base from '../layouts/Base.astro';

const entites = [
  {
    title: "Digitags - Donutz",
    desc: "La société holding, basée à Paris. Elle réunit le hub de talents et l'agence au sein d'un même groupe digital européen.",
  },
  {
    title: "digitags.work",
    desc: "Le hub de talents : un réseau fermé de plus de 1 600 freelances en design, marketing, product, tech, data et IA, sélectionnés et recommandés par leurs pairs.",
  },
  {
    title: "Donutz Digital",
    desc: "L'agence : Google Ads, social ads, programmatique, SEO, création et analytics, pilotés par une équipe senior depuis la France, la Lituanie et l'Irlande.",
    href: "https://donutzdigital.com/fr/",
    link: "Découvrir l'agence",
  },
];

const etapes = [
  { title: "Le hub compose l'équipe.", desc: "Un expert, une équipe complémentaire ou un studio, selon le projet." },
  { title: "L'agence prend le relais sur l'acquisition.", desc: "Quand un projet a besoin de paid media ou de SEO sur un ou plusieurs marchés européens, Donutz Digital le pilote." },
  { title: "Un seul interlocuteur.", desc: "Nous gérons la coordination entre les freelances et l'agence." },
];
---
<Base
  title="Le groupe Digitags - Donutz : groupe digital européen | digitags.work"
  description="digitags.work fait partie du groupe digital européen Digitags - Donutz, avec Donutz Digital, agence de marketing digital paneuropéenne. Découvrez comment le hub et l'agence travaillent ensemble."
>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Le groupe</p>
      <h1>Digitags - Donutz&nbsp;: un groupe digital européen</h1>
      <p class="lead">Deux sociétés, un groupe. digitags.work est un hub de plus de 1&nbsp;600 freelances du digital sélectionnés. Donutz Digital est une agence de marketing digital paneuropéenne. Ensemble, ils réunissent les talents, la stratégie et les médias.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="section-title">Comment le groupe est organisé.</h2>
      <div class="benefits-grid">
        {entites.map((e) => (
          <article class="benefit-card">
            <h3>{e.title}</h3>
            <p>{e.desc}</p>
            {e.href && (
              <p style="margin-top: 14px;"><a href={e.href} class="arrow-link stretch-link">{e.link} <span aria-hidden="true">→</span></a></p>
            )}
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="section-title">Comment les deux travaillent ensemble.</h2>
      <div class="benefits-grid">
        {etapes.map((e, i) => (
          <article class="benefit-card">
            <span class="num-round">{String(i + 1).padStart(2, '0')}</span>
            <h3>{e.title}</h3>
            <p>{e.desc}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="section-title">De qui avez-vous besoin&nbsp;?</h2>
      <div class="reussites-grid cols-2">
        <article class="benefit-card">
          <h3>Vous cherchez des talents</h3>
          <p>Un expert, une équipe complémentaire ou un studio du réseau : décrivez votre besoin, nous composons le bon dispositif.</p>
          <p style="margin-top: 16px;"><a href="/contact" class="btn btn-dark">Décrire mon besoin</a></p>
        </article>
        <article class="benefit-card">
          <h3>Vous cherchez de la croissance en Europe</h3>
          <p>Paid media, SEO, création, analytics : l'agence de marketing digital paneuropéenne Donutz Digital pilote votre acquisition.</p>
          <p style="margin-top: 16px;"><a href="https://donutzdigital.com/fr/contact/" class="btn btn-outline">Contacter Donutz Digital</a></p>
        </article>
      </div>
      <p style="text-align:center; margin-top: 28px;">
        <a href="https://donutzdigital.com/fr/le-groupe/" class="arrow-link">Voir la page du groupe sur le site de l'agence <span aria-hidden="true">→</span></a>
      </p>
    </div>
  </section>
</Base>
