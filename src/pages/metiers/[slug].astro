---
// Fiches métiers françaises. Le template (parseur de sections, rendu, maillage)
// est factorisé dans src/components/FicheMetier.astro, partagé avec /en/roles/.
import { getCollection } from 'astro:content';
import FicheMetier from '../../components/FicheMetier.astro';

export async function getStaticPaths() {
  const fiches = await getCollection('metiers', ({ data }) => !data.draft);
  return fiches.map((fiche) => ({ params: { slug: fiche.id }, props: { fiche } }));
}

const { fiche } = Astro.props;
---
<FicheMetier fiche={fiche} lang="fr" />
