---
// Home anglaise (/en) — miroir de src/pages/index.astro, contenu traduit.
// Le blog et les fiches liées restent en français (phase 1).
import Base from '../../layouts/Base.astro';
import HowItWorks from '../../components/HowItWorks.astro';
import Testimonials from '../../components/Testimonials.astro';
import CtaBanner from '../../components/CtaBanner.astro';

const expertises = [
  { href: "/en/design", icon: "icon-uxui", title: "Design & UX", desc: "Useful experiences that convert." },
  { href: "/en/digital-marketing", icon: "icon-paid-media", title: "Marketing & Acquisition", desc: "SEO, paid search, social ads: measurable growth." },
  { href: "/en/product-and-project", icon: "icon-crm", title: "Product & Project", desc: "Products on track, projects delivered." },
  { href: "/en/tech-and-data", icon: "icon-data", title: "Tech & Data", desc: "Robust engineering, data-driven decisions." },
  { href: "/en/hire-a-freelancer", icon: "icon-seo", title: "Freelance collaboration", desc: "The right expert, vetted by their peers." },
  { href: "/en/studios-and-collectives", icon: "icon-tech", title: "Studios & Collectives", desc: "Ready-made teams, ready to start." },
];
---
<Base
  title="digitags.work — The digital talent hub"
  description="A hub of 1,600+ vetted digital freelancers, recommended by their peers. Not a marketplace, not a staffing firm: experts working solo or as a team."
>
  <!-- ============ HERO ============ -->
  <section class="hero" id="talents">
    <div class="container hero-grid">
      <div class="hero-copy">
        <a href="/en/ai-product-team" class="notice-pill"><span class="pill-tag">New</span> AI Product Team: from POC to production <span aria-hidden="true">→</span></a>
        <p class="eyebrow">The digital talent hub</p>
        <h1>1,600+ vetted European digital experts. One trusted network.</h1>
        <p class="lead">Not a marketplace, not a staffing firm: every expert is vetted and recommended by their peers — working solo or as a team to accelerate your digital projects.</p>
        <div class="hero-cta">
          <a href="/en/contact" class="btn btn-dark">Find your expert</a>
          <a href="/en/become-a-freelancer" class="btn btn-outline">Join the collective</a>
        </div>
      </div>

      <div class="hero-collage" aria-hidden="true">
        <svg class="collage-lines" viewBox="0 0 530 500" fill="none" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none">
          <path d="M85 230 H30 V440 H160" stroke="#F2543D" stroke-width="5"/>
          <path d="M180 70 H90 V180" stroke="#F5B731" stroke-width="5"/>
          <path d="M300 150 V250 H380" stroke="#111C3F" stroke-width="5"/>
          <path d="M430 400 H505 V170 H440" stroke="#2B46F0" stroke-width="5"/>
        </svg>
        <span class="hex hex-blue"></span>
        <img class="collage-photo p1" src="/assets/photos/talent-1.jpg" alt="" width="150" height="200" />
        <img class="collage-photo p2" src="/assets/photos/talent-2.jpg" alt="" width="150" height="200" />
        <img class="collage-photo p3" src="/assets/photos/talent-3.jpg" alt="" width="150" height="200" />
        <img class="collage-photo p4" src="/assets/photos/talent-4.jpg" alt="" width="150" height="200" />
        <img class="collage-photo p5" src="/assets/photos/talent-5.jpg" alt="" width="150" height="200" />
      </div>
    </div>
  </section>

  <!-- ============ TRUST BAR ============ -->
  <section class="trustbar">
    <div class="container">
      <div class="trust-card">
        <div class="trust-row">
          <p class="trust-count">More than <strong>1,600 freelancers</strong><br />in our network</p>
          <ul class="trust-logos" aria-label="They trust us">
            <li class="tl-qonto">Crédit Agricole</li>
            <li class="tl-lacoste">TOD'S</li>
            <li class="tl-manomano">Mon Compte<br />Formation</li>
            <li class="tl-alan">Techdata</li>
            <li class="tl-backmarket">Autodesk</li>
            <li class="tl-ledger">Lichens</li>
          </ul>
        </div>
        <div class="trust-stats">
          <div class="stat">
            <span class="hex-icon hex-icon-blue"></span>
            <span>15+ digital skill areas</span>
          </div>
          <a href="/en/studios-and-collectives" class="stat">
            <span class="hex-icon hex-icon-yellow"></span>
            <span>10 studios &amp; collectives</span>
          </a>
          <div class="stat">
            <span class="hex-icon hex-icon-red"></span>
            <span>8 years of experience</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ EXPERTISES ============ -->
  <section class="expertises" id="expertises">
    <div class="container">
      <h2 class="section-title">An expert for every challenge.</h2>
      <div class="expertise-grid">
        {expertises.map((e) => (
          <a href={e.href} class="expertise-card">
            <img src={`/assets/icons/${e.icon}.svg`} alt="" class="expertise-icon" loading="lazy" />
            <h3>{e.title}</h3>
            <p>{e.desc}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <HowItWorks lang="en" />

  <!-- ============ CAS CLIENTS ============ -->
  <section class="cases" id="apropos">
    <div class="container">
      <h2 class="section-title">Talent that moves projects forward.</h2>
      <div class="cases-grid">

        <article class="case-main">
          <div class="case-copy">
            <p class="case-label">Case study</p>
            <p class="case-brand">Mon Compte Formation</p>
            <p class="case-desc">SEO launch of France's national professional-training platform, alongside Caisse des Dépôts</p>
            <div class="case-kpis">
              <div class="kpi">
                <span class="kpi-value kpi-blue">30.4K</span>
                <span class="kpi-label">keywords ranked in 6 months</span>
              </div>
              <div class="kpi">
                <span class="kpi-value kpi-red">Top 1</span>
                <span class="kpi-label">for "CPF" (246K searches/month)</span>
              </div>
            </div>
            <a href="/en/case-studies/mon-compte-formation" class="btn btn-outline btn-sm">Read the case study</a>
          </div>
          <div class="case-dash" aria-hidden="true">
            <div class="dash-row">
              <div class="dash-tile">
                <p class="dash-label">Content created or optimized</p>
                <p class="dash-value">600+</p>
                <p class="dash-delta up">▲ SEO editorial strategy</p>
              </div>
              <div class="dash-tile">
                <p class="dash-label">Keywords in top 3</p>
                <p class="dash-value">1,853</p>
                <p class="dash-delta up">▲ 6 months after launch</p>
              </div>
            </div>
            <div class="dash-chart">
              <p class="dash-label">Keywords ranked</p>
              <svg viewBox="0 0 320 130" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none" class="chart-svg">
                <polyline points="10,115 60,104 110,92 160,70 210,52 260,30 310,36"
                          fill="none" stroke="#2B46F0" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
                <circle cx="260" cy="30" r="4" fill="#2B46F0"/>
              </svg>
              <span class="chart-tip">Month 6<br /><strong>30.4K</strong></span>
              <div class="chart-axis">
                <span>M1</span><span>M2</span><span>M3</span><span>M4</span><span>M5</span><span>M6</span>
              </div>
            </div>
          </div>
        </article>

        <div class="cases-side">
          <article class="case-side-card">
            <div>
              <p class="case-label label-blue">Insight</p>
              <h3>Flash audit: score your "freelance-ready" maturity in 10 questions</h3>
              <a href="/en/blog/freelance-ready-flash-audit" class="arrow-link stretch-link">Read the article <span aria-hidden="true">→</span></a>
            </div>
            <span class="side-shape side-shape-blue" aria-hidden="true"></span>
          </article>
          <article class="case-side-card">
            <div>
              <p class="case-label label-red">Project</p>
              <h3>Website redesign: scope it, design it, ship it</h3>
              <a href="/en/projects/website-redesign" class="arrow-link stretch-link">View the project <span aria-hidden="true">→</span></a>
            </div>
            <div class="mini-cart" aria-hidden="true">
              <p class="mini-cart-title">Your cart</p>
              <div class="mini-line"><span class="mini-thumb"></span><span class="mini-bar"></span></div>
              <div class="mini-line"><span class="mini-thumb"></span><span class="mini-bar"></span></div>
              <button class="mini-btn" type="button" tabindex="-1">Checkout</button>
            </div>
          </article>
        </div>

      </div>
    </div>
  </section>

  <Testimonials lang="en" />

  <CtaBanner lang="en" />
</Base>
