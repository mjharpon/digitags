---
// Version anglaise de src/pages/tech-data.astro (fiches métiers liées en FR, phase 1).
import Base from '../../layouts/Base.astro';
import ExpertisePage from '../../components/ExpertisePage.astro';
---
<Base
  title="Freelance developers & data experts | digitags.work"
  description="Freelance developers (front-end, back-end, full-stack) and data experts, vetted and recommended by their peers, to build and measure your products."
>
  <ExpertisePage
    lang="en"
    eyebrow="Your Tech & Data hub"
    title="Build robust, decide data-driven."
    lead="Developers, data scientists, data engineers and web analysts: vetted senior profiles to build your products and turn your data into decisions."
    ctaLabel="Find an expert"
    skillsTitle="Tech & data skills in the network"
    skills={["Front-End Developer", "Back-End Developer", "Full-Stack Developer", "Mobile Developer", "Tech Lead", "DevOps", "Data Scientist", "Data Engineer", "Data Analyst", "Web Analyst", "Business Analyst", "Data Project Manager"]}
    metiers={[
      { label: "Freelance web developer", href: "/en/roles/freelance-web-developer" },
      { label: "Front-end developer", href: "/en/roles/freelance-front-end-developer" },
      { label: "Back-end developer", href: "/en/roles/freelance-back-end-developer" },
      { label: "Full-stack developer", href: "/en/roles/freelance-full-stack-developer" },
      { label: "Mobile developer", href: "/en/roles/freelance-mobile-developer" },
      { label: "Tech lead", href: "/en/roles/freelance-tech-lead" },
      { label: "DevOps engineer", href: "/en/roles/freelance-devops-engineer" },
      { label: "Data scientist", href: "/en/roles/freelance-data-scientist" },
      { label: "Data engineer", href: "/en/roles/freelance-data-engineer" },
      { label: "Data analyst", href: "/en/roles/freelance-data-analyst" },
    ]}
    reussites={[
      { tag: "Analytics", title: "Senior Web Analyst mission", points: ["Consulting and analysis", "Complete tagging plan", "Reporting and dashboards"] },
      { tag: "Data Science", title: "Data Scientist mission", points: ["Advanced data analyses", "Strategic reporting", "Actionable recommendations"] },
    ]}
  />
</Base>
