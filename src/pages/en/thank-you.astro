---
// Version anglaise de src/pages/merci.astro (hors sitemap et hors .md, comme /merci).
import Base from '../../layouts/Base.astro';
---
<Base title="Thank you! | digitags.work" description="Your brief has been sent to the Hub.">
  <section class="page-hero" style="padding-bottom: 120px;">
    <div class="container">
      <p class="eyebrow">Brief sent</p>
      <h1>Thank you — we've got it.</h1>
      <p class="lead">Your brief is in good hands: we'll get back to you very quickly to talk it through and reach out to the right profiles in the network.</p>
      <div class="hero-cta">
        <a href="/en" class="btn btn-dark">Back to the homepage</a>
        <a href="https://www.digitags.work/blog" class="btn btn-outline">Read the Hub blog (in French)</a>
      </div>
    </div>
  </section>
</Base>
