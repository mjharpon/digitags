---
import Base from '../layouts/Base.astro';
---
<Base title="Talents — outil interne | digitags.work" description="Outil interne de recherche dans la base de talents du Hub.">
  <noscript><p class="container" style="padding: 40px 0;">Cet outil nécessite JavaScript.</p></noscript>

  <!-- Écran de connexion -->
  <div id="login" class="tool-login" hidden>
    <p class="eyebrow">Outil interne</p>
    <h1 style="font-size: 26px; font-weight: 800; margin-bottom: 18px;">Talents du Hub</h1>
    <div class="form-card">
      <button class="btn btn-dark" id="login-google" style="width: 100%; margin-bottom: 18px;">Se connecter avec Google</button>
      <p style="text-align:center; font-size: 12px; color: var(--ink-faint); margin-bottom: 16px;">— ou par email —</p>
      <div id="login-step1">
        <div class="field">
          <label for="login-email">Email professionnel</label>
          <input type="email" id="login-email" placeholder="prenom@donutz.fr" autocomplete="email" />
        </div>
        <button class="btn btn-dark" id="login-send">Recevoir mon lien de connexion</button>
      </div>
      <div id="login-step2" hidden>
        <div class="field">
          <label for="login-code">Code (si présent dans l'email)</label>
          <input type="text" id="login-code" inputmode="numeric" placeholder="123456" />
        </div>
        <button class="btn btn-dark" id="login-verify">Se connecter</button>
      </div>
      <p id="login-msg" style="font-size: 13px; color: var(--ink-faint); margin-top: 12px;"></p>
    </div>
  </div>

  <!-- App -->
  <div id="app" class="tool" hidden>
    <div class="tool-bar">
      <div class="tool-tabs">
        <button class="tool-tab active" data-tab="recherche">Recherche</button>
        <button class="tool-tab" data-tab="clients">Clients</button>
        <button class="tool-tab" data-tab="propales">Propales</button>
      </div>
      <button class="btn btn-outline btn-sm" id="logout">Déconnexion</button>
    </div>

    <!-- Accès refusé / données injoignables : la barre (et Déconnexion) reste visible -->
    <div id="app-gate" class="tool-gate" hidden></div>

    <div class="tool-hero">
      <div>
        <h1>Talents <span>du Hub</span></h1>
        <p class="th-lead">Trouvez les meilleurs freelances pour vos projets digitaux.</p>
        <ul class="th-badges">
          <li><span class="th-dot th-dot-green">✓</span> Profils vérifiés</li>
          <li><span class="th-dot th-dot-yellow">◷</span> Disponibilités à jour</li>
          <li><span class="th-dot th-dot-red">⌕</span> Recherche dans les CV</li>
        </ul>
      </div>
      <div class="th-illu" aria-hidden="true">
        <div class="th-card th-c1"><span class="th-ava a1"></span><em>UX/UI</em></div>
        <div class="th-card th-c2"><span class="th-ava a2"></span><em>Data</em></div>
        <div class="th-card th-c3"><span class="th-ava a3"></span><em>Marketing</em></div>
      </div>
    </div>

    <div id="tab-recherche">
      <div class="search-panel">
        <div class="search-row">
          <div class="search-box">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
            <input type="search" id="f-q" placeholder="Rechercher un nom, une compétence, un outil…" />
          </div>
          <button class="btn btn-blue" id="btn-search">Recherche</button>
          <button class="btn btn-outline" id="btn-propales">Propales</button>
          <button class="btn btn-outline" id="btn-filters">Filtres</button>
        </div>
        <div class="filters" id="filters-block">
          <label class="chk" title="Recherche plein-texte dans le contenu des CV"><input type="checkbox" id="f-incv" /> Dans les CV</label>
          <div class="ms" id="ms-group"></div>
          <div class="ms" id="ms-exp"></div>
          <div class="ms" id="ms-tjm"></div>
          <label class="chk"><input type="checkbox" id="f-dispo" /> <span class="avail-dot"></span> Disponibles</label>
          <label class="chk"><input type="checkbox" id="f-en" /> Anglais courant</label>
          <label class="chk"><input type="checkbox" id="f-stars" /> ★ 4+</label>
          <label class="chk"><input type="checkbox" id="f-cdi" /> Ouvert CDI</label>
          <label class="chk"><input type="checkbox" id="f-dg" /> Déjà avec digitags</label>
          <label class="chk"><input type="checkbox" id="f-sf" /> Salesforce</label>
          <label class="chk"><input type="checkbox" id="f-site" /> Visible sur le site</label>
          <button class="f-reset" id="f-reset" type="button">↺ Réinitialiser</button>
        </div>
      </div>

      <div class="tool-layout">
        <div>
          <div class="results-head">
            <p class="results-meta" id="results-meta"></p>
            <div class="results-tools">
              <label for="f-sort">Trier par</label>
              <select id="f-sort">
                <option value="pertinence">Pertinence</option>
                <option value="tjm-asc">TJM croissant</option>
                <option value="tjm-desc">TJM décroissant</option>
                <option value="dispo">Disponibilité</option>
                <option value="nom">Nom A–Z</option>
              </select>
              <div class="view-toggle" role="group" aria-label="Affichage">
                <button id="view-grid" class="active" title="Vue grille" aria-label="Vue grille">▦</button>
                <button id="view-list" title="Vue liste" aria-label="Vue liste">☰</button>
              </div>
            </div>
          </div>
          <div class="profiles-grid" id="results"></div>
          <p style="margin-top: 14px;"><button class="btn btn-outline btn-sm" id="more" hidden>Charger plus</button></p>
        </div>

        <aside class="tool-side">
          <div class="side-card side-navy" id="sel-panel">
            <span class="side-spark">✦</span>
            <h2>Besoin d'un profil spécifique&nbsp;?</h2>
            <p class="empty" id="sel-empty">Ajoutez des profils avec le bouton «&nbsp;+&nbsp;» des cartes pour composer une propale.</p>
            <ul id="sel-list"></ul>
            <button class="btn btn-yellow btn-sm" id="sel-create" hidden>Créer une propale →</button>
          </div>
          <div class="side-card">
            <h3><span class="side-bolt">⚡</span> Filtres rapides</h3>
            <div class="quick-chips" id="quick-groups"></div>
            <a class="side-link" href="/metiers" target="_blank" rel="noopener">Voir tous les métiers →</a>
          </div>
          <div class="side-card">
            <h3>Vous êtes freelance&nbsp;?</h3>
            <p class="side-text">Rejoignez le Hub et accédez à des missions de qualité.</p>
            <a href="/devenir-freelance" class="btn btn-dark btn-sm">Rejoindre digitags</a>
          </div>
        </aside>
      </div>
    </div>

    <div id="tab-clients" hidden>
      <div class="clients-head">
        <p class="results-meta" id="clients-meta"></p>
        <label class="chk arch-toggle"><input type="checkbox" id="clients-arch" /> Voir les archivés</label>
        <button class="btn btn-blue btn-sm" id="client-new">+ Nouveau client</button>
      </div>
      <div class="props-list" id="clients-list"></div>
    </div>

    <div id="tab-propales" hidden>
      <div class="props-filter">
        <label for="props-client">Client</label>
        <select id="props-client">
          <option value="">Tous les clients</option>
        </select>
        <label class="chk arch-toggle"><input type="checkbox" id="props-arch" /> Voir les archivées</label>
      </div>
      <div class="props-list" id="props-list"></div>
    </div>
  </div>

  <!-- Fond bloquant des formulaires (propale, client) -->
  <div id="backdrop" class="drawer-backdrop" hidden></div>

  <!-- Formulaire propale -->
  <div id="prop-form" class="drawer" hidden></div>

  <!-- Fiche client (création / édition) -->
  <div id="client-form" class="drawer" hidden></div>

  <!-- Fiche profil (toujours au-dessus des formulaires) -->
  <div id="drawer" class="drawer drawer-top" hidden></div>

  <div id="toast" class="toast" hidden></div>

  <script>
    import { createClient } from '@supabase/supabase-js';

    const URL_ = import.meta.env.PUBLIC_SUPABASE_URL;
    const KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
    const $ = (id) => document.getElementById(id);
    const esc = (s) => String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
    // Mot de passe d'une propale : 10 caractères tirés au hasard (générateur
    // cryptographique), sans les caractères qui se confondent à la lecture (0 O 1 l I).
    const PW_ALPHABET = 'abcdefghijkmnopqrstuvwxyzABCDEFGHJKLMNPQRSTUVWXYZ23456789';
    const genPassword = (len = 10) => {
      const n = PW_ALPHABET.length;
      const limit = 256 - (256 % n); // rejet des octets hors plage : tirage sans biais
      let out = '';
      while (out.length < len) {
        for (const b of crypto.getRandomValues(new Uint8Array(len * 2))) {
          if (b < limit && out.length < len) out += PW_ALPHABET[b % n];
        }
      }
      return out;
    };

    if (!URL_ || !KEY) {
      document.body.insertAdjacentHTML('afterbegin', '<p class="container" style="padding:40px 24px;font-weight:700;">Configuration Supabase manquante (PUBLIC_SUPABASE_URL / PUBLIC_SUPABASE_ANON_KEY).</p>');
      throw new Error('missing supabase config');
    }
    const sb = createClient(URL_, KEY);

    const PAGE = 30;

    // La sélection survit au rechargement de la page (sessionStorage : onglet courant).
    const SEL_KEY = 'talents-selection';
    function loadSelection() {
      try {
        const arr = JSON.parse(sessionStorage.getItem(SEL_KEY) || '[]');
        return new Map(arr
          .filter((s) => s && /^[0-9a-f-]{36}$/i.test(s.id))
          .map((s) => [s.id, { id: s.id, name: String(s.name ?? ''), job: String(s.job ?? '') }]));
      } catch { return new Map(); }
    }
    function saveSelection() {
      try { sessionStorage.setItem(SEL_KEY, JSON.stringify([...state.selection.values()])); } catch {}
    }

    let state = { page: 0, selection: loadSelection(), groups: [], clients: [], archivedClients: [], propFilter: '', showArchClients: false, showArchProps: false, userEmail: '', lastCount: 0, fGroups: new Set(), fExps: new Set(), fTjms: new Set(), sort: 'pertinence' };

    let toastT;
    const toast = (msg, ms = 2600) => { const t = $('toast'); t.textContent = msg; t.hidden = false; clearTimeout(toastT); toastT = setTimeout(() => (t.hidden = true), ms); };
    const toastErr = (msg) => toast(msg, 6000);

    // Désactive un bouton pendant un envoi : un double-clic ne part qu'une fois.
    async function busy(btn, fn) {
      if (btn.disabled) return;
      btn.disabled = true;
      try { return await fn(); } finally { btn.disabled = false; }
    }

    // Nombre de jours : mêmes bornes que la page propale côté client (0,5 à 365).
    const clampDays = (v) => {
      const n = Number(String(v ?? '').replace(',', '.'));
      if (!Number.isFinite(n) || n <= 0) return null;
      return Math.min(365, Math.max(0.5, Math.round(n * 100) / 100));
    };
    // TJM client = TJM de base + marge, arrondi au multiple de 5 SUPÉRIEUR
    // (jamais sous la marge saisie). L'epsilon absorbe les erreurs de flottants.
    const tjmClient = (base, marge) => Math.ceil(base * (100 + marge) / 500 - 1e-9) * 5;

    // Formulaires bloquants : un fond empêche de modifier la sélection derrière.
    function openForm(f) { f.hidden = false; $('backdrop').hidden = false; }
    function closeForm(f) { f.hidden = true; $('backdrop').hidden = $('prop-form').hidden && $('client-form').hidden; }

    // Menu déroulant à sélection multiple. Retourne { update } pour rafraîchir
    // le libellé (et l'état des cases) quand le Set est modifié ailleurs.
    function makeMulti(root, label, items, set) {
      root.innerHTML = '';
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'ms-btn';
      const panel = document.createElement('div');
      panel.className = 'ms-panel';
      panel.hidden = true;
      const boxes = [];
      const update = () => {
        btn.textContent = set.size ? label + ' (' + set.size + ')' : label + ' — tous';
        boxes.forEach(({ cb, v }) => { cb.checked = set.has(v); });
      };
      items.forEach(({ v, t }) => {
        const l = document.createElement('label');
        const cb = document.createElement('input');
        cb.type = 'checkbox';
        cb.checked = set.has(v);
        cb.addEventListener('change', () => { cb.checked ? set.add(v) : set.delete(v); update(); onFilterChange(); });
        boxes.push({ cb, v });
        l.append(cb, document.createTextNode(' ' + t));
        panel.append(l);
      });
      btn.addEventListener('click', () => { panel.hidden = !panel.hidden; });
      root.append(btn, panel);
      update();
      return { update };
    }
    document.addEventListener('click', (e) => {
      document.querySelectorAll('.ms-panel').forEach((p) => {
        if (!p.parentElement.contains(e.target)) p.hidden = true;
      });
    });

    // ---------- Auth ----------
    let started = false;
    sb.auth.onAuthStateChange((event) => {
      if (event === 'SIGNED_IN' && !started) {
        $('login').hidden = true;
        start();
      }
    });
    async function init() {
      const { data: { session } } = await sb.auth.getSession();
      if (session) return start();
      $('login').hidden = false;
    }

    $('login-google').addEventListener('click', async () => {
      $('login-msg').textContent = 'Redirection vers Google…';
      const { error } = await sb.auth.signInWithOAuth({
        provider: 'google',
        options: { redirectTo: location.origin + '/talents' },
      });
      if (error) $('login-msg').textContent = 'Erreur : ' + error.message;
    });

    $('login-send').addEventListener('click', async () => {
      const email = $('login-email').value.trim();
      if (!email) return;
      $('login-msg').textContent = 'Envoi du code…';
      const { error } = await sb.auth.signInWithOtp({ email, options: { shouldCreateUser: true, emailRedirectTo: location.origin + '/talents' } });
      if (error) { $('login-msg').textContent = 'Erreur : ' + error.message; return; }
      $('login-step1').hidden = true;
      $('login-step2').hidden = false;
      $('login-msg').textContent = 'Email envoyé à ' + email + ' — cliquez le lien de connexion qu\'il contient (depuis cet appareil). Si l\'email affiche un code, vous pouvez aussi le saisir ci-dessus.';
    });

    $('login-verify').addEventListener('click', async () => {
      const email = $('login-email').value.trim();
      const token = $('login-code').value.trim();
      const { error } = await sb.auth.verifyOtp({ email, token, type: 'email' });
      if (error) { $('login-msg').textContent = 'Code invalide : ' + error.message; return; }
      $('login').hidden = true;
      start();
    });

    $('logout').addEventListener('click', async () => {
      // Hors ligne, la déconnexion serveur échoue : on ferme au moins la session locale.
      const { error } = await sb.auth.signOut();
      if (error) await sb.auth.signOut({ scope: 'local' });
      location.reload();
    });

    // ---------- App ----------
    let msGroup, msExp, msTjm;
    function onFilterChange() { renderQuickChips(); search(true); }

    async function start() {
      if (started) return;
      started = true;
      history.replaceState(null, '', location.pathname);
      $('app').hidden = false;
      const { data: { session } } = await sb.auth.getSession();
      state.userEmail = session?.user?.email ?? '';
      const { data: groups, error } = await sb.from('job_groups').select('id, name').order('sort');
      // Une erreur (réseau, session expirée) n'est pas un refus d'accès.
      if (error) return showGate('error', error.message);
      if (!groups?.length) {
        // RLS : utilisateur connecté mais pas membre de l'équipe → aucune donnée, sans erreur.
        const { count, error: e2 } = await sb.from('profiles').select('id', { count: 'exact', head: true });
        if (e2) return showGate('error', e2.message);
        if (!count) return showGate('denied');
      }
      state.groups = groups ?? [];
      msGroup = makeMulti($('ms-group'), 'Familles', state.groups.map((g) => ({ v: g.id, t: g.name })), state.fGroups);
      const { data: exps } = await sb.from('profiles').select('experience').not('experience', 'is', null).limit(1000);
      const expList = [...new Set((exps ?? []).map((e) => e.experience))].sort();
      msExp = makeMulti($('ms-exp'), 'Expérience', expList.map((e) => ({ v: e, t: e })), state.fExps);
      msTjm = makeMulti($('ms-tjm'), 'TJM', [
        // Tranches sans chevauchement : borne basse incluse, borne haute exclue.
        { v: '0-400', t: '< 400 €' },
        { v: '400-600', t: '400 – 599 €' },
        { v: '600-800', t: '600 – 799 €' },
        { v: '800-', t: '800 € et plus' },
      ], state.fTjms);
      renderQuickChips();
      renderSelection();
      search(true);
      loadClients().then(loadProposals);
    }

    // Écran d'attente : remplace le contenu de l'app mais garde la barre du haut
    // (donc le bouton Déconnexion, seul moyen de changer de compte).
    function showGate(kind, detail) {
      const g = $('app-gate');
      $('app').classList.add('gated');
      g.innerHTML = kind === 'denied'
        ? `<h2>Accès non autorisé</h2>
           <p>Le compte <strong>${esc(state.userEmail || 'connecté')}</strong> ne fait pas partie de l'équipe (table team_members). Déconnectez-vous pour changer de compte.</p>`
        : `<h2>Impossible de charger les données</h2>
           <p>Problème de réseau ou session expirée — vos droits d'accès ne sont pas en cause.${detail ? ` <span class="gate-detail">(${esc(detail)})</span>` : ''}</p>
           <button class="btn btn-dark btn-sm" id="gate-retry">Réessayer</button>`;
      g.hidden = false;
      $('gate-retry')?.addEventListener('click', () => location.reload());
    }

    // Raccourcis familles dans la colonne de droite, synchronisés avec le filtre.
    function renderQuickChips() {
      const host = $('quick-groups');
      if (!host) return;
      host.innerHTML = state.groups.map((g) =>
        `<button type="button" class="qchip ${state.fGroups.has(g.id) ? 'on' : ''}" data-qg="${g.id}">${esc(g.name.split(' (')[0])}</button>`
      ).join('');
    }
    $('quick-groups').addEventListener('click', (e) => {
      const b = e.target.closest('[data-qg]');
      if (!b) return;
      const id = b.dataset.qg;
      state.fGroups.has(id) ? state.fGroups.delete(id) : state.fGroups.add(id);
      msGroup?.update();
      onFilterChange();
    });

    function buildQuery() {
      let q = sb.from('profiles').select('id, name, job, photo_url, disponible, dispo_from, fluent_english, experience, stars, tarif_jour, tjm_free, job_group_id, cdi, salesforce, dgitags_experience', { count: 'exact' });
      const text = $('f-q').value.trim().replace(/[(),%]/g, ' ').trim();
      if (text) {
        if ($('f-incv').checked) q = q.or(`name.ilike.%${text}%,job.ilike.%${text}%,cv_fts.wfts(french).${text}`);
        else q = q.or(`name.ilike.%${text}%,job.ilike.%${text}%`);
      }
      if (state.fGroups.size) q = q.in('job_group_id', [...state.fGroups]);
      if (state.fExps.size) q = q.in('experience', [...state.fExps]);
      // Aligné sur la pastille verte : « disponible » coché OU date de dispo déjà passée.
      if ($('f-dispo').checked) q = q.or(`disponible.eq.true,dispo_from.lte.${new Date().toISOString().slice(0, 10)}`);
      if ($('f-en').checked) q = q.eq('fluent_english', true);
      if ($('f-stars').checked) q = q.gte('stars', 4).lte('stars', 5);
      if ($('f-cdi').checked) q = q.eq('cdi', true);
      if ($('f-dg').checked) q = q.eq('dgitags_experience', 'Oui');
      if ($('f-sf').checked) q = q.eq('salesforce', true);
      if ($('f-site').checked) q = q.eq('show_on_website', true);
      // Filtre TJM sur la valeur AFFICHÉE sur la carte : tjm_free, sinon tarif_jour.
      if (state.fTjms.size) {
        q = q.or([...state.fTjms].flatMap((r) => {
          const [lo, hi] = r.split('-');
          const rng = (col) => `${col}.gt.0,${col}.gte.${lo}` + (hi ? `,${col}.lt.${hi}` : '');
          return [`and(${rng('tjm_free')})`, `and(or(tjm_free.is.null,tjm_free.eq.0),${rng('tarif_jour')})`];
        }).join(','));
      }
      // Tri par TJM : les profils sans TJM affiché n'ont rien à trier, on les écarte
      // (le compteur le signale) plutôt que de les laisser en tête du tri croissant.
      if (sortByTjm()) q = q.or('tjm_free.gt.0,tarif_jour.gt.0');
      switch (state.sort) {
        case 'tjm-asc': return q.order('tjm_free', { ascending: true, nullsFirst: false }).order('tarif_jour', { ascending: true, nullsFirst: false }).order('name');
        case 'tjm-desc': return q.order('tjm_free', { ascending: false, nullsFirst: false }).order('tarif_jour', { ascending: false, nullsFirst: false }).order('name');
        case 'dispo': return q.order('disponible', { ascending: false }).order('dispo_from', { ascending: true, nullsFirst: false }).order('name');
        case 'nom': return q.order('name');
        default: return q.order('stars', { ascending: false, nullsFirst: false }).order('name');
      }
    }

    const sortByTjm = () => state.sort === 'tjm-asc' || state.sort === 'tjm-desc';

    // Chaque recherche est numérotée : une réponse arrivée après une requête
    // plus récente est ignorée (sinon elle écraserait les bons résultats).
    let searchSeq = 0;
    let deb = null;
    async function search(reset) {
      clearTimeout(deb); // une recherche explicite annule la frappe en attente
      const seq = ++searchSeq;
      const page = reset ? 0 : state.page + 1;
      const from = page * PAGE;
      $('more').disabled = true;
      const { data, count, error } = await buildQuery().range(from, from + PAGE - 1);
      if (seq !== searchSeq) return;
      $('more').disabled = false;
      if (error) {
        toastErr('Erreur : ' + error.message);
        // Nouvelle recherche en échec : on n'affiche pas d'anciens résultats sous un
        // compteur faux. « Charger plus » en échec : la page n'avance pas, on peut recliquer.
        if (reset) {
          state.page = 0; state.lastCount = 0;
          $('results').innerHTML = '';
          $('results-meta').textContent = 'Recherche impossible — vérifiez la connexion puis relancez.';
          $('more').hidden = true;
        }
        return;
      }
      const total = count ?? 0;
      if (reset) $('results').innerHTML = '';
      state.page = page;
      state.lastCount = total;
      $('results-meta').textContent = `${total} profil${total > 1 ? 's' : ''}${sortByTjm() ? ' · tri par TJM : profils sans TJM masqués' : ''}`;
      $('results').insertAdjacentHTML('beforeend', (data ?? []).map(card).join(''));
      $('more').hidden = from + PAGE >= total;
    }

    // TJM affiché : tjm_free, sinon tarif_jour (0 = non renseigné).
    const tjmOf = (p) => p.tjm_free || p.tarif_jour || null;
    const frDate = (d) => new Date(d).toLocaleDateString('fr-FR', { day: 'numeric', month: 'short', year: 'numeric' });
    function dispoPill(p) {
      if (p.disponible) return '<span class="pc-dispo ok">Disponible</span>';
      if (p.dispo_from) {
        const past = new Date(p.dispo_from) <= new Date();
        return `<span class="pc-dispo ${past ? 'ok' : 'warn'}">Disponible dès le ${frDate(p.dispo_from)}</span>`;
      }
      return '<span class="pc-dispo off">Disponibilité à confirmer</span>';
    }
    function card(p) {
      const sel = state.selection.has(p.id);
      return `<article class="profile-card" data-id="${p.id}">
        <button class="sel-btn ${sel ? 'in' : ''}" data-sel="${p.id}" title="Ajouter à la sélection">${sel ? '✓' : '+'}</button>
        <div class="pc-head">
          ${p.photo_url ? `<img src="${esc(p.photo_url)}" alt="" loading="lazy" />` : `<span class="avatar-fallback">${esc((p.name ?? '?')[0])}</span>`}
          <div>
            <h3>${esc(p.name)}</h3>
            <p class="job">${esc(p.job ?? '')}</p>
          </div>
        </div>
        ${dispoPill(p)}
        <div class="pc-stats">
          ${tjmOf(p) ? `<span class="pc-tjm">${tjmOf(p)} €/j</span>` : ''}
          ${p.stars > 0 && p.stars <= 5 ? `<span class="pc-stars">★ ${p.stars}</span>` : ''}
          ${p.fluent_english ? '<span class="badge en">EN</span>' : ''}
        </div>
        <div class="pc-tags">
          ${p.experience ? `<span class="badge">${esc(p.experience)}</span>` : ''}
          ${p.dgitags_experience === 'Oui' ? '<span class="badge dg">digitags ✓</span>' : ''}
          ${p.salesforce ? '<span class="badge">Salesforce</span>' : ''}
          ${p.cdi ? '<span class="badge">Ouvert CDI</span>' : ''}
        </div>
      </article>`;
    }

    ['f-dispo', 'f-en', 'f-stars', 'f-cdi', 'f-dg', 'f-sf', 'f-site', 'f-incv'].forEach((id) => $(id).addEventListener('change', () => search(true)));
    $('f-q').addEventListener('input', () => { clearTimeout(deb); deb = setTimeout(() => search(true), 300); });
    $('btn-search').addEventListener('click', () => search(true));
    $('f-q').addEventListener('keydown', (e) => { if (e.key === 'Enter') search(true); });
    $('more').addEventListener('click', () => search(false));
    $('f-sort').addEventListener('change', () => { state.sort = $('f-sort').value; search(true); });
    $('btn-filters').addEventListener('click', () => $('filters-block').classList.toggle('open'));
    $('btn-propales').addEventListener('click', () => document.querySelector('[data-tab="propales"]').click());
    $('view-grid').addEventListener('click', () => setView('grid'));
    $('view-list').addEventListener('click', () => setView('list'));
    function setView(v) {
      $('results').classList.toggle('list', v === 'list');
      $('view-grid').classList.toggle('active', v === 'grid');
      $('view-list').classList.toggle('active', v === 'list');
    }
    $('f-reset').addEventListener('click', () => {
      $('f-q').value = '';
      ['f-dispo', 'f-en', 'f-stars', 'f-cdi', 'f-dg', 'f-sf', 'f-site', 'f-incv'].forEach((id) => { $(id).checked = false; });
      state.fGroups.clear(); state.fExps.clear(); state.fTjms.clear();
      msGroup?.update(); msExp?.update(); msTjm?.update();
      state.sort = 'pertinence'; $('f-sort').value = 'pertinence';
      onFilterChange();
    });

    // ---------- Sélection ----------
    $('results').addEventListener('click', async (e) => {
      const selBtn = e.target.closest('[data-sel]');
      if (selBtn) {
        const cardEl = selBtn.closest('.profile-card');
        toggleSelection({
          id: selBtn.dataset.sel,
          name: cardEl.querySelector('h3').textContent,
          job: cardEl.querySelector('.job').textContent,
        });
        return;
      }
      const cardEl = e.target.closest('.profile-card');
      if (cardEl) openProfile(cardEl.dataset.id);
    });

    function toggleSelection(p) {
      if (!$('prop-form').hidden) return; // sélection figée pendant la saisie d'une propale
      if (state.selection.has(p.id)) state.selection.delete(p.id);
      else state.selection.set(p.id, p);
      renderSelection();
    }

    // Les boutons (cartes et fiche ouverte) reflètent toujours l'état de la sélection,
    // au lieu d'être basculés à l'aveugle au clic.
    function syncSelButtons() {
      document.querySelectorAll('#results [data-sel]').forEach((b) => {
        const on = state.selection.has(b.dataset.sel);
        b.classList.toggle('in', on);
        b.textContent = on ? '✓' : '+';
      });
      const d = $('drawer-sel');
      if (d && drawerProfile) {
        const on = state.selection.has(drawerProfile.id);
        d.textContent = on ? '✓ Dans la sélection — retirer' : '+ Ajouter à la sélection';
        d.classList.toggle('btn-blue', !on);
        d.classList.toggle('btn-outline', on);
      }
    }

    function renderSelection() {
      saveSelection();
      syncSelButtons();
      const n = state.selection.size;
      $('sel-empty').hidden = n > 0;
      $('sel-create').hidden = n === 0;
      $('sel-create').textContent = n ? `Créer une propale (${n}) →` : 'Créer une propale →';
      $('sel-list').innerHTML = [...state.selection.values()]
        .map((s) => `<li><span>${esc(s.name)}</span><button data-rm="${esc(s.id)}" title="Retirer">×</button></li>`).join('');
    }
    $('sel-list').addEventListener('click', (e) => {
      const rm = e.target.closest('[data-rm]');
      if (!rm) return;
      state.selection.delete(rm.dataset.rm);
      renderSelection();
    });

    // ---------- Fiche profil ----------
    // Les documents privés (bucket docs-internes) sont stockés en chemin nu
    // « bucket/clé » : on génère une URL signée valable 1 h à l'ouverture.
    async function docUrl(value) {
      if (!value) return null;
      if (/^https?:/.test(value)) return value;
      const [bucket, ...rest] = value.split('/');
      const { data } = await sb.storage.from(bucket).createSignedUrl(rest.join('/'), 3600);
      return data?.signedUrl ?? null;
    }

    // Colonnes explicites : select('*') ramenait aussi cv_text (jusqu'à 50 000 caractères).
    const PROFILE_COLS = 'id, name, job, photo_url, tjm_free, tarif_jour, disponible, dispo_from, experience, stars, fluent_english, dgitags_experience, cdi, salesforce, email, reference_html, preferences_html, formation_html, notes_html, notes_tags_html, cv_url, cv_anonyme_url, portfolio_url, portfolio_pdf_url';
    let profileSeq = 0;
    let drawerProfile = null;

    async function openProfile(id) {
      const seq = ++profileSeq; // deux clics rapprochés : seule la dernière fiche s'affiche
      const { data: p, error } = await sb.from('profiles').select(PROFILE_COLS).eq('id', id).single();
      if (seq !== profileSeq) return;
      if (error) return toastErr('Erreur : ' + error.message);
      [p.cv_url, p.portfolio_pdf_url] = await Promise.all([docUrl(p.cv_url), docUrl(p.portfolio_pdf_url)]);
      if (seq !== profileSeq) return;
      drawerProfile = { id: p.id, name: p.name ?? '', job: p.job ?? '' };
      const d = $('drawer');
      d.innerHTML = `
        <button class="close" id="drawer-close" title="Fermer (Échap)">×</button>
        <div style="display:flex; gap:14px; align-items:center; margin-bottom:14px;">
          ${p.photo_url ? `<img src="${esc(p.photo_url)}" style="width:64px;height:64px;border-radius:12px;object-fit:cover;" alt="" />` : ''}
          <div><h2>${esc(p.name)}</h2><p class="job">${esc(p.job ?? '')}</p></div>
        </div>
        ${$('prop-form').hidden ? '<p style="margin-bottom:16px;"><button class="btn btn-blue btn-sm" id="drawer-sel"></button></p>' : ''}
        <section><div class="kv">
          <div><span>TJM freelance</span>${p.tjm_free ? p.tjm_free + ' €/j' : '—'}</div>
          <div><span>Tarif jour (vente)</span>${p.tarif_jour ? p.tarif_jour + ' €/j' : '—'}</div>
          <div><span>Disponibilité</span>${p.disponible ? 'Disponible' : (p.dispo_from ?? '—')}</div>
          <div><span>Expérience</span>${esc(p.experience ?? '—')}</div>
          <div><span>Note</span>${p.stars > 0 && p.stars <= 5 ? '★ ' + p.stars : '—'}</div>
          <div><span>Anglais courant</span>${p.fluent_english ? 'Oui' : 'Non'}</div>
          <div><span>Expérience digitags</span>${esc(p.dgitags_experience ?? '—')}</div>
          <div><span>Ouvert à un CDI</span>${p.cdi ? 'Oui' : 'Non'}</div>
          <div><span>Salesforce</span>${p.salesforce ? 'Oui' : 'Non'}</div>
          <div><span>Email</span>${esc(p.email ?? '—')}</div>
        </div></section>
        ${p.reference_html ? `<section><h4>Références</h4><div class="rich">${p.reference_html}</div></section>` : ''}
        ${p.preferences_html ? `<section><h4>Préférences</h4><div class="rich">${p.preferences_html}</div></section>` : ''}
        ${p.formation_html ? `<section><h4>Formation</h4><div class="rich">${p.formation_html}</div></section>` : ''}
        ${p.notes_html ? `<section><h4>Notes internes</h4><div class="rich">${p.notes_html}</div></section>` : ''}
        ${p.notes_tags_html ? `<section><h4>Tags</h4><div class="rich">${p.notes_tags_html}</div></section>` : ''}
        <section><h4>Documents</h4><div class="doc-links">
          ${p.cv_url ? `<a href="${esc(p.cv_url)}" target="_blank" rel="noopener">CV complet</a>` : ''}
          ${p.cv_anonyme_url ? `<a href="${esc(p.cv_anonyme_url)}" target="_blank" rel="noopener">CV anonymisé</a>` : ''}
          ${p.portfolio_url ? `<a href="${esc(p.portfolio_url)}" target="_blank" rel="noopener">Portfolio</a>` : ''}
          ${p.portfolio_pdf_url ? `<a href="${esc(p.portfolio_pdf_url)}" target="_blank" rel="noopener">Portfolio PDF</a>` : ''}
        </div></section>`;
      d.hidden = false;
      d.scrollTop = 0;
      syncSelButtons();
    }
    function closeProfile() {
      profileSeq++; // annule une fiche encore en cours de chargement
      drawerProfile = null;
      $('drawer').hidden = true;
    }
    $('drawer').addEventListener('click', (e) => {
      if (e.target.closest('#drawer-close')) closeProfile();
      else if (e.target.closest('#drawer-sel') && drawerProfile) toggleSelection(drawerProfile);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !$('drawer').hidden) closeProfile();
    });

    // ---------- Clients ----------
    async function loadClients() {
      const { data, error } = await sb.from('clients')
        .select('id, token, name, company, contact_name, contact_email, notes, created_at, archived, proposals(id, archived)')
        .order('name');
      if (error) { toastErr('Erreur clients : ' + error.message); return; }
      state.clients = (data ?? []).filter((c) => !c.archived);
      state.archivedClients = (data ?? []).filter((c) => c.archived);
      renderClients();
      // Synchronise le filtre de l'onglet Propales avec la liste des clients.
      const sel = $('props-client');
      sel.innerHTML = '<option value="">Tous les clients</option>'
        + state.clients.map((c) => `<option value="${c.id}">${esc(c.name)}</option>`).join('')
        + '<option value="none">Sans client</option>';
      sel.value = state.propFilter;
      if (sel.value !== state.propFilter) { state.propFilter = ''; sel.value = ''; }
    }

    function renderClients() {
      const arch = state.showArchClients;
      const list = arch ? state.archivedClients : state.clients;
      const n = list.length;
      $('clients-meta').textContent = `${n} client${n > 1 ? 's' : ''}${arch ? ` archivé${n > 1 ? 's' : ''}` : ''}`;
      $('clients-list').innerHTML = list.map((c) => {
        const nb = (c.proposals ?? []).filter((p) => !p.archived).length;
        const contact = [c.contact_name, c.contact_email].filter(Boolean).join(' · ');
        return `<div class="prop-row${arch ? ' is-archived' : ''}">
          <h3>${esc(c.name)}${c.company ? ` <span style="color:var(--ink-faint); font-weight:600;">· ${esc(c.company)}</span>` : ''}</h3>
          <span class="meta">${nb} propale${nb > 1 ? 's' : ''}${contact ? ` · ${esc(contact)}` : ''}${arch ? ' · archivé — espace client désactivé' : ''}</span>
          ${arch ? `<button class="btn btn-dark btn-sm" data-crest="${c.id}">Restaurer</button>` : `
          <button class="btn btn-outline btn-sm" data-cprops="${c.id}">Propales</button>
          ${c.token ? `<button class="btn btn-dark btn-sm" data-clink="${esc(c.token)}" title="Lien privé où le client retrouve toutes ses propales">Lien espace client</button>` : ''}
          <button class="btn btn-outline btn-sm" data-cedit="${c.id}">Modifier</button>
          <button class="btn btn-outline btn-sm" data-carch="${c.id}">Archiver</button>`}
        </div>`;
      }).join('') || (arch
        ? '<p style="color:var(--ink-faint);">Aucun client archivé.</p>'
        : '<p style="color:var(--ink-faint);">Aucun client pour l\'instant — créez votre première fiche avec « + Nouveau client ».</p>');
    }
    $('clients-arch').addEventListener('change', () => {
      state.showArchClients = $('clients-arch').checked;
      loadClients();
    });

    $('client-new').addEventListener('click', () => openClientForm(null));
    $('clients-list').addEventListener('click', async (e) => {
      const lk = e.target.closest('[data-clink]');
      if (lk) {
        try { await navigator.clipboard.writeText(`${location.origin}/c/${lk.dataset.clink}`); toast('Lien espace client copié ✓'); } catch {}
        return;
      }
      const ed = e.target.closest('[data-cedit]');
      if (ed) return openClientForm(state.clients.find((c) => c.id === ed.dataset.cedit));
      const pr = e.target.closest('[data-cprops]');
      if (pr) {
        state.propFilter = pr.dataset.cprops;
        $('props-client').value = state.propFilter;
        document.querySelector('[data-tab="propales"]').click();
        return;
      }
      const ar = e.target.closest('[data-carch]');
      if (ar) {
        const c = state.clients.find((x) => x.id === ar.dataset.carch);
        if (!confirm(`Archiver la fiche « ${c?.name} » ?\n\nLe lien de son espace client cessera de fonctionner tout de suite. Ses propales restent accessibles par leur lien direct. Vous pourrez restaurer la fiche depuis « Voir les archivés ».`)) return;
        await setArchived(ar, 'clients', ar.dataset.carch, true, 'Client archivé');
        return;
      }
      const rs = e.target.closest('[data-crest]');
      if (rs) await setArchived(rs, 'clients', rs.dataset.crest, false, 'Client restauré — son espace client fonctionne à nouveau ✓');
    });

    // Archivage / restauration (clients et propales) : une seule requête à la fois,
    // et un message clair si rien n'a été modifié.
    function setArchived(btn, table, id, archived, okMsg) {
      return busy(btn, async () => {
        const { data, error } = await sb.from(table).update({ archived }).eq('id', id).select('id');
        if (error || !data?.length) {
          toastErr(`${archived ? 'Archivage' : 'Restauration'} impossible : ${error?.message ?? 'aucune ligne modifiée'}`);
          return;
        }
        toast(okMsg);
        await loadClients();
        await loadProposals();
      });
    }

    function openClientForm(client) {
      const f = $('client-form');
      f.innerHTML = `
        <button class="close" id="cf-close">×</button>
        <h2 style="margin-bottom:16px;">${client ? 'Modifier le client' : 'Nouveau client'}</h2>
        <div class="field"><label>Nom *</label><input id="cf-name" placeholder="Acme" value="${esc(client?.name ?? '')}" /></div>
        <div class="field"><label>Société (raison sociale)</label><input id="cf-company" placeholder="Acme SAS" value="${esc(client?.company ?? '')}" /></div>
        <div class="field"><label>Contact</label><input id="cf-contact" placeholder="Jeanne Martin" value="${esc(client?.contact_name ?? '')}" /></div>
        <div class="field"><label>Email du contact</label><input id="cf-email" type="email" placeholder="jeanne@acme.fr" value="${esc(client?.contact_email ?? '')}" /></div>
        <div class="field"><label>Notes internes</label><textarea id="cf-notes" placeholder="Contexte, historique, points d'attention…">${esc(client?.notes ?? '')}</textarea></div>
        <button class="btn btn-dark" id="cf-save">${client ? 'Enregistrer' : 'Créer le client'}</button>
        <p id="cf-msg" style="font-size:13px; color:var(--ink-faint); margin-top:10px;"></p>`;
      openForm(f);
      $('cf-close').addEventListener('click', () => closeForm(f));
      $('cf-save').addEventListener('click', () => busy($('cf-save'), async () => {
        const name = $('cf-name').value.trim();
        if (!name) { $('cf-msg').textContent = 'Le nom est requis.'; return; }
        const row = {
          name,
          company: $('cf-company').value.trim() || null,
          contact_name: $('cf-contact').value.trim() || null,
          contact_email: $('cf-email').value.trim() || null,
          notes: $('cf-notes').value.trim() || null,
        };
        let error;
        if (client) ({ error } = await sb.from('clients').update(row).eq('id', client.id));
        else {
          const { data: { user } } = await sb.auth.getUser();
          ({ error } = await sb.from('clients').insert({ ...row, created_by: user?.email }));
        }
        if (error) { $('cf-msg').textContent = 'Erreur : ' + error.message; return; }
        closeForm(f);
        toast(client ? 'Client mis à jour ✓' : 'Client créé ✓');
        loadClients().then(loadProposals);
      }));
    }

    // ---------- Propales ----------
    document.querySelectorAll('.tool-tab').forEach((t) => t.addEventListener('click', () => {
      document.querySelectorAll('.tool-tab').forEach((x) => x.classList.remove('active'));
      t.classList.add('active');
      $('tab-recherche').hidden = t.dataset.tab !== 'recherche';
      $('tab-clients').hidden = t.dataset.tab !== 'clients';
      $('tab-propales').hidden = t.dataset.tab !== 'propales';
      if (t.dataset.tab === 'propales') loadProposals();
      if (t.dataset.tab === 'clients') loadClients();
    }));

    $('props-client').addEventListener('change', () => {
      state.propFilter = $('props-client').value;
      loadProposals();
    });
    $('props-arch').addEventListener('change', () => {
      state.showArchProps = $('props-arch').checked;
      loadProposals();
    });

    // ---------- Formulaire de propale : création ET modification ----------
    // formCtx.prop : la propale en cours de modification (null en création).
    // formCtx.lines : les profils du formulaire ; formCtx.removed : lignes à supprimer à l'enregistrement.
    let formCtx = null;

    $('sel-create').addEventListener('click', () => busy($('sel-create'), () => openPropForm(null)));

    async function openPropForm(editId) {
      const f = $('prop-form');
      let prop = null;
      let lines;
      if (editId) {
        const { data, error } = await sb.from('proposals')
          .select('id, token, title, client_id, intro, start_date, password, proposal_items(id, profile_id, role_label, tjm, days_week, sort, profiles(name, job))')
          .eq('id', editId).single();
        if (error) return toastErr('Propale non chargée : ' + error.message);
        prop = data;
        lines = [...(prop.proposal_items ?? [])].sort((x, y) => (x.sort ?? 0) - (y.sort ?? 0)).map((it) => ({
          itemId: it.id, profileId: it.profile_id, isNew: false,
          name: it.profiles?.name ?? 'Profil', job: it.profiles?.job ?? '',
          role: it.role_label ?? '', tjm: Number(it.tjm) > 0 ? Number(it.tjm) : '', days: clampDays(it.days_week) ?? 10,
        }));
        // Les profils de la sélection en cours (absents de la propale) sont proposés en ajout.
        const known = new Set(lines.map((l) => l.profileId));
        [...state.selection.values()].filter((sel) => !known.has(sel.id)).forEach((sel) => lines.push({
          itemId: crypto.randomUUID(), profileId: sel.id, isNew: true, name: sel.name, job: sel.job, role: '', tjm: '', days: 10,
        }));
      } else {
        lines = [...state.selection.values()].map((sel) => ({
          itemId: null, profileId: sel.id, isNew: true, name: sel.name, job: sel.job, role: '', tjm: '', days: 10,
        }));
      }
      if (!lines.length) return;
      const { data: tjms, error: tjmErr } = await sb.from('profiles').select('id, tjm_free, tarif_jour').in('id', lines.map((l) => l.profileId));
      if (tjmErr) toastErr('TJM des profils non chargés : ' + tjmErr.message);
      const tjmMap = new Map((tjms ?? []).map((p) => [p.id, tjmOf(p)]));
      formCtx = { prop, lines, removed: [] };
      // Une propale rattachée à un client archivé garde son client à l'enregistrement.
      const archClient = prop?.client_id && !state.clients.some((c) => c.id === prop.client_id)
        ? state.archivedClients.find((c) => c.id === prop.client_id) : null;
      f.innerHTML = `
        <button class="close" id="prop-close">×</button>
        <h2 style="margin-bottom:16px;">${prop ? 'Modifier la propale' : 'Nouvelle propale'}</h2>
        ${prop ? '<p class="np-hint">Le lien envoyé au client ne change pas : il verra la version modifiée dès l\'enregistrement.</p>' : ''}
        <div class="field"><label>Titre du projet *</label><input id="np-title" placeholder="Refonte e-commerce — Acme" value="${esc(prop?.title ?? '')}" /></div>
        <div class="field"><label>Client</label>
          <div style="display:flex; gap:8px;">
            <select id="np-client" style="flex:1;">
              <option value="">— Aucun client —</option>
              ${state.clients.map((c) => `<option value="${c.id}"${c.id === prop?.client_id ? ' selected' : ''}>${esc(c.name)}</option>`).join('')}
              ${archClient ? `<option value="${archClient.id}" selected>${esc(archClient.name)} (archivé)</option>` : ''}
            </select>
            <button type="button" class="btn btn-outline btn-sm" id="np-client-new">+ Nouveau</button>
          </div>
          <div id="np-client-inline" style="display:none; gap:8px; margin-top:8px;">
            <input id="np-client-name" placeholder="Nom du nouveau client (ex. Acme)" style="flex:1;" />
            <button type="button" class="btn btn-dark btn-sm" id="np-client-create">Créer</button>
          </div>
        </div>
        <div class="field"><label>Introduction (visible par le prospect)</label><textarea id="np-intro" placeholder="Suite à nos échanges, voici l'équipe que nous vous proposons…">${esc(prop?.intro ?? '')}</textarea></div>
        <div style="display:flex; gap:14px; flex-wrap:wrap;">
          <div class="field" style="max-width: 160px;">
            <label>Marge digitags (%)</label>
            <input id="np-marge" type="number" value="20" min="0" step="5" ${prop ? 'title="Ne recalcule que les TJM laissés vides ou les profils ajoutés"' : ''} />
          </div>
          <div class="field" style="max-width: 180px;">
            <label>Démarrage prévu</label>
            <input id="np-start" type="date" value="${prop ? esc(prop.start_date ?? '') : new Date(Date.now() + 14 * 864e5).toISOString().slice(0, 10)}" />
          </div>
          <div class="field" style="max-width: 190px;">
            <label>Mot de passe client</label>
            <input id="np-password" type="text" value="${prop ? esc(prop.password ?? '') : genPassword()}" autocomplete="off" title="Demandé au client pour ouvrir la propale — vider pour un accès libre" />
          </div>
        </div>
        <h4 style="margin: 10px 0;">Profils &amp; rôles — TJM client = TJM freelance + marge</h4>
        ${prop ? '<p class="np-hint">Pour ajouter un profil : fermez ce formulaire, ajoutez-le à la sélection (+) depuis la Recherche, puis rouvrez « Modifier ».</p>' : ''}
        ${lines.map((l, i) => `
          <div class="field" data-np-item="${esc(l.profileId)}" data-np-i="${i}" data-np-base="${tjmMap.get(l.profileId) ?? ''}"${prop && !l.isNew ? ' data-np-old="1"' : ''}>
            <label for="np-role-${i}"><button type="button" class="np-open" data-np-open="${esc(l.profileId)}" title="Ouvrir la fiche du profil">${esc(l.name)}</button>${tjmMap.get(l.profileId) ? ` <span style="color:var(--ink-faint); font-weight:600;">(TJM freelance : ${tjmMap.get(l.profileId)} €)</span>` : ''}${prop && l.isNew ? ' <span class="np-new">ajouté</span>' : ''} — rôle, TJM client &amp; nombre de jours</label>
            <div style="display:flex; gap:8px;">
              <input class="np-role" id="np-role-${i}" value="${esc(l.role)}" placeholder="${esc(l.job || 'Rôle (facultatif)')}" style="flex:1;" />
              <input class="np-tjm" type="number" min="0" step="5" value="${esc(l.tjm)}"${l.tjm !== '' ? ' data-dirty="1"' : ''} placeholder="TJM €" title="TJM facturé au client — vide = « sur devis » côté client" style="width:100px;" />
              <input class="np-days" type="number" value="${esc(l.days)}" min="0.5" max="365" step="0.5" title="Nombre de jours sur la mission (0,5 à 365)" style="width:80px;" />
              ${prop ? `<button type="button" class="np-rm" data-np-rm="${i}" title="Retirer ce profil de la propale">×</button>` : ''}
            </div>
          </div>`).join('')}
        <p id="np-warn" class="np-warn" hidden></p>
        <button class="btn btn-dark" id="np-save">${prop ? 'Enregistrer les modifications' : 'Créer la propale'}</button>
        <p id="np-msg" style="font-size:13px; color:var(--ink-faint); margin-top:10px;"></p>`;
      openForm(f);
      f.scrollTop = 0;
      $('prop-close').addEventListener('click', () => closeForm(f));
      $('np-save').addEventListener('click', () => busy($('np-save'), saveProposal));
      // La fiche d'un profil s'ouvre par-dessus le formulaire (sans toucher à la sélection).
      f.querySelectorAll('[data-np-open]').forEach((b) => b.addEventListener('click', () => openProfile(b.dataset.npOpen)));
      // Création rapide d'un client sans quitter le formulaire de propale.
      $('np-client-new').addEventListener('click', () => {
        const inline = $('np-client-inline');
        inline.style.display = inline.style.display === 'none' ? 'flex' : 'none';
        if (inline.style.display === 'flex') $('np-client-name').focus();
      });
      $('np-client-create').addEventListener('click', () => busy($('np-client-create'), async () => {
        const name = $('np-client-name').value.trim();
        if (!name) return;
        const { data: { user } } = await sb.auth.getUser();
        const { data: c, error } = await sb.from('clients').insert({ name, created_by: user?.email }).select().single();
        if (error) return toastErr('Erreur : ' + error.message);
        state.clients.push({ ...c, proposals: [] });
        state.clients.sort((a, b) => a.name.localeCompare(b.name, 'fr'));
        $('np-client').insertAdjacentHTML('beforeend', `<option value="${c.id}">${esc(c.name)}</option>`);
        $('np-client').value = c.id;
        $('np-client-name').value = '';
        $('np-client-inline').style.display = 'none';
        toast('Client créé ✓');
        loadClients();
      }));
      // Un TJM vide n'est pas bloquant mais doit se voir : côté client la ligne
      // passe « sur devis » et sort du budget estimé.
      const warnTjm = () => {
        const names = [];
        f.querySelectorAll('[data-np-item]').forEach((el) => {
          const missing = !(Number(el.querySelector('.np-tjm').value) > 0);
          el.classList.toggle('np-missing', missing);
          if (missing) names.push(lines[Number(el.dataset.npI)]?.name ?? '?');
        });
        const w = $('np-warn');
        w.hidden = names.length === 0;
        w.textContent = names.length
          ? `⚠ TJM client manquant pour ${names.join(', ')} : côté client, ${names.length > 1 ? 'ces profils seront affichés' : 'ce profil sera affiché'} « sur devis » et ne comptera pas dans le budget estimé.`
          : '';
      };
      // TJM client auto-calculé depuis la marge ; la saisie manuelle fige le champ,
      // le vider le rend à nouveau au calcul automatique. À l'ouverture d'une propale
      // existante (initial), ses lignes ne sont pas touchées : un TJM laissé vide le reste.
      const applyMarge = (initial) => {
        const m = Math.max(0, Number($('np-marge').value) || 0);
        f.querySelectorAll('[data-np-item]').forEach((el) => {
          if (initial === true && el.dataset.npOld) return;
          const base = Number(el.dataset.npBase);
          const input = el.querySelector('.np-tjm');
          if (base > 0 && !input.dataset.dirty) input.value = tjmClient(base, m);
        });
        warnTjm();
      };
      $('np-marge').addEventListener('input', applyMarge);
      f.querySelectorAll('.np-tjm').forEach((i) => i.addEventListener('input', () => {
        if (i.value.trim() === '') delete i.dataset.dirty;
        else i.dataset.dirty = '1';
        warnTjm();
      }));
      // Jours : la valeur affichée est celle qui sera enregistrée (0,5 à 365).
      f.querySelectorAll('.np-days').forEach((i) => i.addEventListener('change', () => { i.value = clampDays(i.value) ?? 10; }));
      // Modification : retirer un profil (effectif à l'enregistrement seulement).
      f.querySelectorAll('[data-np-rm]').forEach((b) => b.addEventListener('click', () => {
        if (f.querySelectorAll('[data-np-item]').length <= 1) {
          $('np-msg').textContent = 'Une propale garde au moins un profil — archivez-la si elle n\'a plus lieu d\'être.';
          return;
        }
        const l = lines[Number(b.dataset.npRm)];
        if (!l.isNew) formCtx.removed.push(l.itemId);
        b.closest('[data-np-item]').remove();
        warnTjm();
      }));
      applyMarge(true);
    }

    async function saveProposal() {
      const msg = $('np-msg');
      const { prop, lines, removed } = formCtx;
      const title = $('np-title').value.trim();
      if (!title) { msg.textContent = 'Le titre est requis.'; return; }
      const rows = [...document.querySelectorAll('#prop-form [data-np-item]')].map((el, i) => {
        const l = lines[Number(el.dataset.npI)];
        const tjm = Number(el.querySelector('.np-tjm').value);
        return {
          name: l.name,
          itemId: l.itemId,
          isNew: l.isNew,
          item: {
            profile_id: l.profileId,
            // Rôle vide : le métier du profil, sinon rien (jamais le texte indicatif du champ).
            role_label: el.querySelector('.np-role').value.trim() || l.job?.trim() || null,
            tjm: tjm > 0 ? tjm : null,
            // days_week stocke désormais le nombre TOTAL de jours du consultant sur la mission.
            days_week: clampDays(el.querySelector('.np-days').value) ?? 10,
            sort: i,
          },
        };
      });
      if (!rows.length) { msg.textContent = 'Aucun profil dans la propale.'; return; }
      const missing = rows.filter((r) => r.item.tjm === null).map((r) => r.name);
      if (missing.length && !confirm(`TJM client manquant pour : ${missing.join(', ')}.\n\nCôté client, ${missing.length > 1 ? 'ces profils seront affichés' : 'ce profil sera affiché'} « sur devis » et ne comptera pas dans le budget estimé.\n\n${prop ? 'Enregistrer' : 'Créer la propale'} quand même ?`)) {
        msg.textContent = `${prop ? 'Enregistrement annulé' : 'Création annulée'} — complétez les TJM manquants.`;
        return;
      }
      const pw = $('np-password').value.trim();
      const fields = {
        title,
        client_id: $('np-client').value || null,
        intro: $('np-intro').value.trim() || null,
        start_date: $('np-start').value || null,
        password: pw || null,
      };
      if (prop) return updateProposal(prop, fields, rows, removed, msg);

      msg.textContent = 'Création en cours…';
      const { data: { user } } = await sb.auth.getUser();
      const { data: created, error } = await sb.from('proposals')
        .insert({ ...fields, created_by: user?.email })
        .select().single();
      if (error) { msg.textContent = 'Erreur : ' + error.message; return; }
      const { error: e2 } = await sb.from('proposal_items').insert(rows.map((r) => ({ ...r.item, proposal_id: created.id })));
      if (e2) {
        // Pas de transaction côté navigateur : on retire la propale restée sans profils.
        const { data: del, error: e3 } = await sb.from('proposals').delete().eq('id', created.id).select('id');
        msg.textContent = 'Erreur à l\'enregistrement des profils : ' + e2.message
          + (e3 || !del?.length
            ? ` — une propale vide « ${title} » est restée en base : archivez-la depuis l'onglet Propales avant de réessayer.`
            : ' — rien n\'a été créé, vous pouvez réessayer.');
        return;
      }
      closeForm($('prop-form'));
      state.selection.clear();
      renderSelection(); // remet aussi les boutons ✓ des cartes à « + »
      // La nouvelle propale doit être visible : filtres de l'onglet Propales remis à zéro.
      state.propFilter = ''; $('props-client').value = '';
      state.showArchProps = false; $('props-arch').checked = false;
      const share = `${location.origin}/p/${created.token}${pw ? ` — mot de passe : ${pw}` : ''}`;
      try { await navigator.clipboard.writeText(share); toast(pw ? 'Propale créée — lien + mot de passe copiés ✓' : 'Propale créée — lien copié ✓'); }
      catch { toast('Propale créée'); }
      document.querySelector('[data-tab="propales"]').click(); // recharge la liste
      loadClients(); // compteurs de propales par client
    }

    // Modification d'une propale existante. Trois requêtes, chacune atomique et rejouable :
    // 1) toutes les lignes en un seul upsert (les lignes ajoutées ont déjà leur identifiant),
    // 2) suppression des profils retirés, 3) champs de la propale. En cas d'échec, le
    // formulaire reste ouvert : recliquer sur « Enregistrer » reprend sans créer de doublon.
    async function updateProposal(prop, fields, rows, removed, msg) {
      msg.textContent = 'Enregistrement…';
      const { error: e1 } = await sb.from('proposal_items')
        .upsert(rows.map((r) => ({ id: r.itemId, proposal_id: prop.id, ...r.item })));
      if (e1) { msg.textContent = 'Erreur : rien n\'a été modifié — ' + e1.message; return; }
      if (removed.length) {
        const { error: e2 } = await sb.from('proposal_items').delete().in('id', removed).eq('proposal_id', prop.id);
        if (e2) { msg.textContent = `Profils enregistrés, mais ${removed.length > 1 ? 'les profils retirés sont' : 'le profil retiré est'} toujours dans la propale (${e2.message}). Recliquez sur « Enregistrer ».`; return; }
      }
      const { data: up, error: e3 } = await sb.from('proposals').update(fields).eq('id', prop.id).select('id');
      if (e3 || !up?.length) { msg.textContent = `Profils enregistrés, mais titre, client, dates et mot de passe n'ont pas été modifiés (${e3?.message ?? 'aucune ligne modifiée'}). Recliquez sur « Enregistrer ».`; return; }
      closeForm($('prop-form'));
      // Les profils ajoutés venaient de la sélection : elle a servi, on la vide.
      if (rows.some((r) => r.isNew)) { state.selection.clear(); renderSelection(); }
      toast((fields.password ?? '') !== (prop.password ?? '')
        ? 'Propale mise à jour ✓ — même lien, pensez à transmettre le nouveau mot de passe'
        : 'Propale mise à jour ✓ — le lien client ne change pas', 5000);
      await loadProposals();
      loadClients();
    }

    const propRow = (p) => `
        <div class="prop-row${state.showArchProps ? ' is-archived' : ''}">
          <h3>${esc(p.title)}</h3>
          <span class="meta">${p.proposal_items.length} profil${p.proposal_items.length > 1 ? 's' : ''} · ${new Date(p.created_at).toLocaleDateString('fr-FR')} · ${esc(p.created_by ?? '')} · ${state.showArchProps ? 'archivée — lien client désactivé' : (p.password ? `🔒 ${esc(p.password)}` : 'accès libre')}</span>
          ${state.showArchProps ? `<button class="btn btn-dark btn-sm" data-rest="${p.id}">Restaurer</button>` : `
          <a class="btn btn-outline btn-sm" href="/p/${esc(p.token)}" target="_blank" rel="noopener">Voir</a>
          <button class="btn btn-dark btn-sm" data-copy="${esc(p.token)}" data-pw="${esc(p.password ?? '')}">Copier le lien</button>
          <button class="btn btn-outline btn-sm" data-edit="${p.id}" title="Modifier titre, TJM, jours, rôles ou profils — le lien client ne change pas">Modifier</button>
          <button class="btn btn-outline btn-sm" data-arch="${p.id}">Archiver</button>`}
        </div>`;

    let propSeq = 0;
    async function loadProposals() {
      const seq = ++propSeq;
      let q = sb.from('proposals')
        .select('id, token, title, client_name, client_id, created_at, created_by, password, proposal_items(id), clients(name)')
        .eq('archived', state.showArchProps)
        .order('created_at', { ascending: false });
      if (state.propFilter === 'none') q = q.is('client_id', null);
      else if (state.propFilter) q = q.eq('client_id', state.propFilter);
      const { data, error } = await q;
      if (seq !== propSeq) return;
      if (error) {
        $('props-list').innerHTML = `<p style="color:var(--ink-faint);">Propales non chargées : ${esc(error.message)}</p>`;
        return;
      }
      // Propales groupées par client (anciennes propales : client_name texte libre).
      const groups = new Map();
      (data ?? []).forEach((p) => {
        const label = p.clients?.name || p.client_name || 'Sans client';
        if (!groups.has(label)) groups.set(label, []);
        groups.get(label).push(p);
      });
      const labels = [...groups.keys()].sort((a, b) =>
        (a === 'Sans client') - (b === 'Sans client') || a.localeCompare(b, 'fr'));
      $('props-list').innerHTML = labels.map((label) =>
        `<h2 class="props-group">${esc(label)} <span>· ${groups.get(label).length}</span></h2>`
        + groups.get(label).map(propRow).join('')
      ).join('') || (state.showArchProps
        ? '<p style="color:var(--ink-faint);">Aucune propale archivée.</p>'
        : state.propFilter
          ? '<p style="color:var(--ink-faint);">Aucune propale pour ce client — composez une sélection depuis l\'onglet Recherche.</p>'
          : '<p style="color:var(--ink-faint);">Aucune propale pour l\'instant — composez une sélection depuis l\'onglet Recherche.</p>');
    }

    $('props-list').addEventListener('click', async (e) => {
      const cp = e.target.closest('[data-copy]');
      if (cp) {
        const share = `${location.origin}/p/${cp.dataset.copy}${cp.dataset.pw ? ` — mot de passe : ${cp.dataset.pw}` : ''}`;
        try { await navigator.clipboard.writeText(share); toast('Lien copié ✓'); } catch {}
        return;
      }
      const ed = e.target.closest('[data-edit]');
      if (ed) { await busy(ed, () => openPropForm(ed.dataset.edit)); return; }
      const ar = e.target.closest('[data-arch]');
      if (ar) {
        const title = ar.closest('.prop-row').querySelector('h3').textContent;
        if (!confirm(`Archiver la propale « ${title} » ?\n\nLe lien envoyé au client cessera de fonctionner tout de suite. Vous pourrez la restaurer depuis « Voir les archivées ».`)) return;
        await setArchived(ar, 'proposals', ar.dataset.arch, true, 'Propale archivée — lien client désactivé');
        return;
      }
      const rs = e.target.closest('[data-rest]');
      if (rs) await setArchived(rs, 'proposals', rs.dataset.rest, false, 'Propale restaurée — le lien client fonctionne à nouveau ✓');
    });

    init();
  </script>
</Base>
