---
import Base from '../layouts/Base.astro';
---
<Base title="Talents — outil interne | digitags.work" description="Outil interne de recherche dans la base de talents du Hub.">
  <noscript><p class="container" style="padding: 40px 0;">Cet outil nécessite JavaScript.</p></noscript>

  <!-- Écran de connexion -->
  <div id="login" class="tool-login" hidden>
    <p class="eyebrow">Outil interne</p>
    <h1 style="font-size: 26px; font-weight: 800; margin-bottom: 18px;">Talents du Hub</h1>
    <div class="form-card">
      <button class="btn btn-dark" id="login-google" style="width: 100%; margin-bottom: 18px;">Se connecter avec Google</button>
      <p style="text-align:center; font-size: 12px; color: var(--ink-faint); margin-bottom: 16px;">— ou par email —</p>
      <div id="login-step1">
        <div class="field">
          <label for="login-email">Email professionnel</label>
          <input type="email" id="login-email" placeholder="prenom@donutz.fr" autocomplete="email" />
        </div>
        <button class="btn btn-dark" id="login-send">Recevoir mon lien de connexion</button>
      </div>
      <div id="login-step2" hidden>
        <div class="field">
          <label for="login-code">Code (si présent dans l'email)</label>
          <input type="text" id="login-code" inputmode="numeric" placeholder="123456" />
        </div>
        <button class="btn btn-dark" id="login-verify">Se connecter</button>
      </div>
      <p id="login-msg" style="font-size: 13px; color: var(--ink-faint); margin-top: 12px;"></p>
    </div>
  </div>

  <!-- App -->
  <div id="app" class="tool" hidden>
    <div class="tool-bar">
      <div class="tool-tabs">
        <button class="tool-tab active" data-tab="recherche">Recherche</button>
        <button class="tool-tab" data-tab="propales">Propales</button>
      </div>
      <button class="btn btn-outline btn-sm" id="logout">Déconnexion</button>
    </div>

    <div class="tool-hero">
      <div>
        <h1>Talents <span>du Hub</span></h1>
        <p class="th-lead">Trouvez les meilleurs freelances pour vos projets digitaux.</p>
        <ul class="th-badges">
          <li><span class="th-dot th-dot-green">✓</span> Profils vérifiés</li>
          <li><span class="th-dot th-dot-yellow">◷</span> Disponibilités à jour</li>
          <li><span class="th-dot th-dot-red">⌕</span> Recherche dans les CV</li>
        </ul>
      </div>
      <div class="th-illu" aria-hidden="true">
        <div class="th-card th-c1"><span class="th-ava a1"></span><em>UX/UI</em></div>
        <div class="th-card th-c2"><span class="th-ava a2"></span><em>Data</em></div>
        <div class="th-card th-c3"><span class="th-ava a3"></span><em>Marketing</em></div>
      </div>
    </div>

    <div id="tab-recherche">
      <div class="search-panel">
        <div class="search-row">
          <div class="search-box">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
            <input type="search" id="f-q" placeholder="Rechercher un nom, une compétence, un outil…" />
          </div>
          <button class="btn btn-blue" id="btn-search">Recherche</button>
          <button class="btn btn-outline" id="btn-propales">Propales</button>
          <button class="btn btn-outline" id="btn-filters">Filtres</button>
        </div>
        <div class="filters" id="filters-block">
          <label class="chk" title="Recherche plein-texte dans le contenu des CV"><input type="checkbox" id="f-incv" /> Dans les CV</label>
          <div class="ms" id="ms-group"></div>
          <div class="ms" id="ms-exp"></div>
          <div class="ms" id="ms-tjm"></div>
          <label class="chk"><input type="checkbox" id="f-dispo" /> <span class="avail-dot"></span> Disponibles</label>
          <label class="chk"><input type="checkbox" id="f-en" /> Anglais courant</label>
          <label class="chk"><input type="checkbox" id="f-stars" /> ★ 4+</label>
          <label class="chk"><input type="checkbox" id="f-cdi" /> Ouvert CDI</label>
          <label class="chk"><input type="checkbox" id="f-dg" /> Déjà avec digitags</label>
          <label class="chk"><input type="checkbox" id="f-sf" /> Salesforce</label>
          <label class="chk"><input type="checkbox" id="f-site" /> Visible sur le site</label>
          <button class="f-reset" id="f-reset" type="button">↺ Réinitialiser</button>
        </div>
      </div>

      <div class="tool-layout">
        <div>
          <div class="results-head">
            <p class="results-meta" id="results-meta"></p>
            <div class="results-tools">
              <label for="f-sort">Trier par</label>
              <select id="f-sort">
                <option value="pertinence">Pertinence</option>
                <option value="tjm-asc">TJM croissant</option>
                <option value="tjm-desc">TJM décroissant</option>
                <option value="dispo">Disponibilité</option>
                <option value="nom">Nom A–Z</option>
              </select>
              <div class="view-toggle" role="group" aria-label="Affichage">
                <button id="view-grid" class="active" title="Vue grille" aria-label="Vue grille">▦</button>
                <button id="view-list" title="Vue liste" aria-label="Vue liste">☰</button>
              </div>
            </div>
          </div>
          <div class="profiles-grid" id="results"></div>
          <p style="margin-top: 14px;"><button class="btn btn-outline btn-sm" id="more" hidden>Charger plus</button></p>
        </div>

        <aside class="tool-side">
          <div class="side-card side-navy" id="sel-panel">
            <span class="side-spark">✦</span>
            <h2>Besoin d'un profil spécifique&nbsp;?</h2>
            <p class="empty" id="sel-empty">Ajoutez des profils avec le bouton «&nbsp;+&nbsp;» des cartes pour composer une propale.</p>
            <ul id="sel-list"></ul>
            <button class="btn btn-yellow btn-sm" id="sel-create" hidden>Créer une propale →</button>
          </div>
          <div class="side-card">
            <h3><span class="side-bolt">⚡</span> Filtres rapides</h3>
            <div class="quick-chips" id="quick-groups"></div>
            <a class="side-link" href="/metiers" target="_blank" rel="noopener">Voir tous les métiers →</a>
          </div>
          <div class="side-card">
            <h3>Vous êtes freelance&nbsp;?</h3>
            <p class="side-text">Rejoignez le Hub et accédez à des missions de qualité.</p>
            <a href="/devenir-freelance" class="btn btn-dark btn-sm">Rejoindre digitags</a>
          </div>
        </aside>
      </div>
    </div>

    <div id="tab-propales" hidden>
      <div class="props-list" id="props-list"></div>
    </div>
  </div>

  <!-- Fiche profil -->
  <div id="drawer" class="drawer" hidden></div>

  <!-- Formulaire propale -->
  <div id="prop-form" class="drawer" hidden></div>

  <div id="toast" class="toast" hidden></div>

  <script>
    import { createClient } from '@supabase/supabase-js';

    const URL_ = import.meta.env.PUBLIC_SUPABASE_URL;
    const KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
    const $ = (id) => document.getElementById(id);
    const esc = (s) => String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));

    if (!URL_ || !KEY) {
      document.body.insertAdjacentHTML('afterbegin', '<p class="container" style="padding:40px 24px;font-weight:700;">Configuration Supabase manquante (PUBLIC_SUPABASE_URL / PUBLIC_SUPABASE_ANON_KEY).</p>');
      throw new Error('missing supabase config');
    }
    const sb = createClient(URL_, KEY);

    const PAGE = 30;
    let state = { page: 0, selection: new Map(), groups: [], lastCount: 0, fGroups: new Set(), fExps: new Set(), fTjms: new Set(), sort: 'pertinence' };

    const toast = (msg) => { const t = $('toast'); t.textContent = msg; t.hidden = false; setTimeout(() => (t.hidden = true), 2600); };

    // Menu déroulant à sélection multiple. Retourne { update } pour rafraîchir
    // le libellé (et l'état des cases) quand le Set est modifié ailleurs.
    function makeMulti(root, label, items, set) {
      root.innerHTML = '';
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'ms-btn';
      const panel = document.createElement('div');
      panel.className = 'ms-panel';
      panel.hidden = true;
      const boxes = [];
      const update = () => {
        btn.textContent = set.size ? label + ' (' + set.size + ')' : label + ' — tous';
        boxes.forEach(({ cb, v }) => { cb.checked = set.has(v); });
      };
      items.forEach(({ v, t }) => {
        const l = document.createElement('label');
        const cb = document.createElement('input');
        cb.type = 'checkbox';
        cb.checked = set.has(v);
        cb.addEventListener('change', () => { cb.checked ? set.add(v) : set.delete(v); update(); onFilterChange(); });
        boxes.push({ cb, v });
        l.append(cb, document.createTextNode(' ' + t));
        panel.append(l);
      });
      btn.addEventListener('click', () => { panel.hidden = !panel.hidden; });
      root.append(btn, panel);
      update();
      return { update };
    }
    document.addEventListener('click', (e) => {
      document.querySelectorAll('.ms-panel').forEach((p) => {
        if (!p.parentElement.contains(e.target)) p.hidden = true;
      });
    });

    // ---------- Auth ----------
    let started = false;
    sb.auth.onAuthStateChange((event) => {
      if (event === 'SIGNED_IN' && !started) {
        $('login').hidden = true;
        start();
      }
    });
    async function init() {
      const { data: { session } } = await sb.auth.getSession();
      if (session) return start();
      $('login').hidden = false;
    }

    $('login-google').addEventListener('click', async () => {
      $('login-msg').textContent = 'Redirection vers Google…';
      const { error } = await sb.auth.signInWithOAuth({
        provider: 'google',
        options: { redirectTo: location.origin + '/talents' },
      });
      if (error) $('login-msg').textContent = 'Erreur : ' + error.message;
    });

    $('login-send').addEventListener('click', async () => {
      const email = $('login-email').value.trim();
      if (!email) return;
      $('login-msg').textContent = 'Envoi du code…';
      const { error } = await sb.auth.signInWithOtp({ email, options: { shouldCreateUser: true, emailRedirectTo: location.origin + '/talents' } });
      if (error) { $('login-msg').textContent = 'Erreur : ' + error.message; return; }
      $('login-step1').hidden = true;
      $('login-step2').hidden = false;
      $('login-msg').textContent = 'Email envoyé à ' + email + ' — cliquez le lien de connexion qu\'il contient (depuis cet appareil). Si l\'email affiche un code, vous pouvez aussi le saisir ci-dessus.';
    });

    $('login-verify').addEventListener('click', async () => {
      const email = $('login-email').value.trim();
      const token = $('login-code').value.trim();
      const { error } = await sb.auth.verifyOtp({ email, token, type: 'email' });
      if (error) { $('login-msg').textContent = 'Code invalide : ' + error.message; return; }
      $('login').hidden = true;
      start();
    });

    $('logout').addEventListener('click', async () => { await sb.auth.signOut(); location.reload(); });

    // ---------- App ----------
    let msGroup, msExp, msTjm;
    function onFilterChange() { renderQuickChips(); search(true); }

    async function start() {
      if (started) return;
      started = true;
      history.replaceState(null, '', location.pathname);
      $('app').hidden = false;
      const { data: groups, error } = await sb.from('job_groups').select('id, name').order('sort');
      if (error || !groups?.length) {
        // RLS : utilisateur connecté mais pas membre de l'équipe → aucune donnée.
        if (error || groups.length === 0) {
          const { count } = await sb.from('profiles').select('id', { count: 'exact', head: true });
          if (!count) {
            $('app').innerHTML = '<p style="padding:40px;font-weight:700;">Accès non autorisé : votre email n\'est pas dans la liste de l\'équipe (table team_members), ou la base est vide.</p>';
            return;
          }
        }
      }
      state.groups = groups ?? [];
      msGroup = makeMulti($('ms-group'), 'Familles', state.groups.map((g) => ({ v: g.id, t: g.name })), state.fGroups);
      const { data: exps } = await sb.from('profiles').select('experience').not('experience', 'is', null).limit(1000);
      const expList = [...new Set((exps ?? []).map((e) => e.experience))].sort();
      msExp = makeMulti($('ms-exp'), 'Expérience', expList.map((e) => ({ v: e, t: e })), state.fExps);
      msTjm = makeMulti($('ms-tjm'), 'TJM', [
        { v: '0-400', t: '< 400 €' },
        { v: '400-600', t: '400 – 600 €' },
        { v: '600-800', t: '600 – 800 €' },
        { v: '800-99999', t: '> 800 €' },
      ], state.fTjms);
      renderQuickChips();
      search(true);
      loadProposals();
    }

    // Raccourcis familles dans la colonne de droite, synchronisés avec le filtre.
    function renderQuickChips() {
      const host = $('quick-groups');
      if (!host) return;
      host.innerHTML = state.groups.map((g) =>
        `<button type="button" class="qchip ${state.fGroups.has(g.id) ? 'on' : ''}" data-qg="${g.id}">${esc(g.name.split(' (')[0])}</button>`
      ).join('');
    }
    $('quick-groups').addEventListener('click', (e) => {
      const b = e.target.closest('[data-qg]');
      if (!b) return;
      const id = b.dataset.qg;
      state.fGroups.has(id) ? state.fGroups.delete(id) : state.fGroups.add(id);
      msGroup?.update();
      onFilterChange();
    });

    function buildQuery() {
      let q = sb.from('profiles').select('id, name, job, photo_url, disponible, dispo_from, fluent_english, experience, stars, tarif_jour, tjm_free, job_group_id, cdi, salesforce, dgitags_experience', { count: 'exact' });
      const text = $('f-q').value.trim().replace(/[(),%]/g, ' ').trim();
      if (text) {
        if ($('f-incv').checked) q = q.or(`name.ilike.%${text}%,job.ilike.%${text}%,cv_fts.wfts(french).${text}`);
        else q = q.or(`name.ilike.%${text}%,job.ilike.%${text}%`);
      }
      if (state.fGroups.size) q = q.in('job_group_id', [...state.fGroups]);
      if (state.fExps.size) q = q.in('experience', [...state.fExps]);
      if ($('f-dispo').checked) q = q.eq('disponible', true);
      if ($('f-en').checked) q = q.eq('fluent_english', true);
      if ($('f-stars').checked) q = q.gte('stars', 4).lte('stars', 5);
      if ($('f-cdi').checked) q = q.eq('cdi', true);
      if ($('f-dg').checked) q = q.eq('dgitags_experience', 'Oui');
      if ($('f-sf').checked) q = q.eq('salesforce', true);
      if ($('f-site').checked) q = q.eq('show_on_website', true);
      if (state.fTjms.size) {
        q = q.or([...state.fTjms].map((r) => {
          const [lo, hi] = r.split('-');
          return `and(tjm_free.gte.${lo},tjm_free.lte.${hi})`;
        }).join(','));
      }
      switch (state.sort) {
        case 'tjm-asc': return q.order('tjm_free', { ascending: true, nullsFirst: false }).order('name');
        case 'tjm-desc': return q.order('tjm_free', { ascending: false, nullsFirst: false }).order('name');
        case 'dispo': return q.order('disponible', { ascending: false }).order('dispo_from', { ascending: true, nullsFirst: false }).order('name');
        case 'nom': return q.order('name');
        default: return q.order('stars', { ascending: false, nullsFirst: false }).order('name');
      }
    }

    async function search(reset) {
      if (reset) { state.page = 0; $('results').innerHTML = ''; }
      const from = state.page * PAGE;
      const { data, count, error } = await buildQuery().range(from, from + PAGE - 1);
      if (error) { toast('Erreur : ' + error.message); return; }
      $('results-meta').textContent = `${count} profil${count > 1 ? 's' : ''}`;
      $('results').insertAdjacentHTML('beforeend', (data ?? []).map(card).join(''));
      state.lastCount = count ?? 0;
      $('more').hidden = from + PAGE >= (count ?? 0);
    }

    const tjmOf = (p) => p.tjm_free ?? p.tarif_jour;
    const frDate = (d) => new Date(d).toLocaleDateString('fr-FR', { day: 'numeric', month: 'short', year: 'numeric' });
    function dispoPill(p) {
      if (p.disponible) return '<span class="pc-dispo ok">Disponible</span>';
      if (p.dispo_from) {
        const past = new Date(p.dispo_from) <= new Date();
        return `<span class="pc-dispo ${past ? 'ok' : 'warn'}">Disponible dès le ${frDate(p.dispo_from)}</span>`;
      }
      return '<span class="pc-dispo off">Disponibilité à confirmer</span>';
    }
    function card(p) {
      const sel = state.selection.has(p.id);
      return `<article class="profile-card" data-id="${p.id}">
        <button class="sel-btn ${sel ? 'in' : ''}" data-sel="${p.id}" title="Ajouter à la sélection">${sel ? '✓' : '+'}</button>
        <div class="pc-head">
          ${p.photo_url ? `<img src="${esc(p.photo_url)}" alt="" loading="lazy" />` : `<span class="avatar-fallback">${esc((p.name ?? '?')[0])}</span>`}
          <div>
            <h3>${esc(p.name)}</h3>
            <p class="job">${esc(p.job ?? '')}</p>
          </div>
        </div>
        ${dispoPill(p)}
        <div class="pc-stats">
          ${tjmOf(p) ? `<span class="pc-tjm">${tjmOf(p)} €/j</span>` : ''}
          ${p.stars > 0 && p.stars <= 5 ? `<span class="pc-stars">★ ${p.stars}</span>` : ''}
          ${p.fluent_english ? '<span class="badge en">EN</span>' : ''}
        </div>
        <div class="pc-tags">
          ${p.experience ? `<span class="badge">${esc(p.experience)}</span>` : ''}
          ${p.dgitags_experience === 'Oui' ? '<span class="badge dg">digitags ✓</span>' : ''}
          ${p.salesforce ? '<span class="badge">Salesforce</span>' : ''}
          ${p.cdi ? '<span class="badge">Ouvert CDI</span>' : ''}
        </div>
      </article>`;
    }

    ['f-dispo', 'f-en', 'f-stars', 'f-cdi', 'f-dg', 'f-sf', 'f-site', 'f-incv'].forEach((id) => $(id).addEventListener('change', () => search(true)));
    let deb; $('f-q').addEventListener('input', () => { clearTimeout(deb); deb = setTimeout(() => search(true), 300); });
    $('btn-search').addEventListener('click', () => search(true));
    $('f-q').addEventListener('keydown', (e) => { if (e.key === 'Enter') search(true); });
    $('more').addEventListener('click', () => { state.page++; search(false); });
    $('f-sort').addEventListener('change', () => { state.sort = $('f-sort').value; search(true); });
    $('btn-filters').addEventListener('click', () => $('filters-block').classList.toggle('open'));
    $('btn-propales').addEventListener('click', () => document.querySelector('[data-tab="propales"]').click());
    $('view-grid').addEventListener('click', () => setView('grid'));
    $('view-list').addEventListener('click', () => setView('list'));
    function setView(v) {
      $('results').classList.toggle('list', v === 'list');
      $('view-grid').classList.toggle('active', v === 'grid');
      $('view-list').classList.toggle('active', v === 'list');
    }
    $('f-reset').addEventListener('click', () => {
      $('f-q').value = '';
      ['f-dispo', 'f-en', 'f-stars', 'f-cdi', 'f-dg', 'f-sf', 'f-site', 'f-incv'].forEach((id) => { $(id).checked = false; });
      state.fGroups.clear(); state.fExps.clear(); state.fTjms.clear();
      msGroup?.update(); msExp?.update(); msTjm?.update();
      state.sort = 'pertinence'; $('f-sort').value = 'pertinence';
      onFilterChange();
    });

    // ---------- Sélection ----------
    $('results').addEventListener('click', async (e) => {
      const selBtn = e.target.closest('[data-sel]');
      if (selBtn) {
        const id = selBtn.dataset.sel;
        if (state.selection.has(id)) state.selection.delete(id);
        else {
          const name = selBtn.closest('.profile-card').querySelector('h3').textContent;
          const job = selBtn.closest('.profile-card').querySelector('.job').textContent;
          state.selection.set(id, { id, name, job });
        }
        selBtn.classList.toggle('in');
        selBtn.textContent = selBtn.classList.contains('in') ? '✓' : '+';
        renderSelection();
        return;
      }
      const cardEl = e.target.closest('.profile-card');
      if (cardEl) openProfile(cardEl.dataset.id);
    });

    function renderSelection() {
      const n = state.selection.size;
      $('sel-empty').hidden = n > 0;
      $('sel-create').hidden = n === 0;
      $('sel-create').textContent = n ? `Créer une propale (${n}) →` : 'Créer une propale →';
      $('sel-list').innerHTML = [...state.selection.values()]
        .map((s) => `<li><span>${esc(s.name)}</span><button data-rm="${s.id}" title="Retirer">×</button></li>`).join('');
    }
    $('sel-list').addEventListener('click', (e) => {
      const rm = e.target.closest('[data-rm]');
      if (!rm) return;
      state.selection.delete(rm.dataset.rm);
      renderSelection();
      const btn = document.querySelector(`[data-sel="${rm.dataset.rm}"]`);
      if (btn) { btn.classList.remove('in'); btn.textContent = '+'; }
    });

    // ---------- Fiche profil ----------
    // Les documents privés (bucket docs-internes) sont stockés en chemin nu
    // « bucket/clé » : on génère une URL signée valable 1 h à l'ouverture.
    async function docUrl(value) {
      if (!value) return null;
      if (/^https?:/.test(value)) return value;
      const [bucket, ...rest] = value.split('/');
      const { data } = await sb.storage.from(bucket).createSignedUrl(rest.join('/'), 3600);
      return data?.signedUrl ?? null;
    }

    async function openProfile(id) {
      const { data: p, error } = await sb.from('profiles').select('*').eq('id', id).single();
      if (error) return toast('Erreur : ' + error.message);
      p.cv_url = await docUrl(p.cv_url);
      p.portfolio_pdf_url = await docUrl(p.portfolio_pdf_url);
      const d = $('drawer');
      d.innerHTML = `
        <button class="close" id="drawer-close">×</button>
        <div style="display:flex; gap:14px; align-items:center; margin-bottom:14px;">
          ${p.photo_url ? `<img src="${esc(p.photo_url)}" style="width:64px;height:64px;border-radius:12px;object-fit:cover;" alt="" />` : ''}
          <div><h2>${esc(p.name)}</h2><p class="job">${esc(p.job ?? '')}</p></div>
        </div>
        <section><div class="kv">
          <div><span>TJM freelance</span>${p.tjm_free ? p.tjm_free + ' €/j' : '—'}</div>
          <div><span>Tarif jour (vente)</span>${p.tarif_jour ? p.tarif_jour + ' €/j' : '—'}</div>
          <div><span>Disponibilité</span>${p.disponible ? 'Disponible' : (p.dispo_from ?? '—')}</div>
          <div><span>Expérience</span>${esc(p.experience ?? '—')}</div>
          <div><span>Note</span>${p.stars > 0 && p.stars <= 5 ? '★ ' + p.stars : '—'}</div>
          <div><span>Anglais courant</span>${p.fluent_english ? 'Oui' : 'Non'}</div>
          <div><span>Expérience digitags</span>${esc(p.dgitags_experience ?? '—')}</div>
          <div><span>Ouvert à un CDI</span>${p.cdi ? 'Oui' : 'Non'}</div>
          <div><span>Salesforce</span>${p.salesforce ? 'Oui' : 'Non'}</div>
          <div><span>Email</span>${esc(p.email ?? '—')}</div>
        </div></section>
        ${p.reference_html ? `<section><h4>Références</h4><div class="rich">${p.reference_html}</div></section>` : ''}
        ${p.preferences_html ? `<section><h4>Préférences</h4><div class="rich">${p.preferences_html}</div></section>` : ''}
        ${p.formation_html ? `<section><h4>Formation</h4><div class="rich">${p.formation_html}</div></section>` : ''}
        ${p.notes_html ? `<section><h4>Notes internes</h4><div class="rich">${p.notes_html}</div></section>` : ''}
        ${p.notes_tags_html ? `<section><h4>Tags</h4><div class="rich">${p.notes_tags_html}</div></section>` : ''}
        <section><h4>Documents</h4><div class="doc-links">
          ${p.cv_url ? `<a href="${esc(p.cv_url)}" target="_blank" rel="noopener">CV complet</a>` : ''}
          ${p.cv_anonyme_url ? `<a href="${esc(p.cv_anonyme_url)}" target="_blank" rel="noopener">CV anonymisé</a>` : ''}
          ${p.portfolio_url ? `<a href="${esc(p.portfolio_url)}" target="_blank" rel="noopener">Portfolio</a>` : ''}
          ${p.portfolio_pdf_url ? `<a href="${esc(p.portfolio_pdf_url)}" target="_blank" rel="noopener">Portfolio PDF</a>` : ''}
        </div></section>`;
      d.hidden = false;
      $('drawer-close').addEventListener('click', () => (d.hidden = true));
    }

    // ---------- Propales ----------
    document.querySelectorAll('.tool-tab').forEach((t) => t.addEventListener('click', () => {
      document.querySelectorAll('.tool-tab').forEach((x) => x.classList.remove('active'));
      t.classList.add('active');
      $('tab-recherche').hidden = t.dataset.tab !== 'recherche';
      $('tab-propales').hidden = t.dataset.tab !== 'propales';
      if (t.dataset.tab === 'propales') loadProposals();
    }));

    $('sel-create').addEventListener('click', async () => {
      const f = $('prop-form');
      const ids = [...state.selection.keys()];
      const { data: tjms } = await sb.from('profiles').select('id, tjm_free, tarif_jour').in('id', ids);
      const tjmMap = new Map((tjms ?? []).map((p) => [p.id, p.tjm_free ?? p.tarif_jour ?? null]));
      f.innerHTML = `
        <button class="close" id="prop-close">×</button>
        <h2 style="margin-bottom:16px;">Nouvelle propale</h2>
        <div class="field"><label>Titre du projet *</label><input id="np-title" placeholder="Refonte e-commerce — Acme" /></div>
        <div class="field"><label>Client</label><input id="np-client" placeholder="Acme SAS" /></div>
        <div class="field"><label>Introduction (visible par le prospect)</label><textarea id="np-intro" placeholder="Suite à nos échanges, voici l'équipe que nous vous proposons…"></textarea></div>
        <div style="display:flex; gap:14px; flex-wrap:wrap;">
          <div class="field" style="max-width: 160px;">
            <label>Marge digitags (%)</label>
            <input id="np-marge" type="number" value="20" min="0" step="5" />
          </div>
          <div class="field" style="max-width: 180px;">
            <label>Démarrage prévu</label>
            <input id="np-start" type="date" value="${new Date(Date.now() + 14 * 864e5).toISOString().slice(0, 10)}" />
          </div>
          <div class="field" style="max-width: 150px;">
            <label>Durée (semaines)</label>
            <input id="np-weeks" type="number" value="4" min="1" max="52" />
          </div>
        </div>
        <h4 style="margin: 10px 0;">Profils &amp; rôles — TJM client = TJM freelance + marge</h4>
        ${[...state.selection.values()].map((s) => `
          <div class="field" data-np-item="${s.id}" data-np-base="${tjmMap.get(s.id) ?? ''}">
            <label>${esc(s.name)}${tjmMap.get(s.id) ? ` <span style="color:var(--ink-faint); font-weight:600;">(TJM freelance : ${tjmMap.get(s.id)} €)</span>` : ''} — rôle, TJM client &amp; jours/semaine</label>
            <div style="display:flex; gap:8px;">
              <input class="np-role" placeholder="${esc(s.job || 'Rôle')}" style="flex:1;" />
              <input class="np-tjm" type="number" placeholder="TJM €" style="width:100px;" />
              <input class="np-days" type="number" value="5" min="0.5" max="7" step="0.5" title="Jours par semaine" style="width:80px;" />
            </div>
          </div>`).join('')}
        <button class="btn btn-dark" id="np-save">Créer la propale</button>
        <p id="np-msg" style="font-size:13px; color:var(--ink-faint); margin-top:10px;"></p>`;
      f.hidden = false;
      $('prop-close').addEventListener('click', () => (f.hidden = true));
      $('np-save').addEventListener('click', createProposal);
      // TJM client auto-calculé depuis la marge ; la saisie manuelle fige le champ.
      const applyMarge = () => {
        const m = Number($('np-marge').value) || 0;
        document.querySelectorAll('[data-np-item]').forEach((el) => {
          const base = Number(el.dataset.npBase);
          const input = el.querySelector('.np-tjm');
          if (base && !input.dataset.dirty) input.value = Math.round(base * (1 + m / 100) / 5) * 5;
        });
      };
      $('np-marge').addEventListener('input', applyMarge);
      document.querySelectorAll('.np-tjm').forEach((i) => i.addEventListener('input', () => { i.dataset.dirty = '1'; }));
      applyMarge();
    });

    async function createProposal() {
      const title = $('np-title').value.trim();
      if (!title) { $('np-msg').textContent = 'Le titre est requis.'; return; }
      const { data: { user } } = await sb.auth.getUser();
      const { data: prop, error } = await sb.from('proposals')
        .insert({
          title,
          client_name: $('np-client').value.trim() || null,
          intro: $('np-intro').value.trim() || null,
          created_by: user?.email,
          start_date: $('np-start').value || null,
          duration_weeks: Number($('np-weeks').value) || 4,
        })
        .select().single();
      if (error) { $('np-msg').textContent = 'Erreur : ' + error.message; return; }
      const items = [...document.querySelectorAll('[data-np-item]')].map((el, i) => ({
        proposal_id: prop.id,
        profile_id: el.dataset.npItem,
        role_label: el.querySelector('.np-role').value.trim() || el.querySelector('.np-role').placeholder,
        tjm: Number(el.querySelector('.np-tjm').value) || null,
        days_week: Number(el.querySelector('.np-days').value) || 5,
        sort: i,
      }));
      const { error: e2 } = await sb.from('proposal_items').insert(items);
      if (e2) { $('np-msg').textContent = 'Erreur : ' + e2.message; return; }
      $('prop-form').hidden = true;
      state.selection.clear();
      renderSelection();
      const url = `${location.origin}/p/${prop.token}`;
      try { await navigator.clipboard.writeText(url); toast('Propale créée — lien copié ✓'); }
      catch { toast('Propale créée'); }
      loadProposals();
      document.querySelector('[data-tab="propales"]').click();
    }

    async function loadProposals() {
      const { data, error } = await sb.from('proposals')
        .select('id, token, title, client_name, created_at, created_by, archived, proposal_items(id)')
        .eq('archived', false)
        .order('created_at', { ascending: false });
      if (error) return;
      $('props-list').innerHTML = (data ?? []).map((p) => `
        <div class="prop-row">
          <h3>${esc(p.title)}${p.client_name ? ` <span style="color:var(--ink-faint); font-weight:600;">· ${esc(p.client_name)}</span>` : ''}</h3>
          <span class="meta">${p.proposal_items.length} profil${p.proposal_items.length > 1 ? 's' : ''} · ${new Date(p.created_at).toLocaleDateString('fr-FR')} · ${esc(p.created_by ?? '')}</span>
          <a class="btn btn-outline btn-sm" href="/p/${p.token}" target="_blank" rel="noopener">Voir</a>
          <button class="btn btn-dark btn-sm" data-copy="${p.token}">Copier le lien</button>
          <button class="btn btn-outline btn-sm" data-arch="${p.id}">Archiver</button>
        </div>`).join('') || '<p style="color:var(--ink-faint);">Aucune propale pour l\'instant — composez une sélection depuis l\'onglet Recherche.</p>';
    }

    $('props-list').addEventListener('click', async (e) => {
      const cp = e.target.closest('[data-copy]');
      if (cp) {
        try { await navigator.clipboard.writeText(`${location.origin}/p/${cp.dataset.copy}`); toast('Lien copié ✓'); } catch {}
        return;
      }
      const ar = e.target.closest('[data-arch]');
      if (ar) {
        await sb.from('proposals').update({ archived: true }).eq('id', ar.dataset.arch);
        loadProposals();
      }
    });

    init();
  </script>
</Base>
