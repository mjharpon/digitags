---
import Base from '../layouts/Base.astro';
import ExpertisePage from '../components/ExpertisePage.astro';
---
<Base
  title="Designers freelances seniors — UX, UI, Product | digitags.work"
  description="Designers freelances seniors (UX, UI, Product, DA) recommandés par leurs pairs. Seuls ou en studio, trouvez le bon profil pour votre projet."
>
  <ExpertisePage
    eyebrow="Votre hub de designers"
    title="Des designers seniors pour des produits qui convertissent."
    lead="Product Designer, UX Designer, UI Designer ou directeur artistique : le Hub vous connecte au designer freelance qui correspond exactement à votre projet — sélectionné pour ses compétences et recommandé par ses pairs."
    ctaLabel="Trouver un designer"
    skillsTitle="Les compétences design du réseau"
    skills={["UX Designer", "UI Designer", "Product Designer", "Web designer", "Directeur artistique", "Illustrateur", "Motion designer", "Artiste 3D", "Creative Lead"]}
    metiers={[
      { label: "UX Designer freelance", href: "/metiers/ux-designer-freelance" },
      { label: "UI Designer freelance", href: "/metiers/ui-designer-freelance" },
      { label: "UX Writer freelance", href: "/metiers/ux-writer-freelance" },
    ]}
    reussites={[
      { tag: "UX / UI", title: "Refonte UX d'un espace client", points: ["Audit complet du parcours existant", "Maquettage et prototypage", "Accompagnement jusqu'à la mise en production"] },
      { tag: "Graphisme", title: "Campagnes Autodesk × Techdata", points: ["Création des visuels de campagne", "Déclinaisons multi-formats", "Cohérence avec la charte internationale"] },
      { tag: "UX Research", title: "Design UX de bout en bout", points: ["Recherche utilisateurs", "Audit et recommandations", "Maquettage et mise en production"] },
    ]}
  />
</Base>
