---
import Base from '../layouts/Base.astro';

const steps = [
  { n: 1, title: "Nous vous rappelons rapidement", desc: "Pour comprendre votre besoin et répondre à vos questions." },
  { n: 2, title: "Nous cadrons le brief ensemble", desc: "Objectifs, périmètre, délais, budget…" },
  { n: 3, title: "Vous rencontrez les bons profils", desc: "Une sélection ciblée et pertinente dans notre réseau." },
];
---
<Base
  title="Parler de mon projet | digitags.work"
  description="Décrivez votre besoin au Hub : nous revenons vers vous rapidement avec les experts freelances ou studios qui correspondent à votre projet."
>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Contact</p>
      <h1>Parlons de votre prochain projet.</h1>
      <p class="lead">Décrivez-nous votre besoin, nous vous recontactons rapidement pour cadrer le brief et vous proposer les bons profils du réseau.</p>
    </div>
  </section>

  <section class="section" style="padding-top: 20px;">
    <div class="container contact-wrap">

      <form class="form-card" id="contact-form">
        <p class="hidden" style="display:none;" aria-hidden="true">
          <label>Ne pas remplir : <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
        </p>

        <a class="contact-flash" href="/devenir-freelance">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="8" r="4"/><path d="M4 21c1.5-4 4.5-6 8-6s6.5 2 8 6"/></svg>
          <span>Vous êtes freelance&nbsp;? <strong>Référencez-vous en 30 secondes →</strong></span>
        </a>

        <div class="form-row">
          <div class="field">
            <label for="nom">Nom</label>
            <div class="input-ico">
              <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="8" r="4"/><path d="M4 21c1.5-4 4.5-6 8-6s6.5 2 8 6"/></svg>
              <input type="text" id="nom" name="nom" required autocomplete="name" placeholder="Votre nom" />
            </div>
          </div>
          <div class="field">
            <label for="email">Email</label>
            <div class="input-ico">
              <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
              <input type="email" id="email" name="email" required autocomplete="email" placeholder="votre@email.com" />
            </div>
          </div>
        </div>

        <div class="form-row">
          <div class="field">
            <label for="societe">Société</label>
            <div class="input-ico">
              <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="4" y="3" width="10" height="18" rx="1"/><path d="M14 9h6v12h-6M7 7h1M7 11h1M7 15h1M10 7h1M10 11h1M10 15h1M17 13h1M17 17h1"/></svg>
              <input type="text" id="societe" name="societe" autocomplete="organization" placeholder="Votre société" />
            </div>
          </div>
          <div class="field">
            <label for="expertise">Expertise concernée</label>
            <select id="expertise" name="expertise">
              <option value="">— Choisir —</option>
              <option>Design &amp; UX</option>
              <option>Marketing &amp; Acquisition</option>
              <option>Product &amp; Projet</option>
              <option>Tech &amp; Data</option>
              <option>Équipe IA</option>
              <option>Plusieurs expertises / une équipe</option>
              <option>Autre</option>
            </select>
          </div>
        </div>

        <div class="field">
          <label for="message">Votre brief</label>
          <div class="input-ico input-ico-area">
            <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M7 3h7l5 5v13H7z"/><path d="M14 3v5h5M10 13h6M10 17h6"/></svg>
            <textarea id="message" name="message" required placeholder="Contexte, objectifs, délais, budget si vous l'avez…"></textarea>
          </div>
        </div>

        <div class="field">
          <label for="brief">Joindre un brief (optionnel)</label>
          <input type="file" id="brief" name="brief" accept=".pdf,.doc,.docx,.ppt,.pptx,.jpg,.jpeg,.png" />
          <p class="field-hint">PDF, Word, PowerPoint ou image — 10&nbsp;Mo max.</p>
        </div>

        <button type="submit" class="btn btn-dark" id="contact-submit">Envoyer mon brief <span aria-hidden="true">→</span></button>
        <p id="contact-error" style="color: var(--red); font-size: 13.5px; margin-top: 12px;" hidden></p>

        <div id="contact-success" class="form-success" hidden>
          <h2>Brief bien reçu&nbsp;✓</h2>
          <p>Merci&nbsp;! Nous revenons vers vous sous 24&nbsp;h ouvrées pour cadrer votre besoin. En attendant, vous pouvez découvrir <a href="/projets">les types de missions que nous réalisons</a>.</p>
        </div>
      </form>

      <div class="contact-col">
        <aside class="contact-aside">
          <h2>Ce qui se passe ensuite</h2>
          <ol class="aside-steps">
            {steps.map((s) => (
              <li>
                <span class="as-num">{s.n}</span>
                <div>
                  <strong>{s.title}</strong>
                  <p>{s.desc}</p>
                </div>
              </li>
            ))}
          </ol>
        </aside>

        <aside class="contact-info">
          <p class="ci-label">Nous contacter</p>
          <div class="ci-row">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="var(--blue)" stroke-width="2" stroke-linecap="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
            <div>
              <a href="mailto:hello@digitags.work"><strong>hello@digitags.work</strong></a>
              <p>Nous répondons sous 24&nbsp;h ouvrées.</p>
            </div>
          </div>
          <div class="ci-row">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="var(--blue)" stroke-width="2" stroke-linecap="round"><path d="M12 21s7-5.1 7-11a7 7 0 1 0-14 0c0 5.9 7 11 7 11z"/><circle cx="12" cy="10" r="2.5"/></svg>
            <div>
              <strong>Paris</strong>
              <p>Nous accompagnons des clients partout en Europe.</p>
            </div>
          </div>
          <div class="ci-row">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="var(--blue)"><path d="M4.98 3.5C4.98 4.88 3.87 6 2.5 6S0 4.88 0 3.5 1.12 1 2.5 1s2.48 1.12 2.48 2.5zM.24 8.31h4.52V23H.24zM8.34 8.31h4.33v2h.06c.6-1.14 2.08-2.34 4.28-2.34 4.58 0 5.42 3.01 5.42 6.92V23h-4.52v-7.1c0-1.69-.03-3.87-2.36-3.87-2.36 0-2.72 1.84-2.72 3.75V23H8.34z"/></svg>
            <div>
              <a href="https://www.linkedin.com/company/18871359" target="_blank" rel="noopener"><strong>LinkedIn — digitags.work</strong> <span aria-hidden="true">↗</span></a>
            </div>
          </div>
        </aside>
      </div>

    </div>
  </section>

  <script>
    // Envoi du brief via l'endpoint serveur /api/contact
    // (enregistrement Supabase + fichier joint + notification email).
    const form = document.getElementById('contact-form') as HTMLFormElement;
    const errBox = document.getElementById('contact-error') as HTMLParagraphElement;
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      errBox.hidden = true;
      const fileInput = document.getElementById('brief') as HTMLInputElement;
      const file = fileInput?.files?.[0];
      if (file && file.size > 10 * 1024 * 1024) {
        errBox.textContent = `Le fichier « ${file.name} » dépasse 10 Mo.`;
        errBox.hidden = false;
        return;
      }
      const btn = document.getElementById('contact-submit') as HTMLButtonElement;
      btn.disabled = true;
      btn.textContent = 'Envoi…';
      try {
        const res = await fetch('/api/contact', { method: 'POST', body: new FormData(form) });
        const data = await res.json().catch(() => ({ ok: false }));
        if (!res.ok || !data.ok) throw new Error(data.error || 'Erreur serveur');
        for (const el of Array.from(form.children)) {
          if ((el as HTMLElement).id !== 'contact-success') (el as HTMLElement).style.display = 'none';
        }
        (document.getElementById('contact-success') as HTMLElement).hidden = false;
      } catch (err) {
        errBox.textContent = err instanceof Error && err.message !== 'Erreur serveur'
          ? err.message
          : "L'envoi a échoué — réessayez, ou écrivez-nous directement à hello@digitags.work.";
        errBox.hidden = false;
        btn.disabled = false;
        btn.innerHTML = 'Envoyer mon brief <span aria-hidden="true">→</span>';
      }
    });
  </script>
</Base>
