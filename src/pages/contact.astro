---
import Base from '../layouts/Base.astro';
---
<Base
  title="Parler de mon projet | digitags.work"
  description="Décrivez votre besoin au Hub : nous revenons vers vous rapidement avec les experts freelances ou studios qui correspondent à votre projet."
>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Contact</p>
      <h1>Parlons de votre prochain projet.</h1>
      <p class="lead">Décrivez-nous votre besoin en quelques lignes : nous vous rappelons dans la foulée pour cadrer le brief et solliciter les bons profils du réseau.</p>
    </div>
  </section>

  <section class="section" style="padding-top: 20px;">
    <div class="container contact-wrap">

      <form class="form-card" id="contact-form">
        <p class="hidden" style="display:none;" aria-hidden="true">
          <label>Ne pas remplir : <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
        </p>

        <div class="field">
          <label>Vous êtes</label>
          <div class="radio-pills" id="profil-pills">
            <label><input type="radio" name="profil" value="entreprise" checked /> Je cherche un talent</label>
            <label><input type="radio" name="profil" value="freelance" /> Je suis freelance</label>
          </div>
        </div>

        <div class="form-row">
          <div class="field">
            <label for="nom">Nom</label>
            <input type="text" id="nom" name="nom" required autocomplete="name" />
          </div>
          <div class="field">
            <label for="email">Email</label>
            <input type="email" id="email" name="email" required autocomplete="email" />
          </div>
        </div>

        <div class="form-row">
          <div class="field">
            <label for="societe">Société</label>
            <input type="text" id="societe" name="societe" autocomplete="organization" />
          </div>
          <div class="field">
            <label for="expertise">Expertise concernée</label>
            <select id="expertise" name="expertise">
              <option value="">— Choisir —</option>
              <option>Design &amp; UX</option>
              <option>Marketing &amp; Acquisition</option>
              <option>Product &amp; Projet</option>
              <option>Tech &amp; Data</option>
              <option>Plusieurs expertises / une équipe</option>
              <option>Autre</option>
            </select>
          </div>
        </div>

        <div class="field">
          <label for="message">Votre brief</label>
          <textarea id="message" name="message" required placeholder="Contexte, objectifs, délais, budget si vous l'avez…"></textarea>
        </div>

        <button type="submit" class="btn btn-dark" id="contact-submit">Envoyer mon brief</button>
        <p id="contact-error" style="color: var(--red); font-size: 13.5px; margin-top: 12px;" hidden>L'envoi a échoué — réessayez, ou écrivez-nous directement à hello@digitags.work.</p>
      </form>

      <aside class="contact-aside">
        <h2>Ce qui se passe ensuite</h2>
        <ul class="aside-list">
          <li><span class="hex-icon hex-icon-blue"></span> Nous vous rappelons rapidement</li>
          <li><span class="hex-icon hex-icon-yellow"></span> Nous cadrons le brief ensemble</li>
          <li><span class="hex-icon hex-icon-red"></span> Vous rencontrez les bons profils</li>
        </ul>
        <p>Vous préférez l'email&nbsp;?</p>
        <a href="mailto:hello@digitags.work">hello@digitags.work</a>
        <p style="margin-top:22px;">Paris &middot; Remote<br />
          <a href="https://www.linkedin.com/company/18871359">LinkedIn — digitags.work</a>
        </p>
      </aside>

    </div>
  </section>

  <script>
    // Pre-select "Je suis freelance" when arriving via /contact?profil=freelance
    const params = new URLSearchParams(window.location.search);
    if (params.get('profil') === 'freelance') {
      const radio = document.querySelector('input[name="profil"][value="freelance"]');
      if (radio instanceof HTMLInputElement) radio.checked = true;
    }

    // Envoi du brief vers Supabase (table contact_submissions, insertion anonyme via RLS).
    const form = document.getElementById('contact-form');
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fd = new FormData(form as HTMLFormElement);
      if (fd.get('bot-field')) { location.href = '/merci'; return; } // honeypot
      const btn = document.getElementById('contact-submit') as HTMLButtonElement;
      btn.disabled = true;
      btn.textContent = 'Envoi…';
      try {
        const res = await fetch(`${import.meta.env.PUBLIC_SUPABASE_URL}/rest/v1/contact_submissions`, {
          method: 'POST',
          headers: {
            apikey: import.meta.env.PUBLIC_SUPABASE_ANON_KEY,
            Authorization: `Bearer ${import.meta.env.PUBLIC_SUPABASE_ANON_KEY}`,
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({
            profil: fd.get('profil'),
            nom: fd.get('nom'),
            email: fd.get('email'),
            societe: fd.get('societe') || null,
            expertise: fd.get('expertise') || null,
            message: fd.get('message'),
          }),
        });
        if (!res.ok) throw new Error(String(res.status));
        location.href = '/merci';
      } catch {
        document.getElementById('contact-error')!.hidden = false;
        btn.disabled = false;
        btn.textContent = 'Envoyer mon brief';
      }
    });
  </script>
</Base>
