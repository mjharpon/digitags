---
// Page propale privée, accessible uniquement via son lien à jeton.
// Rendue à la demande côté serveur (clé service_role, jamais exposée).
// N'expose AUCUNE donnée sensible : pas d'email, pas de notes internes,
// pas de CV complet — uniquement le CV anonymisé.
export const prerender = false;

import { createClient } from '@supabase/supabase-js';
import Base from '../../layouts/Base.astro';

const { token } = Astro.params;
const url = import.meta.env.SUPABASE_URL;
const key = import.meta.env.SUPABASE_SERVICE_KEY;

let proposal = null;
let items = [];

if (url && key && token && /^[a-f0-9]{16,64}$/.test(token)) {
  const sb = createClient(url, key, { auth: { persistSession: false } });
  const { data } = await sb
    .from('proposals')
    .select('id, title, client_name, intro, created_at, archived')
    .eq('token', token)
    .eq('archived', false)
    .maybeSingle();
  proposal = data;
  if (proposal) {
    const { data: rows } = await sb
      .from('proposal_items')
      .select('role_label, tjm, note, sort, profiles(name, job, photo_url, experience, stars, fluent_english, reference_html, formation_html, cv_anonyme_url, portfolio_url)')
      .eq('proposal_id', proposal.id)
      .order('sort');
    items = rows ?? [];
  }
}

if (!proposal) {
  Astro.response.status = 404;
}

const dateFmt = proposal ? new Date(proposal.created_at).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' }) : '';
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');
---
<Base
  title={proposal ? `Proposition — ${proposal.title} | digitags.work` : 'Proposition introuvable | digitags.work'}
  description="Proposition d'équipe préparée par digitags.work."
>
  {proposal ? (
    <>
      <section class="prop-hero">
        <div class="container">
          <p class="eyebrow">Proposition digitags.work{proposal.client_name && ` — pour ${proposal.client_name}`}</p>
          <h1>{proposal.title}</h1>
          {proposal.intro && <p>{proposal.intro}</p>}
          <p style="font-size: 12.5px; color: #8f97b3; margin-top: 14px;">Préparée le {dateFmt} · Document confidentiel, réservé à son destinataire.</p>
        </div>
      </section>

      <div class="container prop-profiles">
        {items.map((it) => {
          const p = it.profiles;
          return (
            <article class="prop-card">
              {p.photo_url
                ? <img src={p.photo_url} alt="" loading="lazy" />
                : <span class="avatar-fallback">{(p.name ?? '?')[0]}</span>}
              <div>
                <h2>{p.name}</h2>
                <p class="role">{it.role_label ?? p.job}</p>
                <div class="badges" style="margin-bottom: 10px;">
                  {p.experience && <span class="badge">{p.experience}</span>}
                  {p.stars && <span class="badge star">★ {p.stars}</span>}
                  {p.fluent_english && <span class="badge">Anglais courant</span>}
                  {it.tjm && <span class="badge ok">{it.tjm} €/jour</span>}
                </div>
                {it.note && <p class="rich">{it.note}</p>}
                {p.reference_html && <div class="rich" set:html={p.reference_html} />}
                <div class="doc-links" style="margin-top: 10px;">
                  {p.cv_anonyme_url && <a href={p.cv_anonyme_url} target="_blank" rel="noopener">Voir le CV</a>}
                  {p.portfolio_url && <a href={p.portfolio_url} target="_blank" rel="noopener">Portfolio</a>}
                </div>
              </div>
            </article>
          );
        })}
      </div>

      <section class="cta-navy" style="margin-bottom: 50px;">
        <div class="cta-copy">
          <p class="eyebrow">La suite&nbsp;?</p>
          <h2>Échangeons sur cette proposition</h2>
          <p>Nous organisons les entretiens avec les profils qui retiennent votre attention.</p>
        </div>
        <a href="mailto:hello@digitags.work" class="btn">Nous répondre <span aria-hidden="true">→</span></a>
      </section>
    </>
  ) : (
    <section class="page-hero" style="padding-bottom: 120px;">
      <div class="container">
        <p class="eyebrow">Proposition</p>
        <h1>Ce lien n'est plus valide.</h1>
        <p class="lead">Cette proposition n'existe pas ou a été archivée. Contactez votre interlocuteur digitags.work pour recevoir un nouveau lien.</p>
        <div class="hero-cta"><a href="/" class="btn btn-dark">Retour à l'accueil</a></div>
      </div>
    </section>
  )}
</Base>
