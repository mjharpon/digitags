---
// Page propale privée, accessible uniquement via son lien à jeton.
// Rendue à la demande côté serveur (clé service_role, jamais exposée).
// Document commercial autonome (sans la navigation du site).
// Anonymisation anti-contournement : « Consultant N » (le nom n'est même
// pas requêté), avatar générique, CV anonymisé uniquement, pas de lien
// portfolio, pas d'email ni de notes internes.
export const prerender = false;

import '../../styles/global.css';

const { token } = Astro.params;
const runtimeEnv = (Astro.locals as any)?.runtime?.env ?? {};
const url = runtimeEnv.SUPABASE_URL ?? import.meta.env.SUPABASE_URL;
const key = runtimeEnv.SUPABASE_SERVICE_KEY ?? import.meta.env.SUPABASE_SERVICE_KEY;

async function rest(path: string) {
  const res = await fetch(`${url}/rest/v1/${path}`, {
    headers: { apikey: key, Authorization: `Bearer ${key}` },
  });
  return res.ok ? res.json() : [];
}

let proposal: any = null;
let items: any[] = [];

if (url && key && token && /^[a-f0-9]{16,64}$/.test(token)) {
  const props = await rest(`proposals?select=id,title,client_name,intro,created_at,start_date,duration_weeks,password,clients(name)&token=eq.${token}&archived=eq.false&limit=1`);
  proposal = props[0] ?? null;
}

// Nom du client : fiche client si rattachée, sinon texte libre historique.
const clientName = proposal?.clients?.name ?? proposal?.client_name ?? null;

// Protection par mot de passe (configuré à la création de la propale).
// Un cookie signé (sha256 token:mdp) évite de redemander pendant 7 jours.
const sha256hex = async (s: string) => {
  const buf = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(s));
  return [...new Uint8Array(buf)].map((b) => b.toString(16).padStart(2, '0')).join('');
};

let authorized = !!proposal && !proposal.password;
let wrongPassword = false;
if (proposal?.password) {
  const expected = await sha256hex(`${token}:${proposal.password}`);
  if (Astro.cookies.get(`pw_${proposal.id.slice(0, 8)}`)?.value === expected) authorized = true;
  if (!authorized && Astro.request.method === 'POST') {
    const fd = await Astro.request.formData().catch(() => null);
    const attempt = String(fd?.get('pw') ?? '').trim();
    if (attempt && attempt === proposal.password) {
      Astro.cookies.set(`pw_${proposal.id.slice(0, 8)}`, expected, {
        path: Astro.url.pathname,
        httpOnly: true,
        secure: true,
        sameSite: 'lax',
        maxAge: 7 * 24 * 3600,
      });
      authorized = true;
    } else {
      wrongPassword = true;
    }
  }
}

// Le contenu (profils, tarifs) n'est chargé qu'une fois l'accès autorisé.
if (proposal && authorized) {
  items = await rest(`proposal_items?select=role_label,tjm,note,sort,days_week,profiles(job,experience,stars,fluent_english,reference_html,cv_anonyme_url)&proposal_id=eq.${proposal.id}&order=sort`);
}

if (!proposal) {
  Astro.response.status = 404;
}
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');

// Avatars génériques : silhouette blanche sur hexagone, couleurs de la
// marque en rotation pour différencier les consultants d'un coup d'œil.
const AVA_COLORS = ['#2b46f0', '#f5b731', '#f2543d', '#111c3f'];

// Références rich-text → liste de clients (chips) si les lignes sont courtes.
const strip = (h: string) => h
  .replace(/<[^>]+>/g, '')
  .replace(/&nbsp;/g, ' ')
  .replace(/&amp;/g, '&')
  .replace(/&#39;|&apos;/g, "'")
  .replace(/&quot;/g, '"')
  .replace(/\s+/g, ' ')
  .trim();
const refLines = (html?: string) => {
  if (!html) return null;
  const lines = html
    .split(/<\/p>|<\/li>|<br\s*\/?>/i)
    .map((l) => strip(l))
    .filter(Boolean);
  if (lines.length === 0) return null;
  return lines.every((l) => l.length <= 45) ? { chips: lines } : { html };
};

const dateFmt = proposal
  ? new Date(proposal.created_at).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' })
  : '';

const defaultStart = proposal?.start_date ?? new Date(Date.now() + 14 * 864e5).toISOString().slice(0, 10);
const euro = (n: number) => n.toLocaleString('fr-FR', { maximumFractionDigits: 2 });
// Jours : mêmes bornes que l'outil interne (0,5 à 365), décimales à la française.
const clampDays = (v: unknown) => {
  const n = Number(v);
  return Number.isFinite(n) && n > 0 ? Math.min(365, Math.max(0.5, Math.round(n * 100) / 100)) : 10;
};
const jours = (n: number) => `${euro(n)} jour${n >= 2 ? 's' : ''}`;

// Données du configurateur (aucun nom : « Consultant N »).
// days = nombre TOTAL de jours du consultant sur la mission.
// tjm = 0 → ligne « sur devis » : affichée, mais hors du budget estimé.
const cfgItems = items.map((it, i) => ({
  n: i + 1,
  role: it.role_label || it.profiles?.job || '',
  tjm: Number(it.tjm) > 0 ? Number(it.tjm) : 0,
  days: clampDays(it.days_week),
}));
const priced = cfgItems.filter((c) => c.tjm > 0);
const quoted = cfgItems.length - priced.length;
const anyTjm = priced.length > 0;
const totalBudget = priced.reduce((s, c) => s + c.tjm * c.days, 0);
const totalDays = cfgItems.reduce((s, c) => s + c.days, 0);
const pricedDays = priced.reduce((s, c) => s + c.days, 0);
// Mêmes libellés que le script de recalcul en bas de page.
const totalLabel = anyTjm ? `${euro(totalBudget)} € HT` : 'Sur devis';
const subLabel = !anyTjm
  ? `${jours(totalDays)} de mission — chiffrage sur devis`
  : quoted
    ? `pour ${jours(pricedDays)} chiffré${pricedDays >= 2 ? 's' : ''} · ${quoted} profil${quoted > 1 ? 's' : ''} sur devis en sus`
    : `pour ${jours(totalDays)} de mission`;
---
<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{proposal ? `Proposition — ${proposal.title}` : 'Proposition introuvable'} | digitags.work</title>
  <meta name="robots" content="noindex, nofollow" />
  <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml" />
  <link rel="preload" href="/assets/fonts/pjs-400.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/assets/fonts/pjs-800.woff2" as="font" type="font/woff2" crossorigin />
</head>
<body>
  {proposal && !authorized ? (
    <div class="container pw-gate">
      <span class="logo">
        <img src="/assets/logo-mark.svg" alt="" class="logo-mark" />
      </span>
      <p class="eyebrow">Proposition confidentielle</p>
      <h1>Cette proposition est protégée.</h1>
      <p class="pw-sub">Saisissez le mot de passe communiqué par votre interlocuteur digitags.work.</p>
      <form method="POST" class="pw-form">
        <input type="password" name="pw" placeholder="Mot de passe" autocomplete="off" autofocus required />
        <button type="submit" class="btn btn-dark">Accéder</button>
      </form>
      {wrongPassword && <p class="pw-error">Mot de passe incorrect — réessayez.</p>}
    </div>
  ) : proposal ? (
    <>
      <header class="prop3-hero">
        <div class="container">
          <div class="prop2-topbar">
            <span class="logo logo-light">
              <img src="/assets/logo-mark.svg" alt="" class="logo-mark" />
              <span class="logo-text" style="color:#fff;">digitags<span class="logo-tld">.work</span></span>
            </span>
            <span class="tag">Confidentiel</span>
          </div>
          <div class="prop3-hero-grid">
            <div>
              <p class="eyebrow">Proposition d'équipe{clientName && ` — pour ${clientName}`}</p>
              <h1>Constituez votre équipe sur-mesure</h1>
              <p class="intro">{proposal.intro ?? 'Sélectionnez les bons talents, ajustez les dates et la durée. Le budget se met à jour en temps réel.'}</p>
              <p class="meta">« {proposal.title} » · Préparée le {dateFmt} · Réservée à son destinataire — merci de ne pas la diffuser.</p>
            </div>
            <div class="prop3-illu" aria-hidden="true">
              {['Product', 'UX/UI', 'Data'].map((lbl, i) => (
                <div class={`p3i-card c${i}`}>
                  <svg viewBox="0 0 86 86" width="46" height="46">
                    <polygon points="43,4 78,23.5 78,62.5 43,82 8,62.5 8,23.5" fill={AVA_COLORS[i % AVA_COLORS.length]} />
                    <circle cx="43" cy="36" r="11" fill="#fff" opacity="0.92" />
                    <path d="M24 66c2.5-12 9.5-18 19-18s16.5 6 19 18v2H24z" fill="#fff" opacity="0.92" />
                  </svg>
                  <em>{lbl}</em>
                </div>
              ))}
            </div>
          </div>
        </div>
      </header>

      <div class="container">
        <ol class="prop3-steps">
          <li class="on"><span class="ps-num">1</span><div><strong>Mission</strong><small>Dates et durée</small></div></li>
          <li><span class="ps-num">2</span><div><strong>Talents</strong><small>Votre équipe proposée</small></div></li>
          <li><span class="ps-num">3</span><div><strong>Validation</strong><small>Détails et options</small></div></li>
          <li><span class="ps-num">4</span><div><strong>Envoi</strong><small>On démarre ensemble</small></div></li>
        </ol>

        <div class="prop3-layout">
          <div class="prop3-main">

            <section class="prop3-card">
              <div class="prop3-card-head">
                <span class="p3-ico">📅</span>
                <div>
                  <h2>1. Votre mission, à votre mesure</h2>
                  <p>{anyTjm
                    ? `Ajustez le démarrage et la charge de chaque consultant : le budget se recalcule instantanément.${quoted ? ' Les profils « sur devis » sont chiffrés à part.' : ''}`
                    : 'Ajustez le démarrage et la charge de chaque consultant — le chiffrage vous est communiqué sur devis.'}</p>
                </div>
              </div>
              <div class="prop3-config-fields">
                <label>Démarrage souhaité
                  <input type="date" id="cfg-start" value={defaultStart} />
                </label>
                <label>Charge totale proposée
                  <span class="cfg-weeks-wrap"><strong id="cfg-days-total" style="font-size:18px;">{euro(totalDays)}</strong> jours</span>
                </label>
              </div>
            </section>

            <section class="prop3-card">
              <div class="prop3-card-head">
                <span class="p3-ico">👥</span>
                <div>
                  <h2>2. Talents sélectionnés</h2>
                  <p>{items.length} profil{items.length > 1 ? 's' : ''} pour ce projet · Vous pouvez ajuster le nombre de jours ou écarter un profil.</p>
                </div>
              </div>
              <div class="prop3-rows">
                {items.map((it, i) => {
                  const p = it.profiles;
                  const c = cfgItems[i];
                  const refs = refLines(p.reference_html);
                  const refChips = refs && 'chips' in refs ? refs.chips : [];
                  return (
                    <div class="prop3-row" data-row={i}>
                      <span class="p3-ava" aria-hidden="true">
                        <svg viewBox="0 0 86 86" width="48" height="48">
                          <polygon points="43,4 78,23.5 78,62.5 43,82 8,62.5 8,23.5" fill={AVA_COLORS[i % AVA_COLORS.length]} />
                          <circle cx="43" cy="36" r="11" fill="#fff" opacity="0.92" />
                          <path d="M24 66c2.5-12 9.5-18 19-18s16.5 6 19 18v2H24z" fill="#fff" opacity="0.92" />
                        </svg>
                      </span>
                      <div class="p3-id">
                        <strong>Consultant {i + 1}</strong>
                        <span class="p3-role">{c.role}</span>
                        <span class="p3-badges">
                          {p.experience && <span class="badge">{p.experience}</span>}
                          {p.stars > 0 && p.stars <= 5 && <span class="badge star">★ {p.stars}</span>}
                          {p.fluent_english && <span class="badge en">Anglais courant</span>}
                        </span>
                        {refChips.length > 0 && (
                          <span class="p3-refs">
                            <em>A travaillé avec</em>
                            {refChips.slice(0, 4).map((r: string) => <span class="p3-ref">{r}</span>)}
                            {refChips.length > 4 && <span class="p3-ref p3-ref-more">+{refChips.length - 4}</span>}
                          </span>
                        )}
                      </div>
                      <div class="p3-cell">
                        <label>TJM</label>
                        {c.tjm > 0
                          ? <span class="p3-tjm">{euro(c.tjm)} €</span>
                          : <span class="p3-tjm p3-quote">sur devis</span>}
                      </div>
                      <div class="p3-cell">
                        <label for={`days-${i}`}>Jours</label>
                        <input type="number" id={`days-${i}`} class="p3-days" value={c.days} min="0.5" max="365" step="0.5" />
                      </div>
                      <strong class={`p3-line${c.tjm > 0 ? '' : ' p3-quote'}`} data-line={i}>{c.tjm > 0 ? `${euro(c.tjm * c.days)} €` : 'sur devis'}</strong>
                      <button type="button" class="p3-x" data-x={i} title="Écarter ce profil de l'estimation">×</button>
                    </div>
                  );
                })}
              </div>
            </section>

            <section class="prop3-card">
              <div class="prop3-card-head">
                <span class="p3-ico">🔎</span>
                <div>
                  <h2>3. Les profils en détail</h2>
                  <p>Références et CV anonymisés — les coordonnées complètes sont communiquées lors de l'entretien.</p>
                </div>
              </div>
              <div class="prop2-list">
                {items.map((it, i) => {
                  const p = it.profiles;
                  const refs = refLines(p.reference_html);
                  return (
                    <article class="prop2-card">
                      <div class="prop2-head">
                        <span class="num-badge">{String(i + 1).padStart(2, '0')}</span>
                        <span class="prop2-ava" aria-hidden="true">
                          <svg viewBox="0 0 86 86" width="72" height="72">
                            <polygon points="43,4 78,23.5 78,62.5 43,82 8,62.5 8,23.5" fill={AVA_COLORS[i % AVA_COLORS.length]} />
                            <circle cx="43" cy="36" r="11" fill="#fff" opacity="0.92" />
                            <path d="M24 66c2.5-12 9.5-18 19-18s16.5 6 19 18v2H24z" fill="#fff" opacity="0.92" />
                          </svg>
                        </span>
                        <div>
                          <h2>Consultant {i + 1}</h2>
                          <p class="role">{cfgItems[i].role}</p>
                          <div class="badges">
                            {p.experience && <span class="badge">{p.experience}</span>}
                            {p.stars > 0 && p.stars <= 5 && <span class="badge star">★ {p.stars} — note du Hub</span>}
                            {p.fluent_english && <span class="badge">Anglais courant</span>}
                          </div>
                        </div>
                        {cfgItems[i].tjm > 0
                          ? <div class="prop2-tjm"><strong>{euro(cfgItems[i].tjm)} €</strong><span>par jour</span></div>
                          : anyTjm && <div class="prop2-tjm"><strong class="p3-quote">Sur devis</strong></div>}
                      </div>
                      {it.note && <p class="prop2-note">{it.note}</p>}
                      {refs && (
                        <>
                          <p class="prop2-section-label">Ils ont travaillé avec</p>
                          {'chips' in refs
                            ? <ul class="chips">{refs.chips.map((r: string) => <li><span class="chip">{r}</span></li>)}</ul>
                            : <div class="prop2-refs-text" set:html={refs.html} />}
                        </>
                      )}
                      {p.cv_anonyme_url && (
                        <div class="doc-links">
                          <a href={p.cv_anonyme_url} target="_blank" rel="noopener">Consulter le CV détaillé</a>
                        </div>
                      )}
                    </article>
                  );
                })}
              </div>
            </section>
          </div>

          <aside class="prop3-side">
            {cfgItems.length > 0 && (
              <div class="prop3-budget">
                <div class="p3b-head"><span class="p3b-ico">🧮</span><div><strong>Budget estimé</strong><small>Mise à jour en temps réel</small></div></div>
                <strong class="p3b-total" id="cfg-total">{totalLabel}</strong>
                <span class="p3b-sub" id="cfg-total-sub">{subLabel}</span>
                <ul class="p3b-lines" id="cfg-lines">
                  {cfgItems.map((c, i) => (
                    <li data-bline={i}><span>Consultant {c.n}{c.role && ` · ${c.role}`}</span><strong>{c.tjm > 0 ? `${euro(c.tjm * c.days)} €` : 'sur devis'}</strong></li>
                  ))}
                </ul>
                <p class="p3b-note">ⓘ Estimation indicative, basée sur les rythmes proposés. Le périmètre exact est affiné ensemble avant démarrage.</p>
                <a class="btn p3b-cta" id="cfg-cta" href="#">Valider ces options <span aria-hidden="true">→</span></a>
              </div>
            )}
            <div class="prop3-help">
              <strong>Besoin d'aide&nbsp;?</strong>
              <p>Notre équipe vous accompagne pour affiner cette proposition — remplacer un profil, ajuster le périmètre ou le rythme.</p>
              <a href={`mailto:hello@digitags.work?subject=${encodeURIComponent('Proposition « ' + proposal.title + ' » — échangeons')}`}>Échanger avec nous →</a>
            </div>
          </aside>
        </div>
      </div>

      <section class="cta-navy" style="margin-bottom: 10px;">
        <div class="cta-copy">
          <p class="eyebrow">La suite&nbsp;?</p>
          <h2>Échangeons sur cette proposition</h2>
          <p>Nous organisons les entretiens avec les profils qui retiennent votre attention — le démarrage peut être rapide.</p>
        </div>
        <a href="mailto:hello@digitags.work" class="btn">Nous répondre <span aria-hidden="true">→</span></a>
      </section>

      <script define:vars={{ cfgItems, title: proposal.title }}>
        const start = document.getElementById('cfg-start');
        if (start && document.getElementById('cfg-total')) {
          const euro = (n) => n.toLocaleString('fr-FR', { maximumFractionDigits: 2 });
          const jours = (n) => euro(n) + ' jour' + (n >= 2 ? 's' : '');
          // Mêmes bornes que l'outil interne : 0,5 à 365 jours. null = saisie inexploitable.
          const parseDays = (v) => {
            const n = Number(String(v).replace(',', '.'));
            if (!Number.isFinite(n) || n <= 0) return null;
            return Math.min(365, Math.max(0.5, Math.round(n * 100) / 100));
          };
          const state = cfgItems.map((c) => ({ ...c, on: true }));

          const update = () => {
            let total = 0;
            let days = 0;
            let pricedDays = 0;
            let priced = 0;
            let quoted = 0;
            state.forEach((c, i) => {
              const line = c.tjm * c.days;
              if (c.on) {
                days += c.days;
                if (c.tjm > 0) { total += line; pricedDays += c.days; priced++; } else quoted++;
              }
              const lineText = c.tjm > 0 ? euro(line) + ' €' : 'sur devis';
              const lineEl = document.querySelector(`[data-line="${i}"]`);
              if (lineEl) lineEl.textContent = lineText;
              const bline = document.querySelector(`[data-bline="${i}"]`);
              if (bline) {
                bline.classList.toggle('off', !c.on);
                bline.querySelector('strong').textContent = c.on ? lineText : 'écarté';
              }
              const row = document.querySelector(`[data-row="${i}"]`);
              if (row) row.classList.toggle('off', !c.on);
            });
            // Budget = lignes chiffrées uniquement ; les lignes « sur devis » sont annoncées à part.
            const totalText = priced ? euro(total) + ' € HT' : (quoted ? 'Sur devis' : '0 € HT');
            const subText = !priced
              ? jours(days) + ' de mission' + (quoted ? ' — chiffrage sur devis' : '')
              : quoted
                ? 'pour ' + jours(pricedDays) + ' chiffré' + (pricedDays >= 2 ? 's' : '') + ' · ' + quoted + ' profil' + (quoted > 1 ? 's' : '') + ' sur devis en sus'
                : 'pour ' + jours(days) + ' de mission';
            document.getElementById('cfg-total').textContent = totalText;
            document.getElementById('cfg-total-sub').textContent = subText;
            const daysTotal = document.getElementById('cfg-days-total');
            if (daysTotal) daysTotal.textContent = euro(days);

            const d = start.value
              ? new Date(start.value).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' })
              : 'à définir';
            // Corps du mail en texte clair, encodé UNE seule fois à la fin : un rôle
            // contenant « & » ou « # » ne tronque plus le message.
            const lines = state.filter((c) => c.on).map((c) =>
              '• Consultant ' + c.n + (c.role ? ' (' + c.role + ')' : '') + ' : ' + jours(c.days)
              + (c.tjm > 0 ? ' × ' + euro(c.tjm) + ' €' : ' — sur devis'));
            const body = [
              'Bonjour,',
              '',
              'Nous souhaitons avancer sur votre proposition « ' + title + ' » avec les options suivantes :',
              '',
              '• Démarrage souhaité : ' + d,
              ...lines,
              '• Charge totale : ' + jours(days),
              '• Budget estimé : ' + totalText + (priced && quoted ? ' (hors ' + quoted + ' profil' + (quoted > 1 ? 's' : '') + ' sur devis)' : ''),
              '',
              '',
            ].join('\r\n');
            document.getElementById('cfg-cta').href = 'mailto:hello@digitags.work?subject='
              + encodeURIComponent('Proposition « ' + title + ' » — nos options')
              + '&body=' + encodeURIComponent(body);
          };

          start.addEventListener('input', update);
          document.querySelectorAll('.p3-days').forEach((inp, i) => {
            // Pendant la frappe : on ne recalcule que sur une valeur exploitable.
            inp.addEventListener('input', () => {
              const n = parseDays(inp.value);
              if (n === null) return;
              if (n < Number(inp.value)) inp.value = n; // au-delà de 365 : ramené tout de suite
              state[i].days = n;
              update();
            });
            // En sortie de champ : la valeur affichée est toujours celle du calcul.
            inp.addEventListener('change', () => { inp.value = state[i].days; });
          });
          document.querySelectorAll('[data-x]').forEach((btn) => btn.addEventListener('click', () => {
            const i = Number(btn.dataset.x);
            state[i].on = !state[i].on;
            btn.textContent = state[i].on ? '×' : '+';
            btn.title = state[i].on ? 'Écarter ce profil de l\'estimation' : 'Réintégrer ce profil';
            update();
          }));
          update();
        }
      </script>

      <footer class="prop2-footer">
        <span class="logo">
          <img src="/assets/logo-mark.svg" alt="" class="logo-mark" />
        </span>
        <p>Proposition préparée par digitags.work — le hub de plus de 1 600 talents digitaux vérifiés.<br />
        Les coordonnées complètes des talents sont communiquées lors de l'entretien organisé par digitags.work.</p>
      </footer>
    </>
  ) : (
    <div class="container" style="padding: 90px 24px; text-align: center; max-width: 560px;">
      <p class="eyebrow">Proposition</p>
      <h1 style="font-size: 28px; font-weight: 800; margin: 10px 0 14px;">Ce lien n'est plus valide.</h1>
