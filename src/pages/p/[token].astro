---
// Page propale privée, accessible uniquement via son lien à jeton.
// Rendue à la demande côté serveur (clé service_role, jamais exposée).
// Document commercial autonome (sans la navigation du site).
// Anonymisation anti-contournement : « Consultant N » (le nom n'est même
// pas requêté), avatar générique, CV anonymisé uniquement, pas de lien
// portfolio, pas d'email ni de notes internes.
export const prerender = false;

import '../../styles/global.css';

const { token } = Astro.params;
const runtimeEnv = (Astro.locals as any)?.runtime?.env ?? {};
const url = runtimeEnv.SUPABASE_URL ?? import.meta.env.SUPABASE_URL;
const key = runtimeEnv.SUPABASE_SERVICE_KEY ?? import.meta.env.SUPABASE_SERVICE_KEY;

async function rest(path: string) {
  const res = await fetch(`${url}/rest/v1/${path}`, {
    headers: { apikey: key, Authorization: `Bearer ${key}` },
  });
  return res.ok ? res.json() : [];
}

let proposal: any = null;
let items: any[] = [];

if (url && key && token && /^[a-f0-9]{16,64}$/.test(token)) {
  const props = await rest(`proposals?select=id,title,client_name,intro,created_at,start_date,duration_weeks&token=eq.${token}&archived=eq.false&limit=1`);
  proposal = props[0] ?? null;
  if (proposal) {
    items = await rest(`proposal_items?select=role_label,tjm,note,sort,days_week,profiles(job,experience,stars,fluent_english,reference_html,cv_anonyme_url)&proposal_id=eq.${proposal.id}&order=sort`);
  }
}

if (!proposal) {
  Astro.response.status = 404;
}
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');

// Avatars génériques : silhouette blanche sur hexagone, couleurs de la
// marque en rotation pour différencier les consultants d'un coup d'œil.
const AVA_COLORS = ['#2b46f0', '#f5b731', '#f2543d', '#111c3f'];

// Références rich-text → liste de clients (chips) si les lignes sont courtes.
const strip = (h: string) => h
  .replace(/<[^>]+>/g, '')
  .replace(/&nbsp;/g, ' ')
  .replace(/&amp;/g, '&')
  .replace(/&#39;|&apos;/g, "'")
  .replace(/&quot;/g, '"')
  .replace(/\s+/g, ' ')
  .trim();
const refLines = (html?: string) => {
  if (!html) return null;
  const lines = html
    .split(/<\/p>|<\/li>|<br\s*\/?>/i)
    .map((l) => strip(l))
    .filter(Boolean);
  if (lines.length === 0) return null;
  return lines.every((l) => l.length <= 45) ? { chips: lines } : { html };
};

const allTjm = items.length > 0 && items.every((it) => Number(it.tjm) > 0);
const dateFmt = proposal
  ? new Date(proposal.created_at).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' })
  : '';

const defaultWeeks = proposal?.duration_weeks ?? 4;
const defaultStart = proposal?.start_date ?? new Date(Date.now() + 14 * 864e5).toISOString().slice(0, 10);
const euro = (n: number) => n.toLocaleString('fr-FR');

// Données du configurateur (aucun nom : « Consultant N »).
const cfgItems = items.map((it, i) => ({
  n: i + 1,
  role: it.role_label ?? it.profiles.job ?? 'Consultant',
  tjm: Number(it.tjm) || 0,
  days: Number(it.days_week) || 5,
}));
const weeklyBudget = cfgItems.reduce((s, c) => s + c.tjm * c.days, 0);
---
<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{proposal ? `Proposition — ${proposal.title}` : 'Proposition introuvable'} | digitags.work</title>
  <meta name="robots" content="noindex, nofollow" />
  <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml" />
  <link rel="preload" href="/assets/fonts/pjs-400.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/assets/fonts/pjs-800.woff2" as="font" type="font/woff2" crossorigin />
</head>
<body>
  {proposal ? (
    <>
      <header class="prop3-hero">
        <div class="container">
          <div class="prop2-topbar">
            <span class="logo logo-light">
              <img src="/assets/logo-mark.svg" alt="" class="logo-mark" />
              <span class="logo-text" style="color:#fff;">digitags<span class="logo-tld">.work</span></span>
            </span>
            <span class="tag">Confidentiel</span>
          </div>
          <div class="prop3-hero-grid">
            <div>
              <p class="eyebrow">Proposition d'équipe{proposal.client_name && ` — pour ${proposal.client_name}`}</p>
              <h1>Constituez votre équipe sur-mesure</h1>
              <p class="intro">{proposal.intro ?? 'Sélectionnez les bons talents, ajustez les dates et la durée. Le budget se met à jour en temps réel.'}</p>
              <p class="meta">« {proposal.title} » · Préparée le {dateFmt} · Réservée à son destinataire — merci de ne pas la diffuser.</p>
            </div>
            <div class="prop3-illu" aria-hidden="true">
              {['Product', 'UX/UI', 'Data'].map((lbl, i) => (
                <div class={`p3i-card c${i}`}>
                  <svg viewBox="0 0 86 86" width="46" height="46">
                    <polygon points="43,4 78,23.5 78,62.5 43,82 8,62.5 8,23.5" fill={AVA_COLORS[i % AVA_COLORS.length]} />
                    <circle cx="43" cy="36" r="11" fill="#fff" opacity="0.92" />
                    <path d="M24 66c2.5-12 9.5-18 19-18s16.5 6 19 18v2H24z" fill="#fff" opacity="0.92" />
                  </svg>
                  <em>{lbl}</em>
                </div>
              ))}
            </div>
          </div>
        </div>
      </header>

      <div class="container">
        <ol class="prop3-steps">
          <li class="on"><span class="ps-num">1</span><div><strong>Mission</strong><small>Dates et durée</small></div></li>
          <li><span class="ps-num">2</span><div><strong>Talents</strong><small>Votre équipe proposée</small></div></li>
          <li><span class="ps-num">3</span><div><strong>Validation</strong><small>Détails et options</small></div></li>
          <li><span class="ps-num">4</span><div><strong>Envoi</strong><small>On démarre ensemble</small></div></li>
        </ol>

        <div class="prop3-layout">
          <div class="prop3-main">

            <section class="prop3-card">
              <div class="prop3-card-head">
                <span class="p3-ico">📅</span>
                <div>
                  <h2>1. Votre mission, à votre mesure</h2>
                  <p>Ajustez le démarrage et la durée : le budget se recalcule instantanément.</p>
                </div>
              </div>
              <div class="prop3-config-fields">
                <label>Démarrage souhaité
                  <input type="date" id="cfg-start" value={defaultStart} />
                </label>
                <label>Durée de la mission
                  <span class="cfg-weeks-wrap"><input type="number" id="cfg-weeks" value={defaultWeeks} min="1" max="52" /> semaines</span>
                </label>
                <div class="cfg-week-chips" role="group" aria-label="Durées proposées">
                  {[2, 4, 8, 12].map((w) => (
                    <button type="button" class={`wk-chip ${w === defaultWeeks ? 'on' : ''}`} data-wk={w}>{w} sem</button>
                  ))}
                </div>
              </div>
            </section>

            <section class="prop3-card">
              <div class="prop3-card-head">
                <span class="p3-ico">👥</span>
                <div>
                  <h2>2. Talents sélectionnés</h2>
                  <p>{items.length} profil{items.length > 1 ? 's' : ''} pour ce projet{allTjm ? ' · Vous pouvez ajuster la charge (jours/sem) ou écarter un profil.' : ''}</p>
                </div>
              </div>
              <div class="prop3-rows">
                {items.map((it, i) => {
                  const p = it.profiles;
                  const refs = refLines(p.reference_html);
                  const refChips = refs && 'chips' in refs ? refs.chips : [];
                  return (
                    <div class="prop3-row" data-row={i}>
                      <span class="p3-ava" aria-hidden="true">
                        <svg viewBox="0 0 86 86" width="48" height="48">
                          <polygon points="43,4 78,23.5 78,62.5 43,82 8,62.5 8,23.5" fill={AVA_COLORS[i % AVA_COLORS.length]} />
                          <circle cx="43" cy="36" r="11" fill="#fff" opacity="0.92" />
                          <path d="M24 66c2.5-12 9.5-18 19-18s16.5 6 19 18v2H24z" fill="#fff" opacity="0.92" />
                        </svg>
                      </span>
                      <div class="p3-id">
                        <strong>Consultant {i + 1}</strong>
                        <span class="p3-role">{it.role_label ?? p.job}</span>
                        <span class="p3-badges">
                          {p.experience && <span class="badge">{p.experience}</span>}
                          {p.stars > 0 && p.stars <= 5 && <span class="badge star">★ {p.stars}</span>}
                          {p.fluent_english && <span class="badge en">Anglais courant</span>}
                        </span>
                        {refChips.length > 0 && (
                          <span class="p3-refs">
                            <em>A travaillé avec</em>
                            {refChips.slice(0, 4).map((r: string) => <span class="p3-ref">{r}</span>)}
                            {refChips.length > 4 && <span class="p3-ref p3-ref-more">+{refChips.length - 4}</span>}
                          </span>
                        )}
                      </div>
                      {allTjm && (
                        <>
                          <div class="p3-cell">
                            <label>TJM</label>
                            <span class="p3-tjm">{euro(Number(it.tjm))} €</span>
                          </div>
                          <div class="p3-cell">
                            <label for={`days-${i}`}>Jours / sem</label>
                            <input type="number" id={`days-${i}`} class="p3-days" value={Number(it.days_week) || 5} min="0.5" max="5" step="0.5" />
                          </div>
                          <strong class="p3-line" data-line={i}>{euro((Number(it.tjm) || 0) * (Number(it.days_week) || 5))} €/sem</strong>
                          <button type="button" class="p3-x" data-x={i} title="Écarter ce profil de l'estimation">×</button>
                        </>
                      )}
                    </div>
                  );
                })}
              </div>
            </section>

            <section class="prop3-card">
              <div class="prop3-card-head">
                <span class="p3-ico">🔎</span>
                <div>
                  <h2>3. Les profils en détail</h2>
                  <p>Références et CV anonymisés — les coordonnées complètes sont communiquées lors de l'entretien.</p>
                </div>
              </div>
              <div class="prop2-list">
                {items.map((it, i) => {
                  const p = it.profiles;
                  const refs = refLines(p.reference_html);
                  return (
                    <article class="prop2-card">
                      <div class="prop2-head">
                        <span class="num-badge">{String(i + 1).padStart(2, '0')}</span>
                        <span class="prop2-ava" aria-hidden="true">
                          <svg viewBox="0 0 86 86" width="72" height="72">
                            <polygon points="43,4 78,23.5 78,62.5 43,82 8,62.5 8,23.5" fill={AVA_COLORS[i % AVA_COLORS.length]} />
                            <circle cx="43" cy="36" r="11" fill="#fff" opacity="0.92" />
                            <path d="M24 66c2.5-12 9.5-18 19-18s16.5 6 19 18v2H24z" fill="#fff" opacity="0.92" />
                          </svg>
                        </span>
                        <div>
                          <h2>Consultant {i + 1}</h2>
                          <p class="role">{it.role_label ?? p.job}</p>
                          <div class="badges">
                            {p.experience && <span class="badge">{p.experience}</span>}
                            {p.stars > 0 && p.stars <= 5 && <span class="badge star">★ {p.stars} — note du Hub</span>}
                            {p.fluent_english && <span class="badge">Anglais courant</span>}
                          </div>
                        </div>
                        {it.tjm && <div class="prop2-tjm"><strong>{Number(it.tjm).toLocaleString('fr-FR')} €</strong><span>par jour</span></div>}
                      </div>
                      {it.note && <p class="prop2-note">{it.note}</p>}
                      {refs && (
                        <>
                          <p class="prop2-section-label">Ils ont travaillé avec</p>
                          {'chips' in refs
                            ? <ul class="chips">{refs.chips.map((r: string) => <li><span class="chip">{r}</span></li>)}</ul>
                            : <div class="prop2-refs-text" set:html={refs.html} />}
                        </>
                      )}
                      {p.cv_anonyme_url && (
                        <div class="doc-links">
                          <a href={p.cv_anonyme_url} target="_blank" rel="noopener">Consulter le CV détaillé</a>
                        </div>
                      )}
                    </article>
                  );
                })}
              </div>
            </section>
          </div>

          <aside class="prop3-side">
            {allTjm && weeklyBudget > 0 && (
              <div class="prop3-budget">
                <div class="p3b-head"><span class="p3b-ico">🧮</span><div><strong>Budget estimé</strong><small>Mise à jour en temps réel</small></div></div>
                <strong class="p3b-total" id="cfg-total">{euro(weeklyBudget * defaultWeeks)} € HT</strong>
                <span class="p3b-sub" id="cfg-total-sub">pour {defaultWeeks} semaines</span>
                <ul class="p3b-lines" id="cfg-lines">
                  {cfgItems.map((c, i) => (
                    <li data-bline={i}><span>Consultant {c.n} · {c.role}</span><strong>{euro(c.tjm * c.days * defaultWeeks)} €</strong></li>
                  ))}
                </ul>
                <p class="p3b-note">ⓘ Estimation indicative, basée sur les rythmes proposés. Le périmètre exact est affiné ensemble avant démarrage.</p>
                <a class="btn p3b-cta" id="cfg-cta" href="#">Valider ces options <span aria-hidden="true">→</span></a>
              </div>
            )}
            <div class="prop3-help">
              <strong>Besoin d'aide&nbsp;?</strong>
              <p>Notre équipe vous accompagne pour affiner cette proposition — remplacer un profil, ajuster le périmètre ou le rythme.</p>
              <a href={`mailto:hello@digitags.work?subject=${encodeURIComponent('Proposition « ' + proposal.title + ' » — échangeons')}`}>Échanger avec nous →</a>
            </div>
          </aside>
        </div>
      </div>

      <section class="cta-navy" style="margin-bottom: 10px;">
        <div class="cta-copy">
          <p class="eyebrow">La suite&nbsp;?</p>
          <h2>Échangeons sur cette proposition</h2>
          <p>Nous organisons les entretiens avec les profils qui retiennent votre attention — le démarrage peut être rapide.</p>
        </div>
        <a href="mailto:hello@digitags.work" class="btn">Nous répondre <span aria-hidden="true">→</span></a>
      </section>

      <script define:vars={{ cfgItems, title: proposal.title }}>
        const weeks = document.getElementById('cfg-weeks');
        const start = document.getElementById('cfg-start');
        if (weeks && start && document.getElementById('cfg-total')) {
          const euro = (n) => n.toLocaleString('fr-FR');
          const state = cfgItems.map((c) => ({ ...c, on: true }));

          const update = () => {
            const w = Math.max(1, Math.min(52, Number(weeks.value) || 1));
            let weekly = 0;
            state.forEach((c, i) => {
              const line = c.on ? c.tjm * c.days : 0;
              weekly += line;
              const lineEl = document.querySelector(`[data-line="${i}"]`);
              if (lineEl) lineEl.textContent = euro(c.tjm * c.days) + ' €/sem';
              const bline = document.querySelector(`[data-bline="${i}"]`);
              if (bline) {
                bline.classList.toggle('off', !c.on);
                bline.querySelector('strong').textContent = c.on ? euro(line * w) + ' €' : 'écarté';
              }
              const row = document.querySelector(`[data-row="${i}"]`);
              if (row) row.classList.toggle('off', !c.on);
            });
            document.getElementById('cfg-total').textContent = euro(weekly * w) + ' € HT';
            document.getElementById('cfg-total-sub').textContent = 'pour ' + w + ' semaine' + (w > 1 ? 's' : '');
            document.querySelectorAll('.wk-chip').forEach((ch) => ch.classList.toggle('on', Number(ch.dataset.wk) === w));

            const d = start.value
              ? new Date(start.value).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' })
              : 'à définir';
            const picked = state.filter((c) => c.on);
            const lines = picked.map((c) => '• Consultant ' + c.n + ' (' + c.role + ') : ' + c.days + ' j/sem').join('%0D%0A');
            const body = 'Bonjour,%0D%0A%0D%0ANous souhaitons avancer sur votre proposition « ' + encodeURIComponent(title) + ' » avec les options suivantes :%0D%0A%0D%0A• Démarrage souhaité : ' + encodeURIComponent(d) + '%0D%0A• Durée : ' + w + ' semaine' + (w > 1 ? 's' : '') + '%0D%0A' + lines + '%0D%0A• Budget estimé : ' + encodeURIComponent(euro(weekly * w)) + ' € HT%0D%0A%0D%0A';
            document.getElementById('cfg-cta').href = 'mailto:hello@digitags.work?subject=' + encodeURIComponent('Proposition « ' + title + ' » — nos options') + '&body=' + body;
          };

          weeks.addEventListener('input', update);
          start.addEventListener('input', update);
          document.querySelectorAll('.wk-chip').forEach((ch) => ch.addEventListener('click', () => { weeks.value = ch.dataset.wk; update(); }));
          document.querySelectorAll('.p3-days').forEach((inp, i) => inp.addEventListener('input', () => {
            state[i].days = Math.max(0.5, Math.min(5, Number(inp.value) || 0));
            update();
          }));
          document.querySelectorAll('[data-x]').forEach((btn) => btn.addEventListener('click', () => {
            const i = Number(btn.dataset.x);
            state[i].on = !state[i].on;
            btn.textContent = state[i].on ? '×' : '+';
            btn.title = state[i].on ? 'Écarter ce profil de l\'estimation' : 'Réintégrer ce profil';
            update();
          }));
          update();
        }
      </script>

      <footer class="prop2-footer">
        <span class="logo">
          <img src="/assets/logo-mark.svg" alt="" class="logo-mark" />
        </span>
        <p>Proposition préparée par digitags.work — le hub de plus de 1 600 talents digitaux vérifiés.<br />
        Les coordonnées complètes des talents sont communiquées lors de l'entretien organisé par digitags.work.</p>
      </footer>
    </>
  ) : (
    <div class="container" style="padding: 90px 24px; text-align: center; max-width: 560px;">
      <p class="eyebrow">Proposition</p>
      <h1 style="font-size: 28px; font-weight: 800; margin: 10px 0 14px;">Ce lien n'est plus valide.</h1>
      <p style="color: var(--ink-soft);">Cette proposition n'existe pas ou a été archivée. Contactez votre interlocuteur digitags.work pour recevoir un nouveau lien.</p>
    </div>
  )}
</body>
</html>
