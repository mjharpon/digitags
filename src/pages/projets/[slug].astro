---
// Fiches projets françaises. Le template (parseur de sections, rendu, libellés)
// est factorisé dans src/components/FicheProjet.astro, partagé avec /en/projects/.
import { getCollection } from 'astro:content';
import FicheProjet from '../../components/FicheProjet.astro';

export async function getStaticPaths() {
  const fiches = await getCollection('projets', ({ data }) => !data.draft);
  return fiches.map((fiche) => ({ params: { slug: fiche.id }, props: { fiche } }));
}

const { fiche } = Astro.props;
---
<FicheProjet fiche={fiche} lang="fr" />
