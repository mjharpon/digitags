---
// Template commun des articles de blog FR (/blog/<slug>) et EN (/en/blog/<slug>).
// Factorisation de src/pages/blog/[slug].astro : même markup, libellés et
// maillage selon la langue. Côté EN : pas de pages tags (tags affichés en
// texte), maillage vers les fiches /en/roles/ et les articles blog-en.
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import CtaBanner from './CtaBanner.astro';
import Breadcrumb from './Breadcrumb.astro';
import { tagLabelEn } from '../lib/i18n';

interface Props { post: any; lang?: 'fr' | 'en' }
const { post, lang = 'fr' } = Astro.props;
const en = lang === 'en';

const { Content } = await render(post);
const dateFmt = post.data.date?.toLocaleDateString(en ? 'en-GB' : 'fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });

// Maillage interne automatique — priorité aux fiches métiers.
// Les tags du blog et le blogCategory des fiches partagent la même taxonomie.
const metiersCollection = en ? 'metiers-en' : 'metiers';
const metiers = await getCollection(metiersCollection as 'metiers', ({ data }) => !data.draft);
const relatedMetiers = metiers
  .filter((m) => m.data.blogCategory && post.data.tags.includes(m.data.blogCategory))
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99))
  .slice(0, 3);

// Articles liés : même tag principal, les plus récents, sinon derniers articles.
const blogCollection = en ? 'blog-en' : 'blog';
const allPosts = (await getCollection(blogCollection as 'blog', ({ data }) => !data.draft))
  .filter((p) => p.id !== post.id)
  .sort((a, b) => (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0));
const sameTag = allPosts.filter((p) => p.data.tags.some((t) => post.data.tags.includes(t)));
const relatedPosts = [...sameTag, ...allPosts.filter((p) => !sameTag.includes(p))].slice(0, 3);

const t = en
  ? {
      crumbs: [{ label: 'Blog', href: '/en/blog' }, { label: post.data.title }],
      eyebrow: 'The Hub blog',
      actionEyebrow: "Take action",
      expertsTitle: 'The freelance experts on this topic',
      expertHref: (id: string) => `/en/roles/${id}`,
      expertCta: 'Discover the role',
      nextTitle: 'Read next',
      postHref: (id: string) => `/en/blog/${id}`,
      readCta: 'Read the article',
    }
  : {
      crumbs: [{ label: 'Blog', href: '/blog' }, { label: post.data.title }],
      eyebrow: 'Le blog du Hub',
      actionEyebrow: "Passer à l'action",
      expertsTitle: 'Les experts freelances sur ce sujet',
      expertHref: (id: string) => `/metiers/${id}`,
      expertCta: 'Découvrir le métier',
      nextTitle: 'À lire ensuite',
      postHref: (id: string) => `/blog/${id}`,
      readCta: "Lire l'article",
    };
---
<Base title={`${post.data.title} | digitags.work`} description={post.data.description}>
  <article>
    <section class="page-hero" style="padding-bottom: 36px;">
      <div class="container">
        <Breadcrumb lang={lang} items={t.crumbs} />
        <p class="eyebrow">{t.eyebrow}</p>
        <h1>{post.data.title}</h1>
        <p class="post-meta">
          {dateFmt && <span>{dateFmt}</span>}
          {en
            ? post.data.tags.map((tg: string) => <span class="post-tag">#{tagLabelEn(tg)}</span>)
            : post.data.tags.map((tg: string) => <a href={`/tag/${tg}`} class="post-tag">#{tg}</a>)}
        </p>
      </div>
    </section>
    <div class="container prose">
      <Content />
    </div>
  </article>

  {relatedMetiers.length > 0 && (
    <section class="rel-section">
      <div class="container">
        <p class="eyebrow">{t.actionEyebrow}</p>
        <h2 class="rel-title">{t.expertsTitle}</h2>
        <div class="rel-grid">
          {relatedMetiers.map((m) => (
            <article class="rel-card rel-card-metier">
              <h3><a href={t.expertHref(m.id)} class="stretch-link">{m.data.title}</a></h3>
              {m.data.description && <p>{m.data.description.slice(0, 130)}…</p>}
              <span class="arrow-link">{t.expertCta} <span aria-hidden="true">→</span></span>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  {relatedPosts.length > 0 && (
    <section class="rel-section">
      <div class="container">
        <h2 class="rel-title">{t.nextTitle}</h2>
        <div class="rel-grid">
          {relatedPosts.map((p) => (
            <article class="rel-card">
              <h3><a href={t.postHref(p.id)} class="stretch-link">{p.data.title}</a></h3>
              {p.data.description && <p>{p.data.description.slice(0, 130)}…</p>}
              <span class="arrow-link">{t.readCta} <span aria-hidden="true">→</span></span>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <CtaBanner lang={lang} />
</Base>
