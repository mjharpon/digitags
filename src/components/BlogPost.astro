---
// Template commun des articles de blog FR (/blog/<slug>) et EN (/en/blog/<slug>).
// Factorisation de src/pages/blog/[slug].astro : même markup, libellés et
// maillage selon la langue. Côté EN : pas de pages tags (tags affichés en
// texte), maillage vers les fiches /en/roles/ et les articles blog-en.
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import CtaBanner from './CtaBanner.astro';
import Breadcrumb from './Breadcrumb.astro';
import { tagLabelEn } from '../lib/i18n';
import { byOrder } from '../lib/sort';
import { ogCoverPath } from '../lib/og.mjs';
import { relatedPostsMap } from '../lib/related';

// Page expertise associée au sujet de l'article (premier tag « métier » trouvé).
const SERVICES: Record<string, { fr: [string, string]; en: [string, string] }> = {
  design: { fr: ['/design', 'Design & UX'], en: ['/en/design', 'Design & UX'] },
  'tech-et-data': { fr: ['/tech-data', 'Tech & Data'], en: ['/en/tech-and-data', 'Tech & Data'] },
  product: { fr: ['/product-et-project', 'Product & Projet'], en: ['/en/product-and-project', 'Product & Project'] },
  webmarketing: { fr: ['/sea-social-ads-seo', 'Marketing & Acquisition'], en: ['/en/digital-marketing', 'Marketing & Acquisition'] },
};

interface Props { post: any; lang?: 'fr' | 'en' }
const { post, lang = 'fr' } = Astro.props;
const en = lang === 'en';

const { Content } = await render(post);
const dateFmt = post.data.date?.toLocaleDateString(en ? 'en-GB' : 'fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });

// Maillage interne automatique — priorité aux fiches métiers.
// Les tags du blog et le blogCategory des fiches partagent la même taxonomie.
const metiersCollection = en ? 'metiers-en' : 'metiers';
const metiers = await getCollection(metiersCollection as 'metiers', ({ data }) => !data.draft);
const relatedMetiers = metiers
  .filter((m) => m.data.blogCategory && post.data.tags.includes(m.data.blogCategory))
  .sort(byOrder)
  .slice(0, 3);

// Articles liés : calculés par pertinence et équilibrés (voir src/lib/related.ts).
const blogCollection = en ? 'blog-en' : 'blog';
const allPosts = await getCollection(blogCollection as 'blog', ({ data }) => !data.draft);
const relatedIds = (await relatedPostsMap(blogCollection)).get(post.id) ?? [];
const relatedPosts = relatedIds.map((id) => allPosts.find((p) => p.id === id)!).filter(Boolean);
const serviceTag = post.data.tags.find((tg: string) => SERVICES[tg]);
const service = serviceTag ? SERVICES[serviceTag][en ? 'en' : 'fr'] : undefined;

const t = en
  ? {
      crumbs: [{ label: 'Blog', href: '/en/blog' }, { label: post.data.title }],
      eyebrow: 'The Hub blog',
      actionEyebrow: "Take action",
      expertsTitle: 'The freelance experts on this topic',
      expertHref: (id: string) => `/en/roles/${id}`,
      expertCta: 'Discover the role',
      nextTitle: 'Read next',
      postHref: (id: string) => `/en/blog/${id}`,
      readCta: 'Read the article',
    }
  : {
      crumbs: [{ label: 'Blog', href: '/blog' }, { label: post.data.title }],
      eyebrow: 'Le blog du Hub',
      actionEyebrow: "Passer à l'action",
      expertsTitle: 'Les experts freelances sur ce sujet',
      expertHref: (id: string) => `/metiers/${id}`,
      expertCta: 'Découvrir le métier',
      nextTitle: 'À lire ensuite',
      postHref: (id: string) => `/blog/${id}`,
      readCta: "Lire l'article",
    };

// Données structurées de l'article. L'éditeur (et auteur, les articles n'étant pas
// signés) renvoie à l'Organization déclarée dans Base.astro par son @id.
const ORG_ID = 'https://www.digitags.work/#organization';
const postUrl = new URL(t.postHref(post.id), Astro.site).href;
const articleJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "@id": `${postUrl}#article`,
  headline: post.data.title,
  ...(post.data.description ? { description: post.data.description } : {}),
  ...(post.data.date ? { datePublished: post.data.date.toISOString() } : {}),
  image: new URL(post.data.image ?? '/assets/og-default.png', Astro.site).href,
  inLanguage: lang,
  url: postUrl,
  mainEntityOfPage: { "@type": "WebPage", "@id": postUrl },
  ...(post.data.tags.length ? { keywords: post.data.tags.map((tg: string) => (en ? tagLabelEn(tg) : tg)).join(', ') } : {}),
  author: { "@id": ORG_ID },
  publisher: { "@id": ORG_ID },
});
---
<Base title={`${post.data.title} | digitags.work`} description={post.data.description} image={post.data.image && ogCoverPath(post.data.image)} ogType="article">
  <script type="application/ld+json" set:html={articleJsonLd} />
  <article>
    <section class="page-hero" style="padding-bottom: 36px;">
      <div class="container">
        <Breadcrumb lang={lang} items={t.crumbs} />
        <p class="eyebrow">{t.eyebrow}</p>
        <h1>{post.data.title}</h1>
        <p class="post-meta">
          {dateFmt && <span>{dateFmt}</span>}
          {en
            ? post.data.tags.map((tg: string) => <span class="post-tag">#{tagLabelEn(tg)}</span>)
            : post.data.tags.map((tg: string) => <a href={`/tag/${tg}`} class="post-tag">#{tg}</a>)}
        </p>
      </div>
    </section>
    <div class="container prose">
      <Content />
    </div>
  </article>

  {relatedMetiers.length > 0 && (
    <section class="rel-section">
      <div class="container">
        <p class="eyebrow">{t.actionEyebrow}</p>
        <h2 class="rel-title">{t.expertsTitle}</h2>
        <div class="rel-grid">
          {relatedMetiers.map((m) => (
            <article class="rel-card rel-card-metier">
              <h3><a href={t.expertHref(m.id)} class="stretch-link">{m.data.title}</a></h3>
              {m.data.description && <p>{m.data.description.slice(0, 130)}…</p>}
              <span class="arrow-link">{t.expertCta} <span aria-hidden="true">→</span></span>
            </article>
          ))}
        </div>
        {service && (
          <p class="rel-service"><a href={service[0]} class="arrow-link">{en ? `All our ${service[1]} expertise` : `Toute l'expertise ${service[1]}`} <span aria-hidden="true">→</span></a></p>
        )}
      </div>
    </section>
  )}

  {relatedPosts.length > 0 && (
    <section class="rel-section">
      <div class="container">
        <h2 class="rel-title">{t.nextTitle}</h2>
        <div class="rel-grid">
          {relatedPosts.map((p) => (
            <article class="rel-card">
              <h3><a href={t.postHref(p.id)} class="stretch-link">{p.data.title}</a></h3>
              {p.data.description && <p>{p.data.description.slice(0, 130)}…</p>}
              <span class="arrow-link">{t.readCta} <span aria-hidden="true">→</span></span>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <CtaBanner lang={lang} />
</Base>
