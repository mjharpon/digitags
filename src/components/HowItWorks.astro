---
// Dark "Notre approche" section: positioning + 3 steps + team card.
// Bilingue : lang="en" sert la version anglaise (défaut : fr, inchangé).
const { lang = 'fr' } = Astro.props;

const T = lang === 'en'
  ? {
      title: ['Not a marketplace.', 'A hand-picked collective.'],
      introA: 'Neither a platform nor a staffing firm: a closed network of 1,600+ freelancers and ',
      studiosHref: '/en/studios-and-collectives',
      studiosLabel: '10 independent studios',
      introB: ', vetted and recommended by their peers. We stay by your side from first brief to final delivery, to guarantee the right match and the success of your project.',
      steps: [
        {
          title: 'You brief the Hub',
          text: 'Tell us what you need through the form. We call you back promptly to frame the stakes, goals and constraints.',
        },
        {
          title: 'We reach out to the right profiles',
          text: 'We put your project to the best-suited experts and studios in the network, then share the ones who are in — with their terms.',
        },
        {
          title: 'You meet, you start',
          text: "We set up the interview with your shortlisted talent. If it clicks, the project starts — with our follow-up all the way through.",
        },
      ],
      teamTitle: 'Project team',
      teamMeta: 'Acquisition & Conversion',
      teamCta: 'Build my team',
      contactHref: '/en/contact',
      alts: ['Paid Media expert', 'CRO expert', 'Data & Tracking expert'],
    }
  : {
      title: ['Pas une marketplace.', 'Un collectif sélectionné.'],
      introA: 'Ni une plateforme, ni une ESN : un réseau fermé de plus de 1 600 freelances et ',
      studiosHref: '/studios-et-collectifs',
      studiosLabel: '10 studios indépendants',
      introB: ', vérifiés et recommandés par leurs pairs. Nous vous accompagnons de bout en bout pour garantir le bon match et la réussite de votre projet.',
      steps: [
        {
          title: 'Vous briefez le Hub',
          text: 'Vous décrivez votre besoin via le formulaire. Nous vous rappelons dans la foulée pour cadrer les enjeux, objectifs et contraintes.',
        },
        {
          title: 'Nous sollicitons les bons profils',
          text: 'Nous proposons votre projet aux meilleurs experts ou studios du réseau, et vous partageons ceux qui sont partants, avec leurs conditions.',
        },
        {
          title: 'Vous rencontrez, vous démarrez',
          text: "Nous organisons l'entretien avec les talents retenus. Si le fit passe, le projet démarre — avec notre suivi jusqu'au bout.",
        },
      ],
      teamTitle: 'Équipe projet',
      teamMeta: 'Acquisition & Conversion',
      teamCta: 'Composer mon équipe',
      contactHref: '/contact',
      alts: ['Experte Paid Media', 'Expert CRO', 'Expert Data & Tracking'],
    };

const hexes = ['hex-icon-blue', 'hex-icon-yellow', 'hex-icon-red'];
---
<section class="approche" id="approche">
  <div class="container approche-grid">
    <div class="approche-copy">
      <h2>{T.title[0]}<br />{T.title[1]}</h2>
      <p>{T.introA}<a href={T.studiosHref} class="link-light">{T.studiosLabel}</a>{T.introB}</p>
      <div class="approche-shapes" aria-hidden="true">
        <span class="shape shape-blue"></span>
        <span class="shape shape-yellow"></span>
        <span class="shape shape-red"></span>
      </div>
    </div>
    <div class="approche-steps">
      <ol class="steps">
        {T.steps.map((s, i) => (
          <li class="step">
            <span class={`hex-icon ${hexes[i]}`}></span>
            <span class="step-num">0{i + 1}.</span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
            {i < 2 && <span class="step-arrow" aria-hidden="true">→</span>}
          </li>
        ))}
      </ol>

      <div class="team-card">
        <div class="team-meta">
          <h4>{T.teamTitle}</h4>
          <p>{T.teamMeta}</p>
          <a href={T.contactHref} class="btn btn-ghost btn-sm">{T.teamCta}</a>
        </div>
        <div class="team-people">
          <figure>
            <img src="/assets/photos/talent-1.jpg" alt={T.alts[0]} width="110" height="130" loading="lazy" />
            <figcaption><span class="dot dot-blue"></span> Paid Media</figcaption>
          </figure>
          <figure>
            <img src="/assets/photos/talent-3.jpg" alt={T.alts[1]} width="110" height="130" loading="lazy" />
            <figcaption><span class="dot dot-yellow"></span> CRO</figcaption>
          </figure>
          <figure>
            <img src="/assets/photos/talent-5.jpg" alt={T.alts[2]} width="110" height="130" loading="lazy" />
            <figcaption><span class="dot dot-red"></span> Data &amp; Tracking</figcaption>
          </figure>
        </div>
      </div>
    </div>
  </div>
</section>
