---
import HowItWorks from './HowItWorks.astro';
import Testimonials from './Testimonials.astro';
import CtaBanner from './CtaBanner.astro';

interface Reussite {
  tag: string;
  title: string;
  points: string[];
}

interface Props {
  eyebrow: string;
  title: string;
  lead: string;
  ctaLabel?: string;
  skillsTitle: string;
  skills: string[];
  reussites: Reussite[];
  metiers?: { label: string; href: string }[];
  lang?: 'fr' | 'en';
}

const { eyebrow, title, lead, skillsTitle, skills, reussites, metiers, lang = 'fr' } = Astro.props;
const en = lang === 'en';
const { ctaLabel = en ? 'Tell us what you need' : 'Décrire mon besoin' } = Astro.props;

// Libellés et liens fixes de la page selon la langue.
const T = en
  ? {
      contactHref: '/en/contact',
      metiersHref: '/en/roles',
      exploreLabel: 'Explore the roles',
      fichesTitle: 'Role guides',
      reussitesTitle: 'Recent wins.',
    }
  : {
      contactHref: '/contact',
      metiersHref: '/metiers',
      exploreLabel: 'Explorer les métiers',
      fichesTitle: 'Nos fiches métiers',
      reussitesTitle: 'Nos dernières réussites.',
    };
---
<section class="page-hero">
  <div class="container">
    <p class="eyebrow">{eyebrow}</p>
    <h1 set:html={title} />
    <p class="lead">{lead}</p>
    <div class="hero-cta">
      <a href={T.contactHref} class="btn btn-dark">{ctaLabel}</a>
      <a href={T.metiersHref} class="btn btn-outline">{T.exploreLabel}</a>
    </div>
  </div>
</section>

<section class="skills-band">
  <div class="container">
    <h2>{skillsTitle}</h2>
    <ul class="chips">
      {skills.map((s) => <li><span class="chip">{s}</span></li>)}
    </ul>
    {metiers && metiers.length > 0 && (
      <>
        <h2 style="margin-top: 34px;">{T.fichesTitle}</h2>
        <ul class="chips">
          {metiers.map((m) => <li><a class="chip chip-link" href={m.href}>{m.label}</a></li>)}
        </ul>
      </>
    )}
  </div>
</section>

<HowItWorks lang={lang} />

<section class="section">
  <div class="container">
    <h2 class="section-title">{T.reussitesTitle}</h2>
    <div class={`reussites-grid${reussites.length === 2 ? ' cols-2' : ''}`}>
      {reussites.map((r) => (
        <article class="reussite-card">
          <p class="case-label label-blue">{r.tag}</p>
          <h3>{r.title}</h3>
          <ul>
            {r.points.map((p) => <li>{p}</li>)}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>

<Testimonials lang={lang} />

<CtaBanner lang={lang} />
