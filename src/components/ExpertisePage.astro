---
import HowItWorks from './HowItWorks.astro';
import Testimonials from './Testimonials.astro';
import CtaBanner from './CtaBanner.astro';
import { getCollection } from 'astro:content';

interface Reussite {
  tag: string;
  title: string;
  points: string[];
}

interface Props {
  eyebrow: string;
  title: string;
  lead: string;
  ctaLabel?: string;
  skillsTitle: string;
  skills: string[];
  reussites: Reussite[];
  metiers?: { label: string; href: string }[];
  lang?: 'fr' | 'en';
}

const { eyebrow, title, lead, skillsTitle, skills, reussites, metiers, lang = 'fr' } = Astro.props;
const en = lang === 'en';
const { ctaLabel = en ? 'Tell us what you need' : 'Décrire mon besoin' } = Astro.props;

// Les fiches métiers du pôle sont affichées en cartes (même style que le hub
// /metiers) : description et visuel viennent de la fiche elle-même, retrouvée
// par le dernier segment du lien.
const allFiches = metiers?.length ? await getCollection(en ? 'metiers-en' : 'metiers') : [];
const fiches = (metiers ?? []).map((m) => {
  const entry = allFiches.find((f) => f.id === m.href.split('/').pop());
  return { ...m, description: entry?.data.description, image: entry?.data.image };
});

// Libellés et liens fixes de la page selon la langue.
const T = en
  ? {
      contactHref: '/en/contact',
      metiersHref: '/en/roles',
      exploreLabel: 'Explore the roles',
      fichesTitle: 'Role guides',
      fichesEyebrow: 'Roles in this practice',
      moreLabel: 'Learn more',
      reussitesTitle: 'Recent wins.',
    }
  : {
      contactHref: '/contact',
      metiersHref: '/metiers',
      exploreLabel: 'Explorer les métiers',
      fichesTitle: 'Nos fiches métiers',
      fichesEyebrow: 'Les métiers du pôle',
      moreLabel: 'En savoir plus',
      reussitesTitle: 'Nos dernières réussites.',
    };
---
<section class="page-hero">
  <div class="container">
    <p class="eyebrow">{eyebrow}</p>
    <h1 set:html={title} />
    <p class="lead">{lead}</p>
    <div class="hero-cta">
      <a href={T.contactHref} class="btn btn-dark">{ctaLabel}</a>
      <a href={T.metiersHref} class="btn btn-outline">{T.exploreLabel}</a>
    </div>
  </div>
</section>

<section class="skills-band">
  <div class="container">
    <h2>{skillsTitle}</h2>
    <ul class="chips">
      {skills.map((s) => <li><span class="chip">{s}</span></li>)}
    </ul>
  </div>
</section>

{fiches.length > 0 && (
  <section class="section" style="padding-bottom: 20px;">
    <div class="container">
      <p class="eyebrow" style="text-align:center;">{T.fichesEyebrow}</p>
      <h2 class="section-title">{T.fichesTitle}</h2>
      <div class="numbered-grid">
        {fiches.map((m, i) => (
          <article class="numbered-card">
            <div>
              <span class="num-badge">{String(i + 1).padStart(2, '0')}</span>
              <h3><a href={m.href} class="stretch-link">{m.label}</a></h3>
              {m.description && <p class="num-desc">{m.description}</p>}
              <span class="arrow-link">{T.moreLabel} <span aria-hidden="true">→</span></span>
            </div>
            {m.image && <img src={m.image} alt="" loading="lazy" />}
          </article>
        ))}
      </div>
    </div>
  </section>
)}

<HowItWorks lang={lang} />

<section class="section">
  <div class="container">
    <h2 class="section-title">{T.reussitesTitle}</h2>
    <div class={`reussites-grid${reussites.length === 2 ? ' cols-2' : ''}`}>
      {reussites.map((r) => (
        <article class="reussite-card">
          <p class="case-label label-blue">{r.tag}</p>
          <h3>{r.title}</h3>
          <ul>
            {r.points.map((p) => <li>{p}</li>)}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>

<Testimonials lang={lang} />

<CtaBanner lang={lang} />
