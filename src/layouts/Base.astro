---
import '../styles/global.css';
import { langOf, alternateOf } from '../lib/i18n';

interface Props {
  title: string;
  description?: string;
}

// URL canonique : hôte www, sans slash final (sauf l'accueil), sans ".html" (build.format 'file'), sans paramètres.
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '');
const canonical = new URL(path || '/', Astro.site).href;

// Langue et alternate déduits du chemin (mapping central dans src/lib/i18n.ts) :
// le français reste à la racine, l'anglais vit sous /en/.
const lang = langOf(path || '/');
const en = lang === 'en';
const alternate = alternateOf(path || '/');
const abs = (p: string) => new URL(p, Astro.site).href;
const frUrl = alternate ? abs(en ? alternate : path || '/') : null;
const enUrl = alternate ? abs(en ? path || '/' : alternate) : null;
// Sélecteur de langue : alternate de la page courante, sinon home de l'autre langue.
const frHref = en ? (alternate ?? '/') : (path || '/');
const enHref = en ? (path || '/') : (alternate ?? '/en');

const {
  title,
  description = en
    ? "Get fast access to vetted freelance experts — solo or as a team — to accelerate your digital projects."
    : "Accédez rapidement à des experts freelances sélectionnés, seuls ou en équipe, pour accélérer vos projets digitaux.",
} = Astro.props;

// Libellés header/footer selon la langue.
const nav = en
  ? [
      { href: '/en#expertises', label: 'Expertise' },
      { href: '/en/ai-product-team', label: 'Team', cls: 'nav-new' },
      { href: '/en/roles', label: 'Roles' },
      { href: '/en/projects', label: 'Projects' },
      { href: '/en#approche', label: 'Approach' },
      { href: '/en/blog', label: 'Blog' },
    ]
  : [
      { href: '/#expertises', label: 'Expertises' },
      { href: '/equipe-ia', label: 'Équipe', cls: 'nav-new' },
      { href: '/metiers', label: 'Métiers' },
      { href: '/projets', label: 'Projets' },
      { href: '/#approche', label: 'Approche' },
      { href: '/blog', label: 'Blog' },
    ];

const t = en
  ? {
      home: '/en',
      homeAria: 'digitags.work — home',
      navAria: 'Main navigation',
      navToggle: 'Open the menu',
      freelanceHref: '/en/become-a-freelancer',
      freelanceLabel: "I'm a freelancer",
      contactHref: '/en/contact',
      contactLabel: 'Discuss your project',
      tagline: 'The digital talent hub.',
      colExpertises: 'Expertise',
      colHub: 'The Hub',
      colResources: 'Resources',
      colContact: 'Get in touch',
      contactFooter: 'Tell us what you need',
      rights: 'All rights reserved',
      privacyHref: '/en/privacy-policy',
      privacyLabel: 'Privacy policy',
      fExpertises: [
        { href: '/en/design', label: 'Design & UX' },
        { href: '/en/digital-marketing', label: 'Marketing & Acquisition' },
        { href: '/en/product-and-project', label: 'Product & Project' },
        { href: '/en/tech-and-data', label: 'Tech & Data' },
        { href: '/en/hire-a-freelancer', label: 'Freelance collaboration' },
        { href: '/en/ai-product-team', label: 'AI Product Team' },
      ],
      fHub: [
        { href: '/en/roles', label: 'Roles' },
        { href: '/en/projects', label: 'Projects' },
        { href: '/en/studios-and-collectives', label: 'Studios & Collectives' },
        { href: '/en/case-studies', label: 'Case studies' },
        { href: '/en/the-group', label: 'The Digitags - Donutz group' },
        { href: 'https://donutzdigital.com/', label: 'Donutz Digital, pan-European digital marketing agency' },
      ],
      fResources: [
        { href: '/en/blog', label: 'The Hub blog' },
        { href: '/en/become-a-freelancer', label: 'Become a freelancer' },
      ],
    }
  : {
      home: '/',
      homeAria: 'digitags.work — accueil',
      navAria: 'Navigation principale',
      navToggle: 'Ouvrir le menu',
      freelanceHref: '/devenir-freelance',
      freelanceLabel: 'Je suis freelance',
      contactHref: '/contact',
      contactLabel: 'Parler de mon projet',
      tagline: 'Le hub des talents digitaux.',
      colExpertises: 'Expertises',
      colHub: 'Le Hub',
      colResources: 'Ressources',
      colContact: 'Nous contacter',
      contactFooter: 'Décrire mon besoin',
      rights: 'Tous droits réservés',
      privacyHref: '/politique-de-protection-des-donnees',
      privacyLabel: 'Politique de confidentialité',
      fExpertises: [
        { href: '/design', label: 'Design & UX' },
        { href: '/sea-social-ads-seo', label: 'Marketing & Acquisition' },
        { href: '/product-et-project', label: 'Product & Projet' },
        { href: '/tech-data', label: 'Tech & Data' },
        { href: '/recrutement-freelance', label: 'Collaboration freelance' },
        { href: '/equipe-ia', label: 'Équipe Produit IA' },
      ],
      fHub: [
        { href: '/metiers', label: 'Métiers' },
        { href: '/projets', label: 'Projets' },
        { href: '/studios-et-collectifs', label: 'Studios & Collectifs' },
        { href: '/cas-clients', label: 'Cas clients' },
        { href: '/le-groupe', label: 'Le groupe Digitags - Donutz' },
        { href: 'https://donutzdigital.com/fr/', label: 'Donutz Digital, agence de marketing digital paneuropéenne' },
      ],
      fResources: [
        { href: '/blog', label: 'Le blog du Hub' },
        { href: '/devenir-freelance', label: 'Devenir freelance' },
      ],
    };

// JSON-LD Organization : les @id correspondent à ceux publiés sur donutzdigital.com,
// ce qui permet aux moteurs de relier les deux sites au même groupe Digitags - Donutz.
const orgJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": "https://www.digitags.work/#organization",
  name: "digitags.work",
  legalName: "DIGITAGS",
  url: "https://www.digitags.work/",
  logo: "https://www.digitags.work/assets/logo-mark.svg",
  description:
    "digitags.work est un hub de plus de 1 600 freelances du digital sélectionnés (design, marketing, product, tech & data, IA). Membre du groupe digital européen Digitags - Donutz, aux côtés de l'agence de marketing digital paneuropéenne Donutz Digital.",
  areaServed: "Europe",
  identifier: { "@type": "PropertyValue", propertyID: "SIREN", value: "820329134" },
  address: {
    "@type": "PostalAddress",
    streetAddress: "101 rue de Clignancourt",
    postalCode: "75018",
    addressLocality: "Paris",
    addressCountry: "FR",
  },
  sameAs: ["https://www.linkedin.com/company/18871359"],
  parentOrganization: {
    "@type": "Organization",
    "@id": "https://donutzdigital.com/#group",
    name: "Digitags - Donutz",
    legalName: "DIGITAGS - DONUTZ",
    description:
      "Groupe digital européen réunissant Donutz Digital, agence de marketing digital paneuropéenne, et digitags.work, hub de plus de 1 600 freelances du digital.",
    identifier: { "@type": "PropertyValue", propertyID: "SIREN", value: "921451944" },
    address: {
      "@type": "PostalAddress",
      streetAddress: "101 rue de Clignancourt",
      postalCode: "75018",
      addressLocality: "Paris",
      addressCountry: "FR",
    },
    subOrganization: [
      { "@id": "https://www.digitags.work/#organization" },
      {
        "@type": "Organization",
        "@id": "https://donutzdigital.com/#organization",
        name: "Donutz Digital",
        url: "https://donutzdigital.com/",
        description:
          "Agence de marketing digital paneuropéenne : paid media, SEO, création et analytics.",
        sameAs: ["https://www.linkedin.com/company/donutz-digital/"],
      },
    ],
  },
});
---
<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {frUrl && enUrl && (
    <>
      <link rel="alternate" hreflang="fr" href={frUrl} />
      <link rel="alternate" hreflang="en" href={enUrl} />
      <link rel="alternate" hreflang="x-default" href={frUrl} />
    </>
  )}
  <meta name="google-site-verification" content="xfCvpsYNHG3uy0Al2dGBGrBo4Vw4YKO--_TcwCszQ7U" />
  <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml" />
  <!-- Plausible Analytics (sans cookie) — l'outil interne /talents est exclu des stats -->
  <script defer data-domain="digitags.work" data-exclude="/talents" src="https://plausible.io/js/script.outbound-links.file-downloads.exclusions.js"></script>
  <script is:inline>window.plausible = window.plausible || function() { (window.plausible.q = window.plausible.q || []).push(arguments) }</script>
  <link rel="preload" href="/assets/fonts/pjs-400.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/assets/fonts/pjs-800.woff2" as="font" type="font/woff2" crossorigin />
  <script type="application/ld+json" set:html={orgJsonLd} />
</head>
<body>

  <header class="site-header">
    <div class="container header-inner">
      <a href={t.home} class="logo" aria-label={t.homeAria}>
        <img src="/assets/logo-mark.svg" alt="" class="logo-mark" />
        <span class="logo-text">digitags<span class="logo-tld">.work</span></span>
      </a>
      <nav class="main-nav" id="main-nav" aria-label={t.navAria}>
        {nav.map((item) => <a href={item.href} class={item.cls}>{item.label}</a>)}
      </nav>
      <div class="header-actions">
        <a href={t.freelanceHref} class="link-freelance">{t.freelanceLabel}</a>
        <a href={t.contactHref} class="btn btn-dark btn-sm">{t.contactLabel}</a>
      </div>
      <nav class="lang-switch" aria-label={en ? 'Language' : 'Langue'}>
        <a href={frHref} class={en ? undefined : 'active'} aria-current={en ? undefined : 'true'} lang="fr" hreflang="fr">FR</a>
        <span aria-hidden="true">·</span>
        <a href={enHref} class={en ? 'active' : undefined} aria-current={en ? 'true' : undefined} lang="en" hreflang="en">EN</a>
      </nav>
      <button class="nav-toggle" id="nav-toggle" aria-expanded="false" aria-controls="main-nav" aria-label={t.navToggle}>
        <span></span><span></span><span></span>
      </button>
    </div>
  </header>

  <main>
    <slot />
  </main>

  <footer class="site-footer">
    <div class="container">
      <div class="footer-grid">
        <div class="footer-brand">
          <a href={t.home} class="logo logo-light" aria-label={t.homeAria}>
            <img src="/assets/logo-mark.svg" alt="" class="logo-mark" />
            <span class="logo-text">digitags<span class="logo-tld">.work</span></span>
          </a>
          <p>{t.tagline}</p>
          <div class="socials">
            <a href="https://www.linkedin.com/company/18871359" aria-label="LinkedIn"><svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M4.98 3.5C4.98 4.88 3.87 6 2.5 6S0 4.88 0 3.5 1.12 1 2.5 1s2.48 1.12 2.48 2.5zM.24 8.31h4.52V23H.24V8.31zM8.34 8.31h4.33v2h.06c.6-1.14 2.08-2.34 4.28-2.34 4.58 0 5.42 3.01 5.42 6.92V23h-4.51v-7.13c0-1.7-.03-3.89-2.37-3.89-2.37 0-2.73 1.85-2.73 3.76V23H8.34V8.31z"/></svg></a>
          </div>
        </div>
        <nav class="footer-col" aria-label={t.colExpertises}>
          <h4>{t.colExpertises}</h4>
          {t.fExpertises.map((l) => <a href={l.href}>{l.label}</a>)}
        </nav>
        <nav class="footer-col" aria-label={t.colHub}>
          <h4>{t.colHub}</h4>
          {t.fHub.map((l) => <a href={l.href}>{l.label}</a>)}
        </nav>
        <nav class="footer-col" aria-label={t.colResources}>
          <h4>{t.colResources}</h4>
          {t.fResources.map((l) => <a href={l.href}>{l.label}</a>)}
        </nav>
        <div class="footer-col">
          <h4>{t.colContact}</h4>
          <a href={t.contactHref}>{t.contactFooter}</a>
          <a href="mailto:hello@digitags.work">hello@digitags.work</a>
          <p class="footer-cities">Paris &middot; Remote</p>
        </div>
      </div>
      <div class="footer-bottom">
        <p>&copy; {new Date().getFullYear()} digitags.work &mdash; {t.rights}</p>
        <div class="footer-legal">
          <a href={t.privacyHref}>{t.privacyLabel}</a>
        </div>
      </div>
    </div>
  </footer>

  <script>
    const toggle = document.getElementById('nav-toggle');
    const nav = document.getElementById('main-nav');
    toggle?.addEventListener('click', () => {
      const open = nav.classList.toggle('open');
      toggle.setAttribute('aria-expanded', String(open));
    });
    nav?.addEventListener('click', (e) => {
      if (e.target instanceof HTMLAnchorElement) {
        nav.classList.remove('open');
        toggle?.setAttribute('aria-expanded', 'false');
      }
    });
  </script>

  <!-- Anti-bannière cookies : clin d'œil privacy, affiché une seule fois (localStorage). -->
  <div id="privacy-toast" class="privacy-toast" hidden role="status">
    <span class="pt-cookie" aria-hidden="true">🍪</span>
    {en ? (
      <p><strong>No cookie banner here.</strong> We don't track you and we sell nothing to Google &amp; co — just anonymous, cookieless audience stats. <a href="/en/privacy-policy">Promise, it's in writing.</a></p>
    ) : (
      <p><strong>Pas de bannière cookies ici.</strong> On ne vous traque pas et on ne vend rien à Google &amp; co — juste une mesure d'audience anonyme, sans cookie. <a href="/politique-de-protection-des-donnees">Promis, c'est écrit.</a></p>
    )}
    <button type="button" id="privacy-toast-close" aria-label={en ? 'Close' : 'Fermer'}>✕</button>
  </div>
  <script is:inline>
    (function () {
      try {
        if (localStorage.getItem('dgt-privacy-toast')) return;
        var t = document.getElementById('privacy-toast');
        if (!t) return;
        var hide = function () {
          t.classList.remove('show');
          setTimeout(function () { t.hidden = true; }, 400);
        };
        setTimeout(function () {
          // « Vu » dès l'affichage : pas de réapparition en changeant de page.
          try { localStorage.setItem('dgt-privacy-toast', '1'); } catch (e) {}
          t.hidden = false;
          requestAnimationFrame(function () { t.classList.add('show'); });
        }, 1800);
        setTimeout(hide, 14000);
        document.getElementById('privacy-toast-close').addEventListener('click', hide);
      } catch (e) { /* stockage indisponible : on n'affiche rien plutôt que harceler */ }
    })();
  </script>
</body>
</html>
