# En-têtes HTTP servis par Cloudflare Pages (les règles qui correspondent se cumulent).
/*
  X-Frame-Options: SAMEORIGIN

# Fichiers au nom haché par Astro et police versionnée par son nom : cache d'un an.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Images des contenus : 30 jours (un visuel remplacé garde parfois le même nom).
/uploads/*
  Cache-Control: public, max-age=2592000
# Images de partage des articles, générées au build (scripts/build-og-covers.mjs).
/og/*
  Cache-Control: public, max-age=2592000

# Versions Markdown générées au build pour les agents IA (scripts/build-markdown.mjs) :
# servies via « Accept: text/markdown » sur l'URL de la page, jamais indexées en direct.
/*.md
  X-Robots-Tag: noindex
